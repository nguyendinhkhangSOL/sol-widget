server {
    server_name huongdi.sol.vn;
    root /var/www/huongdi/public;
    index index.html;
    client_max_body_size 10M;

    # ════════════════════════════════════════════════════════════════════
    # 301 REDIRECTS — P1/P2/P3 → Vietnamese SEO URLs
    # ════════════════════════════════════════════════════════════════════

    # P1 → Khám phá bản thân
    location = /p1.html { return 301 https://$host/kham-pha-ban-than/$is_args$args; }
    location = /p1      { return 301 https://$host/kham-pha-ban-than/$is_args$args; }
    location = /p1/     { return 301 https://$host/kham-pha-ban-than/$is_args$args; }

    # P2 → Kiểm kê nguồn lực
    location = /p2.html { return 301 https://$host/kiem-ke-nguon-luc/$is_args$args; }
    location = /p2      { return 301 https://$host/kiem-ke-nguon-luc/$is_args$args; }
    location = /p2/     { return 301 https://$host/kiem-ke-nguon-luc/$is_args$args; }

    # P3 → La bàn hướng đi
    location = /p3.html { return 301 https://$host/la-ban-huong-di/$is_args$args; }
    location = /p3      { return 301 https://$host/la-ban-huong-di/$is_args$args; }
    location = /p3/     { return 301 https://$host/la-ban-huong-di/$is_args$args; }

    # Homepage → Step 1 of journey
    location = / { return 301 https://$host/kham-pha-ban-than/; }

    # Trailing slash enforcement cho URL mới
    location = /kham-pha-ban-than { return 301 https://$host/kham-pha-ban-than/$is_args$args; }
    location = /kiem-ke-nguon-luc { return 301 https://$host/kiem-ke-nguon-luc/$is_args$args; }
    location = /la-ban-huong-di   { return 301 https://$host/la-ban-huong-di/$is_args$args; }

    # ════════════════════════════════════════════════════════════════════
    # API proxy
    # ════════════════════════════════════════════════════════════════════
    location /api/ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ════════════════════════════════════════════════════════════════════
    # Static files (new URLs auto-serve via try_files)
    # ════════════════════════════════════════════════════════════════════
    location / {
        try_files $uri $uri/ $uri.html /kham-pha-ban-than/index.html;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/huongdi.sol.vn/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/huongdi.sol.vn/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = huongdi.sol.vn) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    server_name huongdi.sol.vn;
    return 404; # managed by Certbot
}
