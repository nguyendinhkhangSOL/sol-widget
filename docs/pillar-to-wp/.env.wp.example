# ═══════════════════════════════════════════════════════════════════════
# WordPress sol.vn — Credentials cho script publish-pillar-to-wp.js
# ═══════════════════════════════════════════════════════════════════════
#
# ⚠️ Copy file này → .env.wp (KHÔNG commit lên git)
# ⚠️ chmod 600 .env.wp (chỉ owner đọc)
# ═══════════════════════════════════════════════════════════════════════

# WordPress site URL (KHÔNG trailing slash)
WP_URL=https://sol.vn

# WP user (username, không phải display name)
WP_USER=khangsol

# Application Password (24 chars, có space — copy nguyên format)
# Lấy tại: wp-admin → Users → Profile → Application Passwords → "New Application Password"
# Đặt tên: "Sol Pillar Publisher"
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Custom Post Type slug (em đoán là "huong-di" theo CPT UI)
# Verify: wp-admin → CPT UI → Add/Edit Post Types → "Post Type Slug"
WP_CPT_SLUG=huong-di

# Default status khi tạo post (draft = an toàn, có thể publish sau khi review)
# Options: draft | publish | private | future
WP_DEFAULT_STATUS=draft
