<style>
:root {
  --amber-50:#FFFBEB; --amber-100:#FEF3C7; --amber-200:#FDE68A;
  --amber-500:#F59E0B; --amber-600:#D97706; --amber-700:#B45309;
  --navy-50:#F8FAFC; --navy-100:#F1F5F9; --navy-200:#E2E8F0;
  --navy-400:#94A3B8; --navy-500:#64748B; --navy-700:#334155;
  --navy-800:#1E293B; --navy-900:#0F172A;
  --emerald-500:#10B981; --emerald-700:#047857;
}
* { box-sizing:border-box; margin:0; padding:0; }
body {
  font-family:'Inter',-apple-system,sans-serif;
  background:var(--navy-50);
  color:var(--navy-700);
  line-height:1.65;
}
a { color:var(--amber-600); text-decoration:none; }
a:hover { text-decoration:underline; }

/* Container */
.container {
  max-width:1200px; margin:0 auto; padding:40px 24px;
}

/* Hero */
.hero {
  text-align:center; margin-bottom:56px;
}
.hero-eyebrow {
  font-size:13px; letter-spacing:3px; text-transform:uppercase;
  font-weight:800; color:var(--amber-600); margin-bottom:14px;
}
.hero-title {
  font-family:'Lora',Georgia,serif;
  font-size:40px; font-weight:800; color:var(--navy-900);
  line-height:1.2; margin-bottom:16px;
}
.hero-subtitle {
  font-size:18px; color:var(--navy-500);
  max-width:720px; margin:0 auto 24px;
}
.hero-badges {
  display:flex; justify-content:center; gap:12px; flex-wrap:wrap;
}
.hero-badge {
  background:#fff; border:1px solid var(--navy-200);
  padding:10px 18px; border-radius:22px;
  font-size:13.5px; font-weight:600; color:var(--navy-700);
  display:inline-flex; align-items:center; gap:6px;
}

/* Helper section — bình dân hoá AI */
.helper-box {
  background:#fff; border:1px solid var(--amber-200);
  border-left:4px solid var(--amber-500);
  border-radius:12px; padding:24px 28px; margin-bottom:40px;
}
.helper-box h3 {
  font-family:'Lora',serif; font-size:20px; font-weight:700;
  color:var(--navy-900); margin-bottom:10px;
  display:flex; align-items:center; gap:10px;
}
.helper-box p {
  font-size:15px; color:var(--navy-700); margin-bottom:8px;
}
.helper-box p:last-child { margin-bottom:0; }
.helper-box strong { color:var(--navy-900); }

/* Grid */
.prompts-grid {
  display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
  gap:24px;
}
.prompt-card {
  background:#fff; border:1px solid var(--navy-200);
  border-radius:16px; padding:28px;
  cursor:pointer; transition:all .2s;
  display:flex; flex-direction:column;
}
.prompt-card:hover {
  transform:translateY(-4px);
  box-shadow:0 20px 40px rgba(15,23,42,0.12);
  border-color:var(--amber-500);
}
.prompt-card__id {
  font-size:11px; letter-spacing:1.5px; font-weight:700;
  color:var(--amber-600); margin-bottom:10px;
}
.prompt-card__icon {
  font-size:36px; margin-bottom:14px;
}
.prompt-card__title {
  font-family:'Lora',serif; font-size:19px; font-weight:700;
  color:var(--navy-900); margin-bottom:10px; line-height:1.3;
}
.prompt-card__desc {
  font-size:14px; color:var(--navy-500); flex:1; margin-bottom:16px;
}
.prompt-card__meta {
  display:flex; gap:12px; font-size:12px; color:var(--navy-400);
  padding-top:14px; border-top:1px solid var(--navy-100);
}
.prompt-card__meta span { display:flex; align-items:center; gap:4px; }

/* Form view */
.form-view { display:none; }
.form-view.active { display:block; }

.form-header {
  background:#fff; border:1px solid var(--navy-200);
  border-radius:16px; padding:28px 32px; margin-bottom:24px;
  display:flex; align-items:flex-start; gap:20px;
}
.form-header__icon { font-size:44px; }
.form-header__body { flex:1; }
.form-header__id {
  font-size:11px; letter-spacing:1.5px; font-weight:700;
  color:var(--amber-600); margin-bottom:6px;
}
.form-header__title {
  font-family:'Lora',serif; font-size:26px; font-weight:800;
  color:var(--navy-900); margin-bottom:8px;
}
.form-header__desc {
  font-size:15px; color:var(--navy-500);
}
.form-header__back {
  background:none; border:1px solid var(--navy-200);
  padding:8px 14px; border-radius:8px;
  font-size:13px; font-weight:600; color:var(--navy-700);
  cursor:pointer;
}
.form-header__back:hover { background:var(--navy-50); }

.form-questions {
  background:#fff; border:1px solid var(--navy-200);
  border-radius:16px; padding:32px;
}
.form-group { margin-bottom:26px; }
.form-label {
  display:block; font-size:14.5px; font-weight:700;
  color:var(--navy-900); margin-bottom:8px;
}
.form-required { color:var(--amber-600); }
.form-hint {
  font-size:12.5px; color:var(--navy-500); margin-top:6px;
  font-style:italic;
}
.form-input, .form-textarea, .form-select {
  width:100%; padding:12px 14px;
  border:2px solid var(--navy-200); border-radius:10px;
  font-family:inherit; font-size:14px;
  background:#fff; color:var(--navy-900);
  transition:border-color .2s;
}
.form-input:focus, .form-textarea:focus, .form-select:focus {
  outline:none; border-color:var(--amber-500);
}
.form-input::placeholder, .form-textarea::placeholder {
  color:var(--navy-400); font-style:italic;
}
.form-textarea { min-height:120px; resize:vertical; line-height:1.6; }
.form-radio-group {
  display:flex; flex-wrap:wrap; gap:10px;
}
.form-radio {
  padding:10px 16px; border:2px solid var(--navy-200);
  border-radius:8px; cursor:pointer;
  font-size:13px; font-weight:600; color:var(--navy-700);
  background:#fff;
  transition:all .15s;
}
.form-radio.active {
  border-color:var(--amber-500); background:var(--amber-50);
  color:var(--amber-700);
}

.form-actions {
  display:flex; gap:12px; margin-top:32px;
}
.btn {
  padding:14px 24px; border-radius:10px;
  font-size:15px; font-weight:700; cursor:pointer;
  border:none; font-family:inherit;
  transition:all .2s;
}
.btn-primary {
  background:linear-gradient(135deg,var(--amber-500),var(--amber-600));
  color:#fff; flex:1;
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(245,158,11,0.3); }
.btn-secondary {
  background:transparent; color:var(--navy-700);
  border:2px solid var(--navy-200);
}
.btn-secondary:hover { background:var(--navy-50); }

/* Result view */
.result-view {
  background:#fff; border:2px solid var(--emerald-500);
  border-radius:16px; padding:32px; margin-top:24px;
  animation:slideIn .3s ease;
}
@keyframes slideIn {
  from { opacity:0; transform:translateY(-10px); }
  to { opacity:1; transform:translateY(0); }
}
.result-title {
  color:var(--emerald-700); font-size:17px; font-weight:800;
  margin-bottom:12px; display:flex; align-items:center; gap:8px;
}
.result-help {
  background:var(--amber-50); border-radius:8px; padding:14px 18px;
  margin-bottom:16px; font-size:13.5px; color:var(--navy-700);
}
.result-help strong { color:var(--navy-900); }
.result-textarea {
  width:100%; min-height:400px;
  padding:20px; background:var(--navy-50);
  border:1px solid var(--navy-200); border-radius:10px;
  font-family:'Courier New',monospace; font-size:13px;
  color:var(--navy-900); line-height:1.7;
  resize:vertical;
}
.result-actions {
  display:flex; gap:12px; margin-top:20px; flex-wrap:wrap;
}
.result-actions .btn { flex:0 0 auto; }

/* Responsive */
@media (max-width:600px) {
  .container { padding:24px 16px; }
  .hero-title { font-size:28px; }
  .hero-subtitle { font-size:15px; }
  .form-header { flex-direction:column; }
  .form-actions { flex-direction:column; }
  .btn { width:100%; }
}

/* Body class cho sol-ui.js */
body.sol-ui-loaded { padding-top:0; }
</style>
