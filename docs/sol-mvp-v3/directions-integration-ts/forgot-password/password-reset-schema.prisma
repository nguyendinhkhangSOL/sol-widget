// ═══════════════════════════════════════════════════════════════
// PASSWORD RESET — Append vào schema.prisma
// ═══════════════════════════════════════════════════════════════

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique  // Random 64-char hex
  expiresAt  DateTime  @map("expires_at")  // 1 hour after create
  usedAt     DateTime? @map("used_at")     // Null = unused
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation("UserPasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
