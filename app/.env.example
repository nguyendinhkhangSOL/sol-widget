# =================================================================
# Sol Widget v0.2 — Environment Variables
# Copy to .env.local (dev) hoặc .env.production (production)
# KHÔNG commit lên Git
# =================================================================

# Application
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://bothuocla.sol.vn

# PostgreSQL (đã có trên VPS sol-vps-01)
DATABASE_URL=postgresql://sol_app:CHANGE_THIS_PASSWORD@localhost:5432/sol_widget

# =================================================================
# VietQR (Bank info nhận tiền) — UPDATE TRƯỚC KHI LAUNCH
# Pricing entity: HKD Sol Vietnam (Hộ Kinh Doanh — đang đăng ký)
# =================================================================
SOL_BANK_SHORT=VCB                    # VCB / BIDV / TCB / MB / VPB / ACB / TPB...
SOL_BANK_ACCOUNT=0000000000           # TODO: fill khi HKD có TK doanh nghiệp
SOL_BANK_NAME=HKD SOL VIETNAM         # Tên không dấu, viết hoa
SOL_QR_TEMPLATE=compact2              # compact / compact2 / qr_only / print

# =================================================================
# Zalo (Khang's contact + future OA integration)
# =================================================================
NEXT_PUBLIC_ADMIN_ZALO=0967xxxxxx     # SĐT Zalo Khang (hiển thị cho user)
ZALO_OA_ID=                            # OA ID từ oa.zalo.me (future)
ZALO_OA_ACCESS_TOKEN=                  # Access token gửi tin tự động (future)

# =================================================================
# Google Analytics 4 (đã có)
# =================================================================
NEXT_PUBLIC_GA4_ID=G-S5ELGXBLWK

# Microsoft Clarity (đã có)
NEXT_PUBLIC_CLARITY_ID=wu12r2qt0o

# =================================================================
# Feature flags
# =================================================================
NEXT_PUBLIC_LAUNCH_DATE=2026-05-31     # 31-5 launch day cho countdown
NEXT_PUBLIC_TRIAL_DAYS=7               # 7 ngày Nhận Diện free
NEXT_PUBLIC_DAILY_RATE=5000            # 5000đ/ngày (tri ân 500 anh em đầu)
NEXT_PUBLIC_WEEKLY_RATE=35000          # 35000đ/tuần (góp phí theo tuần)
