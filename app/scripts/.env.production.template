# =================================================================
# SOL BACKEND .env — PRODUCTION TEMPLATE
# Copy → /var/www/sol-widget-old/backend/.env và điền giá trị thật
# =================================================================

# === Core ===
NODE_ENV=production
PORT=4000                                # Internal only — nginx proxy
HOST=127.0.0.1                           # KHÔNG expose 0.0.0.0 ra ngoài

# === Database ===
# Trên VPS local postgres: 127.0.0.1:5432
DATABASE_URL="postgresql://sol_app:STRONG_PASS_HERE@127.0.0.1:5432/sol_prod?schema=public&connection_limit=20"

# === CORS — domain frontend được phép gọi ===
# bothuocla.sol.vn = same-origin (không cần CORS), nhưng list để rõ
# admin.sol.vn = cross-origin (BẮT BUỘC để admin SPA gọi được)
CORS_ORIGINS=https://bothuocla.sol.vn,https://admin.sol.vn,https://sol.vn

# Public URL của backend (cho web push, OAuth redirect, voice file paths)
PUBLIC_ORIGIN=https://bothuocla.sol.vn

# URL frontend app + admin
APP_URL=https://bothuocla.sol.vn
ADMIN_DASHBOARD_URL=https://admin.sol.vn

# === JWT (BẮT BUỘC) ===
# Generate: openssl rand -base64 48
# KHÔNG bao giờ commit giá trị này. Đổi 6 tháng/lần.
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=30d

# === OTP — Phone verification ===
# true: in OTP ra log (dev/pilot — Khang nhìn log Zalo OA chính chủ)
# false: gửi SMS thật (cần wire SMS gateway riêng)
OTP_DEV_MODE=true
OTP_TTL_MINUTES=10

# === AI Mentor (Gemini Free tier hiện tại đang LIVE) ===
ENABLE_AI=true
GEMINI_API_KEY=                          # Lấy từ Google AI Studio (ClaudeGemini project)
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=                       # Optional fallback (cần credit Claude account)
CLAUDE_MODEL_PRIMARY=claude-3-5-haiku-20241022
AI_DAILY_QUOTA_MSGS=50
AI_MAX_OUTPUT_TOKENS=800

# === Zalo OAuth (login) ===
# Lấy từ https://developers.zalo.me/app/3779171417159107862
ZALO_APP_ID=3779171417159107862
ZALO_APP_SECRET=                         # 32 chars từ Zalo Developer Console
ZALO_REDIRECT_URI=https://bothuocla.sol.vn/api/auth/zalo/callback
ZALO_FRONTEND_URL=https://bothuocla.sol.vn

# === Zalo OA (Messaging — ZNS templates, SOS reply, journey push) ===
# OA ID: lấy từ https://oa.zalo.me
ZALO_OA_ID=3049397094672064963
# OA Access Token: long-lived ~90 ngày, lấy ở oa.zalo.me → Settings → Cấu hình API
# ⚠️ HẾT HẠN 90 NGÀY — đặt lịch nhắc renew
ZALO_OA_ACCESS_TOKEN=

# === Web Push (browser notification) ===
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nguyendinhkhang@gmail.com

# === Email (Zoho — magic link login + journey email) ===
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=khang@sol.vn
SMTP_PASSWORD=                           # App password từ Zoho (không phải password chính)
EMAIL_FROM=Đi Cùng Sol <khang@sol.vn>
EMAIL_REPLY_TO=khang@sol.vn

# === Operational ===
# CRITICAL: Chỉ 1 instance chạy scheduler! Nếu run nhiều PM2 cluster → set false ở các instance khác
ENABLE_SCHEDULER=true
LOG_LEVEL=info

# Sentry (optional)
SENTRY_DSN=

# === Khang alert channels (cho SOS notification) ===
KHANG_ZALO_USER_ID=                      # Follow OA xong query user_id từ DB
KHANG_ALERT_EMAIL=nguyendinhkhang@gmail.com
VIETTEL_SMS_API_KEY=                     # Optional fallback

# === Static assets ===
PUBLIC_AUDIO_BASE=https://bothuocla.sol.vn/api/audio

# === VietQR Payment (CHỐT từ business model 21/5) ===
# Lấy bank BIN code từ https://www.vietqr.io/danh-sach-bank
# Vietcombank=970436, BIDV=970418, MB Bank=970422, Techcombank=970407
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=NGUYEN DINH KHANG
VIETQR_TEMPLATE=compact2
