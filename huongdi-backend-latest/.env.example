# ============================================================
# HUONGDI-API — Environment Variables
# Copy to .env và điền giá trị thật
# KHÔNG commit file .env lên git
# Liên hệ Khang Sol (admin) để nhận .env thật
# ============================================================

# Server
NODE_ENV=production
PORT=4001

# Database (PostgreSQL — localhost only, KHÔNG expose ra ngoài)
DATABASE_URL="postgresql://huongdi_user:PASSWORD@localhost:5432/huongdi_prod"

# JWT (64-char hex — generate: openssl rand -hex 64)
JWT_SECRET=

# CORS
CORS_ORIGINS=https://huongdi.sol.vn,https://adminhuongdi.sol.vn

# Zalo OAuth (đã có từ Sol platform)
ZALO_APP_ID=
ZALO_APP_SECRET=

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sol.vn

# Admin seed password (chỉ dùng lần đầu seed)
ADMIN_SEED_PASSWORD=

# Anthropic (cho AI features sau này)
ANTHROPIC_API_KEY=
