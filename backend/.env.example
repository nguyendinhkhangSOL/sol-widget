# ──────────────────────────────────────────────────────────────────────────
#  SOL BACKEND — biến môi trường
#  Copy file này thành `.env` (cho local) hoặc paste vào Render → Environment.
#  Chỉ những biến đánh dấu (BẮT BUỘC) là phải có. Còn lại có default hoặc
#  có thể bỏ trống ban đầu.
# ──────────────────────────────────────────────────────────────────────────


# === Môi trường chạy ======================================================
# 'development' khi chạy máy local; 'production' khi deploy lên Render.
NODE_ENV=production

# Render tự cấp PORT (10000). Khi local thì 4000.
PORT=10000


# === DATABASE (BẮT BUỘC) ==================================================
# Connection string PostgreSQL. Lấy từ Supabase:
#   Supabase Dashboard → Project Settings → Database → Connection string
#   → Format "URI". Chọn "Use connection pooling" (port 6543) cho production.
#   Dán vào đây, thay <password> bằng database password đã đặt.
#
# Ví dụ:
#   postgresql://postgres.abcxyz:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=


# === CORS — domain nào được phép gọi API ==================================
# Liệt kê các URL của frontend, ngăn cách bằng dấu phẩy.
# Production:
CORS_ORIGINS=https://bothuocla.sol.vn,https://claude-4b270.web.app,https://claude-4b270.firebaseapp.com

# Khi develop local có thể thêm:
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://bothuocla.sol.vn

# URL công khai của chính backend này (cho push notification).
PUBLIC_ORIGIN=https://sol-backend.onrender.com


# === JWT — bảo mật token đăng nhập (BẮT BUỘC) ============================
# Một chuỗi ngẫu nhiên dài, KHÔNG ai được biết. Tạo bằng:
#   PowerShell:  -join ((1..64) | %{[char[]]'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789' | Get-Random})
#   Linux/Mac:   openssl rand -base64 48
JWT_SECRET=

# Token sống bao lâu trước khi user phải đăng nhập lại.
JWT_EXPIRES_IN=30d


# === OTP — mã xác thực số điện thoại =====================================
# Khi true: OTP in ra log thay vì gửi SMS thật. Để false ở production
# nếu đã tích hợp SMS gateway.
OTP_DEV_MODE=true
OTP_TTL_MINUTES=5


# === ZALO OAUTH (LOGIN) ==================================================
# App Khang: https://developers.zalo.me/app/3779171417159107862
# Lấy ở tab Settings của App.
#   ZALO_APP_ID:    số 19 chữ số (hiển thị công khai trong URL App)
#   ZALO_APP_SECRET: chuỗi 32 ký tự (KHÔNG share, chỉ dán ở .env)
#
# Để trống cả 2 → Zalo login bị disable, FE chỉ dùng anonymous-first.
ZALO_APP_ID=
ZALO_APP_SECRET=

# Callback URL — phải khớp tuyệt đối với cấu hình tab Login trong Zalo
# Developer Portal. Có thể đăng ký nhiều callback (dev + prod) trong app.
#
# Dev local:  http://localhost:4000/api/auth/zalo/callback
# Test:       https://sol.vn/api/auth/zalo/callback (tạm khi chưa deploy bothuocla)
# Prod:       https://bothuocla.sol.vn/api/auth/zalo/callback
ZALO_REDIRECT_URI=http://localhost:4000/api/auth/zalo/callback

# Frontend URL — backend redirect user về đây sau khi OAuth xong, kèm
# token trong query string (?zalo=success&token=...). FE parse query → save token.
ZALO_FRONTEND_URL=http://localhost:5173


# === AI MENTOR ============================================================
# QUAN TRỌNG: Phần lớn cấu hình AI (provider, key, model, quota, nhiệt độ)
# được lưu trong DB và quản lý qua trang Admin: /admin/ai trên dashboard.
# → Anh có thể đổi từ Anthropic sang OpenAI/Gemini, nhập key mới, test
#   kết nối — tất cả không cần restart backend.
#
# Các biến dưới đây CHỈ là fallback khi DB chưa có cấu hình
# (ví dụ lúc deploy lần đầu). Sau khi vào /admin/ai và bấm "Lưu cấu hình"
# 1 lần, các biến này không còn được dùng nữa.

ENABLE_AI=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL_PRIMARY=claude-haiku-4-5-20251001
CLAUDE_MODEL_ESCALATED=claude-sonnet-4-6
AI_DAILY_QUOTA_MSGS=30
AI_MAX_OUTPUT_TOKENS=400


# === PUSH NOTIFICATION (tuỳ chọn) =========================================
# Để gửi nhắc check-in qua web push. Tạo VAPID keys bằng:
#   npx web-push generate-vapid-keys
# Bỏ trống nếu chưa cần push notification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@sol.vn


# === SCHEDULER ===========================================================
# Bật cron job (nhắc check-in, tổng kết tuần, tính streak…).
# Khi deploy 1 instance Render thì bật. Nếu nhiều instance, chỉ bật 1 cái.
ENABLE_SCHEDULER=true
