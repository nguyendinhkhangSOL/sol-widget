// SOL Companion Widget — DB Schema
// PostgreSQL via Prisma

generator client {
  provider      = "prisma-client-js"
  // "native" = host khi dev local (Windows). "linux-musl-openssl-3.0.x" =
  // node:20-alpine container. Có cả 2 → image build trên Windows vẫn chạy
  // được trên Linux Alpine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── PRICING TIERS (Sol v3 — 12-05-2026) ──────
//
// Sol v3: 4 chặng tiến hoá, total 51 ngày + Day 52 lễ tốt nghiệp.
// Enum values GIỮ NGUYÊN (FREE/KHOI_DONG/DONG_HANH/ALUMNI) để không break
// existing user data. Display labels v3 đã update trong code.
//
//   FREE       → "Nhận Diện" — 7 ngày miễn phí (Day 1-7)
//                  Quan sát mình hút lúc nào, vì sao. Không cần SĐT.
//                  Chat AI 30 tin/ngày, 14 wiki body timeline, voice
//                  giới thiệu Day 1 + Day 7, báo cáo Day 7.
//                  Không cam kết, không bám.
//
//   KHOI_DONG  → "Kiểm Soát" — 99.000đ trả 1 lần, 14 ngày (Day 8-21)
//                  Giảm tần suất hút có ý thức. Kỹ thuật thở 4-2-6,
//                  9 công cụ phân tâm, voice Khang Khẩn cấp Day 3/7/14/Lapse,
//                  Sổ Hành Trình Pre-Q + T1 (12 bài), Plan B 5 trigger,
//                  báo cáo Day 14 + Day 21.
//                  Refund conditional ≥80% metric (không hỏi nếu đủ).
//
//   DONG_HANH  → "Làm Chủ" — 199.000đ trả 1 lần, 30 ngày (Day 22-51)
//                  Q-Day Day 22 — cai hẳn 30 ngày. Crisis Mode 24/7,
//                  AI chat unlimited, 6 voice Khang milestone (D0/D3/D7/D14/D21/D30),
//                  Sổ Hành Trình T2-T4 + Sau 30 ngày (26 bài), báo cáo Day 30 + 51,
//                  Body milestone tracking.
//                  Day 52 LỄ TỐT NGHIỆP: nhận Cuốn Nhật Ký Hành Trình PDF
//                  50-80 trang (kỷ vật vĩnh viễn).
//                  Refund Day 15+ pro-rated: (30-daysUsed)/30 × 199k.
//
//   ALUMNI     → "Người Tự Do" — forever miễn phí (Day 52+)
//                  KHÔNG phải gói Sol bán — là trạng thái khách đạt được.
//                  Tài khoản app vẫn login, đọc lại nhật ký, Đại Sảnh Sol,
//                  Đại Sứ Sol referral (commission 25%, optional).
//                  Sol KHÔNG bám, KHÔNG thu thêm.
//
// Schedule total: 7 + 14 + 30 = 51 ngày Sol-active + Day 52 ceremonial
// Total paid: 99k + 199k = 298.000đ = đúng 1 tháng tiền thuốc trung bình
//             (10.000đ/ngày × 30 = 300.000đ)
//
// Detail: docs/SOL_BLUEPRINT_FINAL_v3.docx + landing v3 LIVE on sol.vn
enum UserTier {
  FREE
  KHOI_DONG
  DONG_HANH
  ALUMNI
}

// ───────────────────────────────── USERS ─────────────────────────────────

model User {
  id            String   @id @default(cuid())
  // ── IDENTITY (anonymous-first) ──────────────────────────────────────
  // SOL chấp nhận user ẩn danh: deviceUid (browser localStorage) làm
  // identity ban đầu. User có thể bind số điện thoại HOẶC liên kết Zalo
  // sau để portable cross-device + recovery khi mất máy.
  // Ít nhất 1 trong 3 phải có: deviceUid (anon), phone (OTP), hoặc zaloUserId.
  phone         String?  @unique
  email         String?  @unique
  // Device UID — UUID v4 random, do FE generate, save localStorage.
  // Dùng để bind anonymous user vào browser/device. NULL khi user đã
  // bind phone/zalo và logout/clear localStorage trên device đó.
  deviceUid     String?  @unique
  // Zalo OAuth user ID (chuỗi số). Khi user "Liên kết Zalo" thành công,
  // backend lưu zaloUserId này → portable cross-device login.
  zaloUserId    String?  @unique
  // True khi user chưa bind phone/zalo. FE dùng để hiện soft prompt
  // "Liên kết Zalo để bảo vệ hành trình".
  isAnonymous   Boolean  @default(true)
  // Domain widget được embed lúc user lần đầu tạo account (vd "wiki.sol.vn",
  // "partner-x.com"). Dùng để track partner attribution.
  originDomain  String?
  // Mã khôi phục offline (Layer 3). Bcrypt hash của chuỗi 12 ký tự
  // "SOL-XXXX-XXXX-XXXX" sinh khi user lần đầu liên kết Zalo/SĐT.
  // User save plaintext (chỉ hiện 1 lần). Khi mất Zalo + SĐT, dùng mã
  // này gọi /auth/recover để cấp JWT mới. Mỗi mã 1-shot — sau recover
  // backend invalidate (set null) và sinh mã mới.
  recoveryCodeHash String?
  name          String
  // Cách Sol gọi user: "anh" | "chị" | "em" | hoặc tuỳ chỉnh ("Ngài",
  // "Đại ca", "Sếp"…). Tự do tới 8 ký tự — UI cũng giới hạn vậy.
  pronouns      String   @default("bạn")
  // Tên user dùng để gọi trợ lý AI: "Sol Trợ lý" | "Sol Phó tướng" |
  // "Sol Đồng hành" | tuỳ chỉnh ("Sol Vợ yêu", "Sol Sếp"…). Tối đa 24 ký tự.
  // Hiển thị trong header chat, push notification, v.v.
  assistantName String   @default("Sol Đồng hành")
  ftndScore     Int?     // 0-10 Fagerström
  quitDate      DateTime? // when user started the 30-day program
  timezone      String   @default("Asia/Ho_Chi_Minh")

  // ── Hồ sơ cai thuốc (deep profile, optional — user điền dần) ──────────
  // Tuổi user (18-120). Dùng để chỉnh timeline phục hồi: 45 vs 65 khác.
  age           Int?
  // Số năm đã hút (0-90). Dùng để chỉnh expectation: hút 30 năm thì
  // dopamine cần ~3 tháng để reset, hút 5 năm chỉ cần ~3 tuần.
  yearsSmoked   Int?
  // 3-5 lý do bỏ thuốc user tự viết. Lưu nguyên văn (vd "vì cu Tí",
  // "ho buổi sáng", "vợ nhăn"). AI sẽ replay đúng câu này lúc user thèm
  // thuốc → mạnh hơn lý do generic.
  quitReasons   String[] @default([])

  // Pattern learning + onboarding-declared triggers
  riskyHours    Int[]    @default([]) // học từ check-in: [16, 20, 22]
  topTriggers   String[] @default([]) // user khai lúc onboarding: ["nhậu", "cà phê sáng"]

  // Settings (JSON for flexibility)
  settings      Json     @default("{}")

  // ── PHASE 5 — Smart Notification Schedule ──────────────────────────
  // shape: { dailyMax, activeStart/End, quietStart/End, weekendReduce,
  //          moments: { coffeeMorning?, teaAfternoon?, postLunch?, postDinner?,
  //                     preSocialDrink?, preBedtime? },
  //          consecutiveUnopened (Phase 6) }
  notificationPrefs Json @default("{}")

  // ── PHASE A — Continuous journey tracking ──────────────────────────
  // Stage derived from quitDate (computeStageFromDay). Không cần enum cứng.
  exitedAt        DateTime?       // null = đang đi, set = đã exit
  exitReason      String?

  // ── PHASE B — 88-day journey (NHAN_THUC + HANH_DONG + GIAI_PHONG + TAI_THIET)
  // Q-Day = Day 28. User PHẢI bấm xác nhận để bật đồng hồ countdown ở Phase 3.
  // NULL = chưa cam kết (Phase 3 vẫn render nhưng đồng hồ không chạy).
  qDayConfirmedAt  DateTime?
  // User khai báo Day 1 onboarding wizard. Dùng để tính money saved cumulative.
  cigsBaseline     Int      @default(20)   // Số điếu/ngày user thường hút trước khi vào Sol
  pricePerCig      Int      @default(1250) // Giá mỗi điếu (VND). Default 25k/pack 20.
  // Khi user hoàn thành onboarding wizard. NULL = vẫn cần wizard.
  onboardingCompletedAt DateTime?

  cigaretteLogs   CigaretteLog[]
  progressJournals ProgressJournal[]
  // settings shape:
  // {
  //   quietHoursStart: "22:00",
  //   quietHoursEnd: "08:00",
  //   mode: "normal" | "busy" | "whisper" | "calm",
  //   calmModeUntil: ISO date,
  //   pushPrefs: { checkin: true, crisisPrep: true, milestone: true, ... }
  // }

  // Engagement metrics (denormalised for speed)
  checkinStreak     Int   @default(0)
  longestStreak     Int   @default(0)
  lastCheckinDate   DateTime?
  missedDaysInRow   Int   @default(0)
  totalDaysActive   Int   @default(0)
  refundEligible    Boolean @default(true)

  // ── PRICING TIER (xem enum UserTier) ────────────────────────────────
  tier              UserTier @default(FREE)
  // Khi user mua gói (lần upgrade gần nhất). NULL nếu chưa mua bao giờ.
  // FREE tier: tierStartedAt = registered_at; KHOI_DONG/DONG_HANH: từ
  // ngày charge thành công 99k/199k.
  tierStartedAt     DateTime?
  // Hết hạn gói chính theo Sol v3:
  //   FREE      → tierStartedAt + 7 ngày  (Day 1-7 NHẬN DIỆN)
  //   KHOI_DONG → tierStartedAt + 14 ngày (Day 8-21 KIỂM SOÁT)
  //   DONG_HANH → tierStartedAt + 30 ngày (Day 22-51 LÀM CHỦ, Q-Day = Day 22)
  // Khi tierExpiresAt < NOW → auto-downgrade về ALUMNI (NGƯỜI TỰ DO).
  // Schedule total: 7+14+30 = 51 ngày Sol-active + Day 52 lễ tốt nghiệp.
  tierExpiresAt     DateTime?
  // DEPRECATED (Sol v3): maintenance window concept không còn sử dụng.
  // Sol v3 không có period bảo trì sau DONG_HANH — Day 52+ → NGƯỜI TỰ DO
  // tự động miễn phí mãi. Column giữ trong schema để không break existing
  // data, nhưng logic mới KHÔNG check field này.
  maintenanceUntil  DateTime?
  // Tracker daily quota:
  //   FREE      → 30 tin/ngày (Sol v3 đã nâng từ 5 lên 30 để khách thử kỹ)
  //   KHOI_DONG → 30 tin/ngày
  //   DONG_HANH → unlimited (chat AI không giới hạn)
  //   ALUMNI    → 5 tin/ngày (chỉ support, không content mới)
  dailyMessageCount Int      @default(0)
  dailyMessageDate  DateTime? @db.Date

  // ── RISK & COHORT ───────────────────────────────────────────────────
  // Điểm rủi ro 0-100 do scheduler tính lại mỗi giờ. > 70 = flag đỏ ở admin.
  // Tính từ: mood trend, missed checkins, từ khoá khủng hoảng trong chat.
  riskScore         Int      @default(0)
  riskScoreUpdated  DateTime?
  // Cohort tracking: "2026-04" cho user đặt Q-Day tháng 4/2026. NULL nếu
  // chưa đặt Q-Day.
  cohortKey         String?

  // Admin / roles
  isAdmin       Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkIns      CheckIn[]
  exercises     ExerciseEntry[]
  messages      Message[]
  state         UserState?
  notifications Notification[]
  pushSubs      PushSubscription[]
  crisisEvents  CrisisEvent[]
  payments      PaymentLog[]
  refunds       RefundRequest[]
  voiceDeliveries VoiceDelivery[]

  // ── Silent Companionship (pivot 2026-05-08) ─────────────────────────
  confessions          Confession[]            @relation("ConfessionAuthor")
  confessionReactions  ConfessionReaction[]    @relation("ConfessionReactor")
  confessionReads      ConfessionRead[]        @relation("ConfessionReader")
  khangQuestions       KhangQuestion[]         @relation("KhangQuestionAuthor")
  khangQuestionUpvotes KhangQuestionUpvote[]   @relation("KhangQuestionUpvoter")
  khangVoiceListens    KhangVoiceListen[]      @relation("KhangVoiceListener")
  khangVoiceReactions  KhangVoiceReaction[]    @relation("KhangVoiceReactor")
  crisisTimerLogs      CrisisTimerLog[]        @relation("CrisisTimerUser")
  lapseEvents          LapseEvent[]            @relation("LapseUser")
  // ── ZALO OA (Sol v3 12-05-2026) ──────────────────────────────────────
  zaloOAUser           ZaloOAUser?             @relation("ZaloOAUserUser")
  znsLogs              ZNSLog[]                @relation("ZNSLogUser")
  messagingPolicies    MessagingPolicy[]       @relation("MessagingPolicyUser")
  messagingProfile     UserMessagingProfile?   @relation("UserMessagingProfileUser")

  @@index([phone])
  @@index([deviceUid])
  @@index([zaloUserId])
  @@index([tier])
  @@index([cohortKey])
  @@index([riskScore])
}

// ───────────────────────────── CHECK-INS (PULSE) ─────────────────────────

model CheckIn {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayNumber        Int      // 1..30
  date             DateTime @db.Date

  // Layer 1 - mandatory
  smoked           Boolean
  smokeCount       Int?     // 0 if !smoked; 1-5 or 6+ bucketed
  cravingIntensity Int      // 1..10
  mood             Int      // 1..5

  // Layer 2 - optional
  hardestMoment    String?  // "nhậu" | "stress" | "sau cơm" | ...
  copingAction     String?
  win              String?
  note             String?

  // "Sick day" — soft miss tolerated
  isSickDay        Boolean  @default(false)

  createdAt        DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, dayNumber])
}

// ──────────────────────── EXERCISES (WORKBOOK) ───────────────────────────

model ExerciseEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayNumber     Int
  exerciseKey   String   // e.g. "day_7_letter_future_self"
  content       Json     // structured based on exercise type

  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@unique([userId, dayNumber, exerciseKey])
  @@index([userId, dayNumber])
}

// ─────────────────────────── CHAT MESSAGES ───────────────────────────────

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageType {
  CHAT                // free AI chat
  MORNING_GOAL        // daily push
  SCIENCE_TIP
  PHENOMENA_ALERT
  EXERCISE_CARD
  CHECKIN_PROMPT
  CHECKIN_STEP        // step in the check-in structured flow
  NIGHT_STORY
  STREAK_MILESTONE
  CRISIS_PROMPT
  SYSTEM_NOTICE
  WIKI_LINK
}

model Message {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        MessageRole
  type        MessageType @default(CHAT)
  content     String      @db.Text
  metadata    Json        @default("{}")
  // metadata shape varies:
  //   chat: { modelUsed, promptTokens, completionTokens, latencyMs }
  //   exercise_card: { dayNumber, exerciseKey }
  //   wiki_link: { url, title }
  //   checkin_step: { step, payload }

  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────── JOURNEY TRACKING ───────────────────────────
// Continuous journey 60 ngày: Nhận thức 7d → Giảm lệ thuộc 14d → Bỏ hẳn 21d → Duy trì 18d
// Stage được DERIVE từ dayInJourney (không lưu enum cứng):
//   day 1-7   → NHAN_THUC (Nhận thức)
//   day 8-21  → GIAM_LE_THUOC (Giảm lệ thuộc)
//   day 22-42 → BO_HAN (Bỏ hẳn)
//   day 43-60 → DUY_TRI (Duy trì)
//   day 61+   → DAI_SU (Đại Sứ vĩnh viễn, FREE forever)

model CigaretteLog {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  smokedAt      DateTime         @default(now())
  trigger       String?           // 'STRESS' | 'EATING' | 'IDLE' | 'SOCIAL' | 'OTHER'
  context       String?           // optional free text
  delayedMin    Int?              // user delay X phút trước khi hút (positive)
  skipped       Boolean          @default(false)  // user định hút nhưng skip — VICTORY

  @@index([userId, smokedAt])
}

// Snapshot khi user exit — món quà trả lại user
// User có thể có nhiều ProgressJournal nếu resume + exit nhiều lần
model ProgressJournal {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot data
  daysJourneyed   Int
  cigsLogged      Int          @default(0)
  cigsSkipped     Int          @default(0)
  moneySaved      Int          @default(0)        // VND
  topTriggers     Json?         // { stress: 38, eating: 27, ... }
  emotionalArc    Json?         // [{ day, mood, note }]
  letterToSelf    String?       // nếu user viết Day 1 cho future self
  bodyMilestonesUnlocked  Json?  // [1,3,7,14,30,...] day numbers
  paidAmount      Int          @default(0)        // tổng tiền đã trả
  refundedAmount  Int          @default(0)        // tổng đã hoàn

  // Generated artifacts
  pdfUrl          String?       // link PDF download

  exitReason      String?       // user input
  exitedAt        DateTime     @default(now())

  @@index([userId, exitedAt])
}

// ─────────────────────────── CONTENT CATALOG ─────────────────────────────
// Content is seeded by founder and edited in admin; widget just consumes

enum Moment {
  COFFEE_MORNING       // user uống cà phê
  TEA_AFTERNOON        // trà đá / nghỉ trưa
  POST_LUNCH           // sau bữa cơm trưa
  POST_DINNER          // sau bữa cơm tối
  PRE_SOCIAL_DRINK     // chuẩn bị nhậu / tiệc
  PRE_BEDTIME          // trước khi ngủ
  GENERIC              // không gắn moment, fallback default
}

enum ContentVoice {
  KHANG_SOL          // Giọng Khang Sol — ký tên, cá nhân ("— Khang Sol")
  SOL_DONG_HANH      // Giọng Sol Đồng hành — assistant tự xưng "mình"
}

enum ContentModule {
  MORNING_GOAL
  SCIENCE_TIP
  PHENOMENA_ALERT
  EXERCISE
  NIGHT_STORY
}

model ContentItem {
  id         String        @id @default(cuid())
  dayNumber  Int           // 1..30
  module     ContentModule
  title      String
  body       String        @db.Text
  wikiUrl    String?
  imageUrl   String?
  audioUrl   String?
  // For exercises, the structured schema describing the exercise
  exerciseKey    String?
  exerciseSchema Json?     // { type: "free_text" | "checklist" | "audio" | "scale", prompts: [...] }

  pushTime   String?       // "HH:mm" format, e.g. "07:00"
  published  Boolean       @default(true)

  // ── PHASE 1 — Voice + priority + targeting ──────────────────────────
  voice      ContentVoice  @default(SOL_DONG_HANH)
  priority   Int           @default(100)  // Cao = thắng khi nhiều item match. 1000=CRITICAL bypass targeting.

  // PHASE 2 — Targeting rules (UI active sau MVP launch).
  // Shape: { ageMin?, ageMax?, yearsSmokedMin?, yearsSmokedMax?,
  //          ftndMin?, ftndMax?, gender?, region?, interests?, cigaretteType? }
  targetRules Json?

  // PHASE 3 — A/B test (UI sau).
  variantGroup String?
  weight       Int          @default(1)

  // PHASE 5 — Smart scheduler moment tagging
  moment       Moment?      // null = GENERIC fallback

  // ── Audit ───────────────────────────────────────────────────────────
  lastEditedBy String?      // userId của Khang/admin

  revisions    ContentItemRevision[]

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([dayNumber, module, exerciseKey, voice])
  @@index([dayNumber, module, published])
}

// ContentItemRevision — full version history
model ContentItemRevision {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  // Snapshot tại thời điểm revision
  versionNum    Int          // 1, 2, 3... (incremental per item)
  title         String
  body          String       @db.Text
  voice         ContentVoice
  targetRules   Json?
  priority      Int

  // Metadata
  editedBy      String       // userId Khang/admin
  editedAt      DateTime     @default(now())
  changeNote    String?      // Khang ghi chú "đổi voice cho mềm hơn"

  @@index([contentItemId, versionNum])
}

// ─────────────────────────── CANNED REPLIES ─────────────────────────────
// Quick-reply chips trong widget chat — câu hỏi quen thuộc + câu trả lời
// biên tập sẵn (do founder/admin biên tập). Render NGAY khi user bấm,
// không qua AI → nhanh & chính xác hơn cho người 45+.
//
//  • slug: stable id dùng cho localStorage 'sol-qr-used' (không đổi khi
//          founder sửa label/answer). Nếu xoá rồi tạo lại → tạo slug mới.
//  • reusable: true → cho phép hỏi lại nhiều lần (vd "tôi đang thèm")
//  • wikiUrl + wikiLabel: link "Xem thêm" hiện ở cuối câu trả lời
//  • sortOrder: thứ tự hiển thị; câu nhỏ hơn lên trên
//  • enabled: tắt nhanh không cần xoá

model CannedReply {
  id         String   @id @default(cuid())
  slug       String   @unique
  label      String                    // chữ trên chip + dùng làm user message khi bấm
  icon       String   @default("💬")   // emoji 1 ký tự
  answer     String   @db.Text         // câu trả lời biên tập sẵn
  wikiUrl    String?                   // link "Xem thêm" (tuỳ chọn)
  wikiLabel  String?                   // label cho link, vd "Xem giải thích chi tiết"
  reusable   Boolean  @default(false)
  sortOrder  Int      @default(100)
  enabled    Boolean  @default(true)

  // ── Trigger filter (intent matching) ────────────────────────────────
  // Mỗi trigger là 1 cụm từ user có thể gõ tự do trong chat.
  // Vd ["thèm thuốc", "muốn hút", "thèm hút", "đang thèm"]
  // Frontend normalize Vietnamese (lowercase + bỏ dấu) rồi match ngược lại.
  // Khi match thành công → render answer NGAY, không gọi AI → siêu nhanh.
  // Empty array = chip này chỉ active qua nút bấm, không qua chat tự do.
  triggers   String[] @default([])
  // Priority cho khi nhiều chip cùng match. Cao = match trước.
  // Convention: 100 = thường, 200 = quan trọng, 1000 = CRITICAL (y tế khẩn).
  priority   Int      @default(100)
  // Min match score (0-1) để chấp nhận. Default 0.5. CRITICAL chip có thể
  // hạ xuống 0.3 để dễ match hơn (an toàn quan trọng hơn false positive).
  minScore   Float    @default(0.5)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled, sortOrder])
  @@index([priority])
}

// ─────────────────────────── STATE MACHINE ───────────────────────────────

enum ConversationState {
  IDLE
  CHECKIN_FLOW
  EXERCISE_FLOW
  AI_CHAT
  CRISIS_MODE
}

model UserState {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state       ConversationState @default(IDLE)
  stateData   Json     @default("{}")
  // stateData shape:
  //   CHECKIN_FLOW: { step: 0..3, answers: {...} }
  //   EXERCISE_FLOW: { exerciseKey, dayNumber, draft }
  //   CRISIS_MODE: { startedAt, stage: "breathing"|"remind"|"support" }
  updatedAt   DateTime @updatedAt
}

// ────────────────────────── NOTIFICATIONS ────────────────────────────────

enum NotificationType {
  MORNING_GOAL
  SCIENCE_TIP
  PHENOMENA_ALERT
  EXERCISE_REMINDER       // mapping: ContentModule.EXERCISE
  NIGHT_STORY             // ADDED 2026-05-04 — fix worker.ts cron 21:30 crash
  EVENING_CHECKIN
  CRISIS_PREP
  STREAK_MILESTONE
  MISSED_DAY
  REENGAGEMENT
  FOUNDER_WEEKLY
  CUSTOM
}

enum DeliveryChannel {
  IN_WIDGET       // just shows in widget inbox, no external push
  WEB_PUSH        // browser notification
  EMAIL
  SMS
}

enum DeliveryStatus {
  SCHEDULED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED      // e.g. in quiet hours, or muted
  READ
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         NotificationType
  title        String
  body         String   @db.Text
  wikiUrl      String?
  ctaLabel     String?
  ctaAction    String?  // "open_checkin" | "open_exercise:day_7" | "open_wiki:/slug"

  channels     DeliveryChannel[] @default([IN_WIDGET])
  scheduledAt  DateTime
  sentAt       DateTime?
  readAt       DateTime?
  status       DeliveryStatus @default(SCHEDULED)

  metadata     Json     @default("{}")

  createdAt    DateTime @default(now())

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?

  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────── CRISIS EVENTS ───────────────────────────────

model CrisisEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  trigger         String?  // what user said/did to invoke
  intensityStart  Int?     // 1-10 scale reported
  intensityEnd    Int?
  stage           String   @default("breathing") // "breathing" | "remind" | "support" | "resolved"
  durationSec     Int?
  resolvedAt      DateTime?
  escalatedToHuman Boolean @default(false)

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────── AUTH ────────────────────────────────────

model OtpCode {
  id         String   @id @default(cuid())
  phone      String
  code       String   // hashed
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
}

// Email magic link auth (2026-05-06 — pivot từ Zalo OAuth tạm thời).
// User nhập email → backend tạo token 32-char hex random → email link
// "https://bothuocla.sol.vn/auth/email?token=XXX". Click → verify → MERGE
// anon hiện tại vào user gốc (nếu email đã có) hoặc bind email vào anon.
//
// Token 1-shot: consumedAt set khi verify thành công, không reuse.
// Expire 1 giờ — đủ cho user check mail + click link.
// Idempotent: cùng email request nhiều lần → tạo nhiều token, không crash.
model EmailVerificationToken {
  token       String    @id
  email       String
  fromUserId  String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// ──────────────────────── APP SETTINGS (ADMIN) ───────────────────────────
// Generic key-value store for runtime-editable config.
// Example keys:
//   "ai" → { provider: "anthropic"|"openai"|"gemini", apiKey, modelPrimary,
//             modelEscalated, dailyQuotaMsgs, maxOutputTokens, enabled }
//   "branding" → { logoUrl, primaryColor, ... }
// API key is stored plaintext (encrypt-at-rest should be enabled at the DB
// level in production). Never return apiKey in API responses — masked only.

model AppSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?  // userId of admin who last changed it
}

// ─────────────────────────── PAYMENTS ────────────────────────────────────
// Mock-mode hôm nay: PaymentLog ghi mọi giao dịch. Khi tích hợp MoMo/VietQR
// thật, thêm provider+providerOrderId+webhook handler. Status flow:
//   PENDING → PAID (success) hoặc FAILED. Refund tham chiếu vào RefundRequest.

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  MOMO
  VIETQR
  BANK_TRANSFER
}

model PaymentLog {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tier user đang mua. KHOI_DONG: 99000, DONG_HANH: 199000.
  targetTier      UserTier
  amountVnd       Int             // số tiền VND nguyên
  provider        PaymentProvider @default(MOCK)
  providerOrderId String?         // mã đơn của provider (sau khi tích hợp)
  status          PaymentStatus   @default(PENDING)

  paidAt          DateTime?
  metadata        Json            @default("{}")
  // metadata: { ip, userAgent, couponCode, ... }

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  refund          RefundRequest?

  @@index([userId, createdAt])
  @@index([status])
}

// ─────────────────────────── REFUNDS ─────────────────────────────────────
// Logic hoàn tiền cho gói DONG_HANH (199k / 30 ngày):
//   - Chỉ hoàn được từ Ngày 15 trở đi (15 ngày đầu không hoàn).
//   - Số tiền hoàn = (30 - daysUsed) / 20 × 100000 (làm tròn xuống 1000đ).
//   - Approve thủ công bởi admin (Khang đọc lý do trước khi đóng dấu).
//   - Khi APPROVED: payment status → REFUNDED, user.tier → FREE.

enum RefundStatus {
  REQUESTED
  APPROVED
  DENIED
  PROCESSED
}

model RefundRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId   String       @unique
  payment     PaymentLog   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  daysUsed    Int          // số ngày user đã dùng tính tới lúc request
  amountVnd   Int          // số tiền hoàn tính sẵn (admin có thể chỉnh)
  reason      String?      @db.Text // lý do user viết (optional)
  status      RefundStatus @default(REQUESTED)
  adminNote   String?      @db.Text
  approvedBy  String?      // userId của admin
  approvedAt  DateTime?
  processedAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────── VOICE LIBRARY (KHANG) ──────────────────────────
// Khang upload file mp3 (tự ghi âm) + tag tình huống. Hệ thống tự gửi vào
// đúng thời điểm dựa trên triggerType + dayMatch. VoiceDelivery log đã gửi
// chưa cho user nào (idempotent — không gửi 2 lần cùng 1 voice).

enum VoiceTriggerType {
  DAY_MATCH       // gửi đúng ngày X (vd Ngày 1, 3, 7, 14, 21, 30)
  CRISIS          // gửi khi crisis event nổ ra
  MILESTONE       // gửi khi đạt mốc (10 ngày sạch, 100k tiết kiệm…)
  MANUAL          // chỉ admin gửi tay từ User Detail
}

model VoiceMessage {
  id           String           @id @default(cuid())
  title        String           // "Chào mừng ngày 1", "Khủng hoảng nhậu"
  audioUrl     String           // URL file mp3 (S3/Supabase storage)
  durationSec  Int?             // thời lượng (giây), để hiển thị
  transcript   String?          @db.Text // text version cho user 45+ điếc

  triggerType  VoiceTriggerType
  // Với DAY_MATCH: số ngày (1, 3, 7, 14, 21, 30…). NULL cho CRISIS/MANUAL.
  dayMatch     Int?
  // Với CRISIS/MILESTONE: tag để filter (vd "nhau", "stress", "10_days_clean").
  tag          String?

  // Tier tối thiểu để nhận voice. FREE chỉ nhận 1 voice "chào mừng".
  minTier      UserTier         @default(FREE)
  enabled      Boolean          @default(true)
  sortOrder    Int              @default(100)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  deliveries   VoiceDelivery[]

  @@index([triggerType, dayMatch])
  @@index([enabled, sortOrder])
}

model VoiceDelivery {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceId    String
  voice      VoiceMessage @relation(fields: [voiceId], references: [id], onDelete: Cascade)

  deliveredAt DateTime    @default(now())
  playedAt    DateTime?

  @@unique([userId, voiceId])
  @@index([userId, deliveredAt])
}

// ─────────────────────────── COHORT TRACKING ─────────────────────────────
// Mỗi tháng có 1 cohort (vd "2026-04"). Theo dõi toàn bộ user đặt Q-Day
// trong tháng đó cho đến khi họ ra (alumni / refund / churn).
// Tự động tạo bởi cronjob khi user đầu tiên set quitDate trong tháng mới.

model Cohort {
  key            String   @id        // "YYYY-MM"
  label          String              // "Tháng 4/2026"
  startDate      DateTime            // ngày 1 của tháng
  endDate        DateTime            // ngày cuối của tháng
  totalMembers   Int      @default(0)
  paidMembers    Int      @default(0)
  alumniMembers  Int      @default(0)
  churnedMembers Int      @default(0)
  notes          String?  @db.Text   // ghi chú admin

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────
// SILENT COMPANIONSHIP (pivot 2026-05-08)
// 4 channels mới — drop community truyền thống vì đàn ông VN 45+ ngại lộ
// mặt. Reference: docs/SILENT_COMPANIONSHIP_2026-05-08.md
// ────────────────────────────────────────────────────────────────────────

// ─── KHOẢNG LẶNG — anonymous confessions feed ───────────────────────────
// User submit confession ngắn ANONYMOUS (không avatar, không tên).
// User khác chỉ react 👍 / 🙏 / "Tôi cũng vậy" — KHÔNG comment chéo.
// Sol/admin curate (xóa toxic, không edit nội dung).
// Đây là "radio thư" — khác hoàn toàn social community.
model Confession {
  id          String   @id @default(cuid())
  // User submitter (không hiển thị public, chỉ admin thấy)
  authorId    String
  author      User     @relation("ConfessionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Content text (50-300 chữ recommend)
  content     String   @db.Text
  // Status: PENDING (chờ duyệt) / PUBLISHED / REJECTED (toxic)
  status      ConfessionStatus @default(PUBLISHED)
  // Optional: Khang/admin pin lên top
  pinnedAt    DateTime?
  // Counters cached (update khi react/read)
  readCount   Int      @default(0)
  reactCount  Int      @default(0)
  // Tag tự động bằng AI (optional): "lapse" | "milestone" | "trigger" | "family"
  autoTag     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reactions   ConfessionReaction[]
  reads       ConfessionRead[]

  @@index([status, createdAt])
  @@index([authorId])
}

enum ConfessionStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model ConfessionReaction {
  id           String   @id @default(cuid())
  confessionId String
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ConfessionReactor", fields: [userId], references: [id], onDelete: Cascade)
  // Type: 1 (👍) | 2 (🙏) | 3 ("Tôi cũng vậy") | 4 ("Đang cố") | 5 ("Nghe lúc 2h sáng")
  reactionType Int

  createdAt    DateTime @default(now())

  @@unique([confessionId, userId, reactionType])
  @@index([userId])
}

model ConfessionRead {
  id           String   @id @default(cuid())
  confessionId String
  confession   Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ConfessionReader", fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique([confessionId, userId])
}

// ─── HỎI KHANG — anonymous mailbox + voice reply broadcast ──────────────
// User submit câu hỏi ANONYMOUS → Khang curate 1-2 lần/tuần → voice reply
// public broadcast cho tất cả nghe. Anonymous IN + Public OUT = đặc trưng VN 45+.
model KhangQuestion {
  id          String   @id @default(cuid())
  // User submitter
  authorId    String
  author      User     @relation("KhangQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Question text
  content     String   @db.Text
  // Status: PENDING / SELECTED / ANSWERED / ARCHIVED
  status      KhangQuestionStatus @default(PENDING)
  // Khi nào Khang select trả lời
  selectedAt  DateTime?
  // Voice reply ID (sau khi Khang answer)
  voiceReplyId String?
  voiceReply  KhangVoice? @relation(fields: [voiceReplyId], references: [id])
  // Vote 👍 từ user khác (signal cho Khang biết câu nào nên ưu tiên)
  upvoteCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  upvotes     KhangQuestionUpvote[]

  @@index([status, createdAt])
  @@index([authorId])
}

enum KhangQuestionStatus {
  PENDING    // chờ Khang đọc
  SELECTED   // Khang đã pick để trả lời
  ANSWERED   // có voice reply
  ARCHIVED   // không trả lời (có thể duplicate)
}

model KhangQuestionUpvote {
  id          String   @id @default(cuid())
  questionId  String
  question    KhangQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("KhangQuestionUpvoter", fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([questionId, userId])
}

// ─── KHANG VOICE LIBRARY ─────────────────────────────────────────────────
// Voice clips Khang post — broadcast cho tất cả user nghe.
// Filter by chủ đề: "Q-Day" | "lapse" | "đi nhậu" | "vợ con" | "đêm khuya"
model KhangVoice {
  id          String   @id @default(cuid())
  // Title hiển thị
  title       String
  // Mô tả ngắn (preview text)
  description String?  @db.Text
  // URL audio file (MP3) — placeholder OK ban đầu
  audioUrl    String
  // Duration giây (cho UI hiển thị "3 phút", "8 phút")
  durationSec Int
  // Chủ đề: "Q-Day" | "lapse" | "đi nhậu" | "vợ con" | "đêm khuya" | "milestone" | "psychoeducation" | "general"
  topic       String
  // Tier tối thiểu để nghe: FREE (Sol Khám Phá), KHOI_DONG (Sol Start), DONG_HANH (Sol Control)
  minTier     UserTier @default(FREE)
  // Trigger auto-play: "onboard" (Day 0) | "lapse" (after lapse log) | "qday" (Q-Day morning) | NULL (manual)
  autoPlayTrigger String?
  // Nếu là voice reply Hỏi Khang → ref tới KhangQuestion
  isQuestionReply Boolean @default(false)
  // Pin lên top (Khang feature voice quan trọng)
  pinnedAt    DateTime?
  // Counters cached
  listenCount Int      @default(0)
  reactCount  Int      @default(0)
  // Status: DRAFT (Khang đang upload) | PUBLISHED | ARCHIVED
  status      KhangVoiceStatus @default(PUBLISHED)
  // Khang notes nội bộ (không show user)
  internalNotes String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questionReplies KhangQuestion[]
  listens     KhangVoiceListen[]
  reactions   KhangVoiceReaction[]

  @@index([status, topic, createdAt])
  @@index([autoPlayTrigger])
}

enum KhangVoiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KhangVoiceListen {
  id          String   @id @default(cuid())
  voiceId     String
  voice       KhangVoice @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("KhangVoiceListener", fields: [userId], references: [id], onDelete: Cascade)
  // % completed (0-100): 100 = nghe hết, 50 = bỏ giữa
  completionPct Int    @default(0)
  // Context: "auto" (auto-play) | "manual" (user click) | "push" (từ notification)
  context     String   @default("manual")

  createdAt   DateTime @default(now())

  @@index([userId, voiceId])
  @@index([voiceId, createdAt])
}

model KhangVoiceReaction {
  id          String   @id @default(cuid())
  voiceId     String
  voice       KhangVoice @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("KhangVoiceReactor", fields: [userId], references: [id], onDelete: Cascade)
  // 1 (👍) | 2 (🙏)
  reactionType Int

  createdAt   DateTime @default(now())

  @@unique([voiceId, userId])
}

// ─── CRISIS TIMER LOG ────────────────────────────────────────────────────
// User bấm "Tôi đang thèm" → app start 90s timer + voice Khang play.
// Sau timer: anh hút hay không? → outcome data quý cho Sol.
model CrisisTimerLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("CrisisTimerUser", fields: [userId], references: [id], onDelete: Cascade)
  // Thời điểm crave bắt đầu (khi user click button)
  startedAt     DateTime @default(now())
  // Thời điểm user mark "đã qua" hoặc "vẫn hút"
  endedAt       DateTime?
  // Thời gian delay được (giây). Nếu không hút sau 90s → 90+. Có thể >> 90 nếu user delay lâu.
  delayDurationSec Int?
  // Outcome: "delayed_no_smoke" (vượt qua) | "smoked_after" (sau timer vẫn hút) | "abandoned" (không mark gì)
  outcome       String?
  // Trigger context user khai (optional): "stress" | "social" | "habit" | "boredom" | "after_meal"
  triggerContext String?
  // Notes user viết sau timer (optional)
  notes         String?

  @@index([userId, startedAt])
  @@index([outcome])
}

// ─── ANONYMOUS STATS CACHE ───────────────────────────────────────────────
// Aggregated stats cho "Tuần này trong Sol" widget. Update bởi cron 1h/lần.
// User KHÔNG thấy ai là ai — chỉ thấy số liệu tổng.
model AnonymousStatsCache {
  id              String   @id @default(cuid())
  // Period: "this_week" | "this_month" | "today"
  period          String
  // Stats aggregated
  totalActiveUsers      Int @default(0)
  lateNightOpens        Int @default(0)  // mở sau 22h-2h
  lapseLogs             Int @default(0)  // log "đã hút" trong period
  recoveryWithin24h     Int @default(0)  // quay lại trong 24h sau lapse
  delayOver10min        Int @default(0)  // crisis timer >10 phút
  voiceListens          Int @default(0)  // total voice listened
  topVoiceId            String?           // voice nghe nhiều nhất
  topVoiceListenCount   Int @default(0)
  controlScoreAvg       Float @default(0) // average Control Score
  qDaysSet              Int @default(0)   // user đặt Q-Day trong period
  thirtyDayCleanCount   Int @default(0)   // user đạt 30 ngày sạch

  computedAt      DateTime @default(now())

  @@unique([period])
}

// ─── LAPSE-FRIENDLY LOG ──────────────────────────────────────────────────
// Khi user log "đã hút" — KHÔNG reset streak. Chỉ ghi nhận để Sol learn.
// Khác CigaretteLog (daily count) — đây là LAPSE event sau Q-Day.
model LapseEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("LapseUser", fields: [userId], references: [id], onDelete: Cascade)
  // Thời điểm anh hút lại
  lapsedAt      DateTime @default(now())
  // Số điếu trong lapse (1, 2, 3, 5, 7...)
  cigaretteCount Int     @default(1)
  // Context: "social_drinking" | "stress" | "funeral" | "wedding" | "alone_late_night" | "other"
  context       String?
  // Anh viết gì khi log lapse (optional, sau khi voice "không phải fail" play)
  reflection    String?  @db.Text
  // Khi nào anh quay lại Sol (mở app) sau lapse
  recoveredAt   DateTime?
  // Voice Khang lapse-friendly đã play chưa
  voicePlayed   Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([userId, lapsedAt])
}

// ═══════════════════════════════════════════════════════════════════════
// ZALO OA — Sol v3 (12-05-2026)
// ═══════════════════════════════════════════════════════════════════════
// 5 models cho Zalo OA integration:
// - ZaloOAUser: follower OA, có thể link với User Sol
// - ZNSLog: log mỗi tin ZNS đã gửi
// - ZaloTemplate: 17 template Sol quản lý qua Admin
// - MessagingPolicy: 3 layers Global/Cohort/User policy
// - UserMessagingProfile: per-user behavior + cohort

model ZaloOAUser {
  id           String    @id @default(cuid())
  // Link với User Sol nếu đã merge (qua Zalo Login OAuth). NULL nếu chỉ follow OA chưa đăng ký Sol.
  userId       String?   @unique
  user         User?     @relation("ZaloOAUserUser", fields: [userId], references: [id], onDelete: SetNull)
  // ID user trên Zalo (zaloUserId của OA scope, KHÁC với zaloId của Login scope)
  zaloUserId   String    @unique
  // OA Sol = 3049397094672064963
  oaId         String
  displayName  String?
  avatarUrl    String?
  followedAt   DateTime  @default(now())
  blockedAt    DateTime?
  optedOut     Boolean   @default(false)
  lastChatAt   DateTime?
  totalMsgIn   Int       @default(0)  // tin user gửi vào OA
  totalMsgOut  Int       @default(0)  // tin Sol reply
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([oaId])
  @@index([lastChatAt])
}

model ZNSLog {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("ZNSLogUser", fields: [userId], references: [id], onDelete: Cascade)
  templateCode String    // SOL_WELCOME, SOL_Q_DAY_MORNING, ...
  zaloTemplateId String? // ID Zalo của template (sau khi approved)
  params       Json      // {name, day, streak, ...}
  costVnd      Int       @default(0)  // chi phí ZNS thực tế (Zalo trả về sau)
  // Status: SENT / DELIVERED / OPENED / CLICKED / FAILED / EXPIRED
  status       String    @default("SENT")
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  errorCode    String?
  errorMessage String?
  // A/B test variant nếu có (vd "A" hoặc "B")
  experimentId String?
  variant      String?

  @@index([userId, sentAt])
  @@index([templateCode])
  @@index([status])
}

model ZaloTemplate {
  id              String    @id @default(cuid())
  // Code dùng trong backend (vd SOL_WELCOME, SOL_Q_DAY_MORNING). UNIQUE.
  code            String    @unique
  // Tên hiển thị trong Zalo Manager cho Khang dễ tra (vd "Sol — Chào mừng Day 1")
  zaloManagerName String
  // ID Zalo trả về sau khi submit approved. NULL nếu chưa submit.
  zaloTemplateId  String?   @unique
  // Tag: 1 (Transactional), 2 (Customer Care), 3 (Promotion). Sol dùng Tag 2.
  tag             String    @default("2")
  // Tiêu đề tin (max ~65 ký tự)
  title           String
  // Body tin (max ~330 ký tự cho body, total title+body 400)
  body            String    @db.Text
  // CTA buttons JSON: [{label, type: 'OPEN_URL'|'MAKE_PHONE_CALL'|'OPEN_ZALO_CHAT', value}]
  ctaButtons      Json      @default("[]")
  // Tham số động dùng trong template: ["name", "day", "streak"]
  params          String[]  @default([])
  // Số ký tự total (tính tự động)
  charCount       Int       @default(0)
  // Status: DRAFT / PENDING / APPROVED / REJECTED / ARCHIVED
  status          String    @default("DRAFT")
  rejectReason    String?
  // Dual-version pair: nếu là voice template thì link với text fallback template
  voiceTemplateCode String? // (nếu template này là TEXT fallback)
  textFallbackCode  String? // (nếu template này là VOICE primary)
  // Audit
  createdBy       String?   // admin userId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  submittedAt     DateTime?
  approvedAt      DateTime?
  archivedAt      DateTime?

  @@index([status])
  @@index([tag])
}

model MessagingPolicy {
  id            String    @id @default(cuid())
  // Scope: GLOBAL (default cho tất cả) / COHORT (theo nhóm) / USER (per-user override)
  scope         String    @default("GLOBAL")
  // Nếu scope=COHORT: LIGHT / MODERATE / HEAVY
  cohortKey     String?
  // Nếu scope=USER: link tới User
  userId        String?
  user          User?     @relation("MessagingPolicyUser", fields: [userId], references: [id], onDelete: Cascade)
  // Intensity preset: LIGHT / MEDIUM / HEAVY / CUSTOM
  intensity     String    @default("MEDIUM")
  // Per-template config JSON. Vd:
  // { "SOL_DAILY_CHECKIN": { enabled: true, sendHour: 20, dayRange: [1,52], maxPerDay: 1 } }
  config        Json      @default("{}")
  enabled       Boolean   @default(true)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([scope, cohortKey, userId])
  @@index([scope])
}

model UserMessagingProfile {
  userId          String    @id
  user            User      @relation("UserMessagingProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  // Auto-assigned từ FTND score onboarding: LIGHT (0-3) / MODERATE (4-6) / HEAVY (7-10)
  cohortKey       String    @default("MODERATE")
  ftndScore       Int?
  // Boost mode: push extra 14 ngày
  boostMode       Boolean   @default(false)
  boostUntil      DateTime?
  // Mute mode: pause toàn bộ ZNS N ngày
  muteUntil       DateTime?
  // Crisis threshold (1-10) — override cohort default
  crisisThreshold Int?
  // Engagement metric (auto-updated)
  engagementScore Float     @default(0)
  totalSent       Int       @default(0)
  totalOpened     Int       @default(0)
  totalClicked    Int       @default(0)
  totalBlocked    Int       @default(0)
  lastInteractAt  DateTime?
  // Notes admin (Khang ghi chú)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cohortKey])
}
