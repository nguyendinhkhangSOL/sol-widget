// ═══════════════ RENDER ═══════════════
function scoreClass(s){
  if(s>=80)return'sc-gold';
  if(s>=65)return'sc-green';
  if(s>=50)return'sc-blue';
  if(s>=35)return'sc-yellow';
  return'sc-gray';
}

function riskLabel(r){
  if(r==='low')return'<span class="cmeta meta-risk-low">Rủi ro thấp</span>';
  if(r==='high')return'<span class="cmeta meta-risk-high">Rủi ro cao</span>';
  return'<span class="cmeta meta-risk-mid">Rủi ro vừa</span>';
}

function renderCard(dir,idx){
  const score = calcScore(dir);
  const hasData = score !== null;
  let circleHtml = '';
  if(hasData){
    circleHtml = `<div class="score-circle ${scoreClass(score)}"><span class="sc-num">${score}</span><span class="sc-pct">%</span></div>`;
  }

  const pmScore = hasData ? calcPM(dir) : null;
  const rmScore = hasData ? calcRM(dir) : null;

  const reqBox = dir.requirements ? `<div class="req-box"><strong>⚡ Yêu cầu đặc biệt:</strong>${dir.requirements}</div>` : '';

  return `<div class="dir-card" id="card-${idx}">
    <div class="card-head" onclick="toggleCard(${idx})" id="head-${idx}">
      <div class="card-emoji">${dir.emoji}</div>
      <div class="card-info">
        <div class="card-title-row">
          <span class="card-title">${dir.title}</span>
          ${dir.isNew ? '<span class="badge-new">MỚI</span>' : ''}
        </div>
        <div class="card-meta">
          <span class="cmeta meta-income">💰 ${dir.income.min}–${dir.income.max}tr/tháng</span>
          <span class="cmeta meta-time">⏱ ${dir.timeline}</span>
          ${riskLabel(dir.riskLevel)}
        </div>
        <div class="card-desc">${dir.desc}</div>
      </div>
      ${circleHtml}
      <span class="card-chevron">▼</span>
    </div>
    <div class="card-body" id="body-${idx}">
      ${hasData ? `<div class="match-title">Mức độ phù hợp</div>
      <div class="mb-row"><span class="mb-label">DNA (P1)</span><div class="mb-track"><div class="mb-fill fill-pm" style="width:${pmScore}%"></div></div><span class="mb-val">${pmScore}%</span></div>
      <div class="mb-row"><span class="mb-label">Nguồn lực (P2)</span><div class="mb-track"><div class="mb-fill fill-rm" style="width:${rmScore}%"></div></div><span class="mb-val">${rmScore}%</span></div>
      <div style="margin-bottom:14px"></div>` : ''}
      <div class="roadmap-label">🗺️ Roadmap bắt đầu</div>
      <div class="roadmap-steps">
        ${dir.roadmap.map((step,i)=>`<div class="rm-step"><div class="rm-num">${i+1}</div><div class="rm-text">${step}</div></div>`).join('')}
      </div>
      ${reqBox}
    </div>
  </div>`;
}

function calcPM(dir){
  const p1=getP1();if(!p1)return 0;
  const dims=['people','expert','builder','independent'];
  const tot=dims.reduce((s,d)=>s+dir.p[d],0)||1;
  let ws=0;dims.forEach(d=>{const u=p1.norm[d]||0,req=dir.p[d];ws+=(u>=req?100:Math.max(0,100-(req-u)*1.3))*(req/tot);});
  return Math.min(100,Math.round(ws));
}
function calcRM(dir){
  const p2=getP2();if(!p2)return 0;
  const map=[['capScore','capital'],['timeScore','time'],['techScore','technology'],['netScore','network'],['riskScore','risk'],['energyScore','energy']];
  let rt=0,ex=0;map.forEach(([pk,dk])=>{const u=p2[pk]||0,req=dir.r[dk]||0;if(!req){rt+=100;return;}const s=u>=req?100:Math.max(0,(u/req)*100);rt+=s;if(u/req<0.45&&req>=40)ex+=12;});
  const eb=(((p2.expScore||50)-50)/50)*(dir.exp_lev/100)*18;
  return Math.max(0,Math.min(100,Math.round(rt/map.length+eb-ex)));
}

function toggleCard(idx){
  const head = document.getElementById('head-'+idx);
  const body = document.getElementById('body-'+idx);
  const isOpen = body.classList.contains('open');
  // close all
  document.querySelectorAll('.card-body').forEach(b=>b.classList.remove('open'));
  document.querySelectorAll('.card-head').forEach(h=>h.classList.remove('open'));
  if(!isOpen){
    body.classList.add('open');
    head.classList.add('open');
  }
}

function init(){
  const p1=getP1(),p2=getP2();
  if(!p1||!p2) document.getElementById('nodataNotice').style.display='flex';

  // Sort by score if available
  let dirs = [...DIRS];
  if(p1&&p2){
    dirs.sort((a,b)=>(calcScore(b)||0)-(calcScore(a)||0));
  }

  document.getElementById('dirCards').innerHTML = dirs.map((d,i)=>renderCard(d,i)).join('');
}

init();
</script>
