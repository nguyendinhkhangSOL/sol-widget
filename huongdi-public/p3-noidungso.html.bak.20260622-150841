<script>
// ═══════════════════════════════════════
// SCORE FUNCTIONS (from spec)
// ═══════════════════════════════════════
function getP1(){try{const d=JSON.parse(localStorage.getItem('p1_result')||'null');if(!d||!d.scores)return null;const norm=d.scores_normalized||{};if(!norm.people)Object.entries(d.scores).forEach(([k,v])=>{norm[k]=Math.round(Math.max(0,Math.min(100,(v-20)/80*100)));});return{norm,raw:d.scores};}catch(e){return null;}}
function getP2(){try{const d=JSON.parse(localStorage.getItem('p2_result')||'null');if(!d||!d.scores)return null;return d.scores;}catch(e){return null;}}
function pm(norm,dp){const dims=['people','expert','builder','independent'];const tot=dims.reduce((s,d)=>s+dp[d],0)||1;let ws=0;dims.forEach(d=>{const u=norm[d]||0,req=dp[d];ws+=(u>=req?100:Math.max(0,100-(req-u)*1.3))*(req/tot);});return Math.min(100,Math.round(ws));}
function rm(sc,dr,el){const map=[['capScore','capital'],['timeScore','time'],['techScore','technology'],['netScore','network'],['riskScore','risk'],['energyScore','energy']];let tot=0,ex=0;map.forEach(([pk,dk])=>{const u=sc[pk]||0,req=dr[dk]||0;if(!req){tot+=100;return;}const s=u>=req?100:Math.max(0,(u/req)*100);tot+=s;if(u/req<0.45&&req>=40)ex+=12;});const eb=(((sc.expScore||50)-50)/50)*(el/100)*18;return Math.max(0,Math.min(100,Math.round(tot/map.length+eb-ex)));}
function calcScore(dir){const p1=getP1(),p2=getP2();if(!p1||!p2)return null;return Math.round(pm(p1.norm,dir.p)*0.5+rm(p2,dir.r,dir.exp_lev)*0.35+82*0.15);}

// ═══════════════════════════════════════
// DIRECTION DATA
// ═══════════════════════════════════════
const DIRS = {
  blog: {
    p:{people:30,expert:80,builder:65,independent:85},
    r:{capital:5,time:50,technology:55,network:25,risk:10,energy:45},
    exp_lev:80
  },
  youtube: {
    p:{people:65,expert:70,builder:65,independent:80},
    r:{capital:25,time:65,technology:70,network:35,risk:15,energy:65},
    exp_lev:65
  },
  ebook: {
    p:{people:25,expert:85,builder:60,independent:85},
    r:{capital:5,time:45,technology:45,network:25,risk:5,energy:40},
    exp_lev:90
  },
  newsletter: {
    p:{people:40,expert:80,builder:55,independent:85},
    r:{capital:5,time:35,technology:40,network:30,risk:5,energy:40},
    exp_lev:80
  },
  smm: {
    p:{people:60,expert:70,builder:50,independent:75},
    r:{capital:5,time:45,technology:65,network:45,risk:10,energy:55},
    exp_lev:60
  }
};

// ═══════════════════════════════════════
// SCORE CIRCLE
// ═══════════════════════════════════════
function scoreClass(s){
  if(s>=80)return'sc-gold';
  if(s>=65)return'sc-green';
  if(s>=50)return'sc-blue';
  if(s>=35)return'sc-yellow';
  return'sc-gray';
}

function renderScores(){
  const p1=getP1(), p2=getP2();
  if(!p1||!p2) return;

  Object.entries(DIRS).forEach(([key,dir])=>{
    const sc=calcScore(dir);
    if(sc===null) return;
    const el=document.getElementById('score-'+key);
    if(!el) return;
    el.className='score-circle '+scoreClass(sc);
    el.innerHTML=`<span class="sc-num">${sc}</span><span class="sc-pct">phù hợp</span>`;

    // render match bars
    const barsEl=document.getElementById('bars-'+key);
    if(barsEl){
      const pmScore=pm(p1.norm,dir.p);
      const rmScore=rm(p2,dir.r,dir.exp_lev);
      barsEl.innerHTML=`
        <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.4px">Phân tích điểm phù hợp</div>
        <div class="mb-row">
          <span class="mb-label">DNA cá nhân (P1)</span>
          <div class="mb-track"><div class="mb-fill fill-pm" style="width:0%" data-w="${pmScore}"></div></div>
          <span class="mb-val">${pmScore}</span>
        </div>
        <div class="mb-row">
          <span class="mb-label">Nguồn lực (P2)</span>
          <div class="mb-track"><div class="mb-fill fill-rm" style="width:0%" data-w="${rmScore}"></div></div>
          <span class="mb-val">${rmScore}</span>
        </div>
        <div class="mb-row">
          <span class="mb-label">Tổng điểm</span>
          <div class="mb-track"><div class="mb-fill fill-gm" style="width:0%" data-w="${sc}"></div></div>
          <span class="mb-val">${sc}</span>
        </div>`;
    }
  });

  // Animate bars when visible
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.querySelectorAll('.mb-fill[data-w]').forEach(bar=>{
          bar.style.width = bar.dataset.w + '%';
        });
        observer.unobserve(e.target);
      }
    });
  },{threshold:.2});

  document.querySelectorAll('.match-bars').forEach(el=>observer.observe(el));
}

// ═══════════════════════════════════════
// TOGGLE CARD
// ═══════════════════════════════════════
function toggleCard(key){
  const body=document.getElementById('body-'+key);
  const head=body.previousElementSibling;
  const isOpen=body.classList.contains('open');
  body.classList.toggle('open',!isOpen);
  head.setAttribute('aria-expanded',String(!isOpen));
  if(!isOpen){
    setTimeout(()=>{
      const fills=body.querySelectorAll('.mb-fill[data-w]');
      fills.forEach(f=>{ f.style.width=f.dataset.w+'%'; });
    },50);
  }
}

// ═══════════════════════════════════════
// TOGGLE ROADMAP
// ═══════════════════════════════════════
function toggleRoadmap(key){
  const content=document.getElementById('rc-'+key);
  const toggle=document.getElementById('rt-'+key);
  const isOpen=content.classList.contains('open');
  content.classList.toggle('open',!isOpen);
  toggle.classList.toggle('open',!isOpen);
}

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
document.addEventListener('DOMContentLoaded', renderScores);
</script>
