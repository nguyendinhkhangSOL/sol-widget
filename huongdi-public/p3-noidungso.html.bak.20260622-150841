    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .sol-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #1a1a1a;
    font-weight: 700;
    font-size: 15px;
    white-space: nowrap;
  }
  .sol-logo img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }
