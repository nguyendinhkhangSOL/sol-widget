<script id="sol-header-script">
  // Auto-highlight current page in sub-nav
  (function() {
    var path = window.location.pathname.replace(/\.html$/, '').replace(/\/$/, '');
    var matchKey = null;
    if (path === '/p1' || path.endsWith('/p1')) matchKey = 'p1';
    else if (path === '/p2' || path.endsWith('/p2')) matchKey = 'p2';
    else if (path.startsWith('/p3')) matchKey = 'p3';
    if (matchKey) {
      var links = document.querySelectorAll('.sol-nav-huongdi a[data-huongdi-link="' + matchKey + '"]');
      links.forEach(function(a) { a.classList.add('current'); });
    }
  })();
</script>
