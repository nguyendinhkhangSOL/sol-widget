        <button class="tab" data-buoc="4" onclick="switchTab(this,4)">🚀 Bước 4 · Hành Động <span class="tab-count" id="count-4">20</span></button>
        <button class="tab" data-buoc="5" onclick="switchTab(this,5)">🛡️ Bước 5 · An Toàn <span class="tab-count" id="count-5">5</span></button>
