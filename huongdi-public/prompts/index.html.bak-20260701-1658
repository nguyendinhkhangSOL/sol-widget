    <div class="tabs-wrapper">
      <input type="text" class="search-box" id="search-box" placeholder="🔍 Tìm mẫu theo tên hoặc chủ đề..." oninput="filterPrompts()">
      <div class="tabs" id="tabs">
        <button class="tab active" data-buoc="0" onclick="switchTab(this,0)">Tất cả <span class="tab-count" id="count-0">40</span></button>
