};

let activeBuoc = 0; // 0 = all
let searchQuery = '';

function switchTab(el, buoc) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  activeBuoc = buoc;
  renderGrid();
  window.scrollTo({top: document.querySelector('.tabs-wrapper').offsetTop - 20, behavior: 'smooth'});
}

function filterPrompts() {
  searchQuery = document.getElementById('search-box').value.trim().toLowerCase();
  renderGrid();
}

function getFilteredPrompts() {
  return PROMPTS.filter(p => {
    const matchBuoc = activeBuoc === 0 || p.buoc === activeBuoc;
    const matchSearch = !searchQuery ||
      p.title.toLowerCase().includes(searchQuery) ||
      p.description.toLowerCase().includes(searchQuery) ||
      p.category.toLowerCase().includes(searchQuery) ||
      p.id.toLowerCase().includes(searchQuery);
    return matchBuoc && matchSearch;
  });
}

function updateTabCounts() {
  document.getElementById('count-0').textContent = PROMPTS.length;
  for (let b = 1; b <= 5; b++) {
    const cnt = PROMPTS.filter(p => p.buoc === b).length;
    const el = document.getElementById('count-' + b);
    if (el) el.textContent = cnt;
  }
}

function renderGrid() {
  const grid = document.getElementById('prompts-grid');
  const filtered = getFilteredPrompts();

  if (filtered.length === 0) {
    grid.innerHTML = `
      <div class="no-results">
        <h3>🔍 Không tìm thấy mẫu phù hợp</h3>
        <p>Thử từ khoá khác hoặc chọn tab khác. Hoặc <a href="#" onclick="clearFilters();return false;">xem tất cả 40 mẫu</a>.</p>
      </div>`;
    return;
  }

  // Group by Bước when "Tất cả"
  let html = '';
  if (activeBuoc === 0 && !searchQuery) {
    for (let b = 1; b <= 5; b++) {
      const group = filtered.filter(p => p.buoc === b);
      if (group.length === 0) continue;
      const info = BUOC_INFO[b];
      html += `
        <div class="buoc-header">
          <div class="buoc-header__label">${info.label} · ${group.length} MẪU</div>
          <div class="buoc-header__title">${info.title}</div>
          <div class="buoc-header__desc">${info.desc}</div>
        </div>`;
      html += group.map(renderCard).join('');
    }
  } else {
    html = filtered.map(renderCard).join('');
  }
  grid.innerHTML = html;
}

function renderCard(p) {
  return `
    <div class="prompt-card" onclick="openForm('${p.id}')">
      <div class="prompt-card__id">${p.id} · ${p.category}</div>
      <div class="prompt-card__icon">${p.icon}</div>
      <h3 class="prompt-card__title">${p.title}</h3>
      <p class="prompt-card__desc">${p.description}</p>
      <div class="prompt-card__meta">
        <span>⏱ ${p.time}</span>
        <span>🤖 ${p.ai}</span>
      </div>
    </div>
  `;
}

function clearFilters() {
  activeBuoc = 0;
  searchQuery = '';
  document.getElementById('search-box').value = '';
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelector('.tab[data-buoc="0"]').classList.add('active');
  renderGrid();
}

let currentPrompt = null;

function openForm(id) {
  currentPrompt = PROMPTS.find(p => p.id === id);
  if (!currentPrompt) return;

  document.getElementById('grid-view').style.display = 'none';
  document.getElementById('form-view').classList.add('active');
  document.getElementById('result-container').innerHTML = '';

  document.getElementById('form-icon').textContent = currentPrompt.icon;
  document.getElementById('form-id').textContent = currentPrompt.id + ' · ' + currentPrompt.category;
  document.getElementById('form-title').textContent = currentPrompt.title;
  document.getElementById('form-desc').textContent = currentPrompt.description;

  const questionsHTML = currentPrompt.questions.map((q, i) => {
    const requiredMark = q.required ? '<span class="form-required">*</span>' : '';
    let inputHTML = '';

    if (q.type === 'text') {
      inputHTML = `<input type="text" class="form-input" id="q-${q.id}" placeholder="${q.placeholder || ''}"${q.required ? ' required' : ''}>`;
    } else if (q.type === 'textarea') {
      inputHTML = `<textarea class="form-textarea" id="q-${q.id}" placeholder="${q.placeholder || ''}"${q.required ? ' required' : ''}></textarea>`;
    } else if (q.type === 'select') {
      inputHTML = `<div class="form-radio-group">${q.options.map(opt => `
        <div class="form-radio" data-q="${q.id}" data-value="${opt}" onclick="selectRadio(this)">${opt}</div>
      `).join('')}</div>`;
    }

    return `
      <div class="form-group">
        <label class="form-label">${i + 1}. ${q.label} ${requiredMark}</label>
        ${inputHTML}
        ${q.hint ? `<div class="form-hint">💡 ${q.hint}</div>` : ''}
      </div>
    `;
  }).join('');

  document.getElementById('form-questions').innerHTML = questionsHTML + `
    <div class="form-actions">
      <button class="btn btn-primary" onclick="generatePrompt()">🎯 Tạo câu hỏi AI</button>
      <button class="btn btn-secondary" onclick="showGrid()">Huỷ</button>
    </div>
  `;

  window.scrollTo(0, 0);
}

function selectRadio(el) {
  const q = el.dataset.q;
  document.querySelectorAll(`[data-q="${q}"]`).forEach(r => r.classList.remove('active'));
  el.classList.add('active');
}

function showGrid() {
  document.getElementById('grid-view').style.display = 'block';
  document.getElementById('form-view').classList.remove('active');
  currentPrompt = null;
  window.scrollTo(0, 0);
}

function generatePrompt() {
  if (!currentPrompt) return;

  const values = {};
  let hasError = false;

  currentPrompt.questions.forEach(q => {
    if (q.type === 'select') {
      const selected = document.querySelector(`[data-q="${q.id}"].active`);
      values[q.id] = selected ? selected.dataset.value : '';
    } else {
      const input = document.getElementById(`q-${q.id}`);
      values[q.id] = input ? input.value.trim() : '';
    }

    if (q.required && !values[q.id]) {
      hasError = true;
    }
  });

  if (hasError) {
    alert('Vui lòng điền các câu có dấu *');
    return;
  }

  // Fill template
  let prompt = currentPrompt.template;
  Object.keys(values).forEach(key => {
    const regex = new RegExp('{{' + key + '}}', 'g');
    prompt = prompt.replace(regex, values[key] || '(không có)');
  });

  // Show result
  const resultHTML = `
    <div class="result-view">
      <div class="result-title">✅ Câu hỏi AI đã sẵn sàng!</div>
      <div class="result-help">
        <strong>Cách dùng:</strong> Nhấn nút "Sao chép" bên dưới → Mở ChatGPT hoặc Claude → Dán vào ô nhập → Bấm gửi. AI sẽ trả kết quả ngay trong 30-60 giây.
      </div>
      <textarea class="result-textarea" id="result-text" readonly>${prompt}</textarea>
      <div class="result-actions">
        <button class="btn btn-primary" onclick="copyResult()">📋 Sao chép câu hỏi</button>
        <button class="btn btn-secondary" onclick="openChatGPT()">🚀 Mở ChatGPT</button>
        <button class="btn btn-secondary" onclick="saveToJournal()">💾 Lưu vào Sổ Hành Trình</button>
      </div>
    </div>
  `;

  document.getElementById('result-container').innerHTML = resultHTML;
  document.getElementById('result-container').scrollIntoView({ behavior: 'smooth' });
}

function copyResult() {
  const text = document.getElementById('result-text').value;
  navigator.clipboard.writeText(text).then(() => {
    alert('✅ Đã sao chép! Giờ dán vào ChatGPT hoặc Claude.');
  }).catch(() => {
    document.getElementById('result-text').select();
    document.execCommand('copy');
    alert('✅ Đã sao chép!');
  });
}

function openChatGPT() {
  copyResult();
  setTimeout(() => {
    window.open('https://chat.openai.com', '_blank');
  }, 500);
}

function saveToJournal() {
  if (!currentPrompt) return;
  const text = document.getElementById('result-text').value;
  const entry = {
    id: 'prompt-' + Date.now(),
    prompt_id: currentPrompt.id,
    prompt_name: currentPrompt.title,
    generated_prompt: text,
    saved_at: new Date().toISOString()
  };

  const existing = JSON.parse(localStorage.getItem('sol_journal_prompts') || '[]');
  existing.unshift(entry);
  localStorage.setItem('sol_journal_prompts', JSON.stringify(existing.slice(0, 50)));

  alert(`💾 Đã lưu vào Sổ Hành Trình!\n\nBạn có ${existing.length} câu hỏi AI đã lưu.`);
}

