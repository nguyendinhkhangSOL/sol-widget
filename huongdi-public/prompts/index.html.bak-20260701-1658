<!-- Sol shared header/footer -->
<script src="/sol-ui.js"></script>

<script>
// ═══════════════════════════════════════════════════════════
// KHO CÂU HỎI AI — 10 mẫu soạn sẵn cho người Việt 40-60
// ═══════════════════════════════════════════════════════════
const PROMPTS = [
  {
    id: 'AI-001', buoc: 4,
    icon: '🎯',
    category: 'Bán hàng',
    title: 'Viết trang giới thiệu dịch vụ tư vấn',
    description: 'Tạo trang web giới thiệu dịch vụ tư vấn/huấn luyện cho khách doanh nghiệp vừa và nhỏ. Chuyên nghiệp, dễ đọc, thuyết phục.',
    time: '10 phút',
    ai: 'ChatGPT / Claude',
    questions: [
      {
        id: 'niche',
        label: 'Bạn tư vấn cho ai? Trong ngành nào?',
        type: 'text',
        required: true,
        placeholder: 'VD: Tôi tư vấn tài chính cho chủ chuỗi nhà hàng nhỏ có 5-15 chi nhánh',
        hint: 'Càng cụ thể ngành nghề và quy mô càng tốt. Đừng viết chung chung "SME".'
      },
      {
        id: 'target_role',
        label: 'Người quyết định thuê bạn là ai?',
        type: 'select',
        options: ['Giám đốc/Chủ tịch (CEO)', 'Giám đốc tài chính (CFO)', 'Giám đốc vận hành (COO)', 'Người sáng lập (Founder)', 'Giám đốc marketing', 'Giám đốc nhân sự', 'Chủ doanh nghiệp gia đình', 'Khác'],
        required: true
      },
      {
        id: 'pain_point',
        label: 'Khách của bạn đang gặp khó khăn gì? Hãy kể như đang tâm sự với đồng nghiệp.',
        type: 'textarea',
        required: true,
        placeholder: 'VD: Chủ chuỗi nhà hàng đang mở thêm chi nhánh nhưng không biết chính xác chi nhánh nào có lãi, chi nhánh nào lỗ. Báo cáo cuối tháng chỉ cho tổng số. Không biết nên đóng chi nhánh cũ hay mở thêm chi nhánh mới. Ngủ không ngon vì lo tiền.',
        hint: 'Viết như đang kể một câu chuyện thật. AI sẽ biến thành lời văn thuyết phục.'
      },
      {
        id: 'outcome',
        label: 'Sau khi thuê bạn, khách nhận được gì cụ thể?',
        type: 'text',
        required: true,
        placeholder: 'VD: Sau 90 ngày, chủ nhà hàng có báo cáo chi tiết từng chi nhánh + biết chính xác nên đóng hay mở nơi nào để lợi nhuận tăng 15-25%',
        hint: 'Con số cụ thể và thời gian cụ thể. Đừng hứa quá.'
      },
      {
        id: 'proof',
        label: 'Bạn đã giúp khách nào tương tự? (không bắt buộc)',
        type: 'textarea',
        required: false,
        placeholder: 'VD: Anh Tuấn 48 tuổi, chủ chuỗi 8 nhà hàng ở TP.HCM. Sau 3 tháng tư vấn, anh phát hiện 3 chi nhánh lỗ và đóng, đầu tư vào 2 chi nhánh có tiềm năng. Lợi nhuận tăng 22% trong 6 tháng tiếp theo.',
        hint: 'Nếu có câu chuyện thật thì tốt. Nếu chưa có, để trống cũng được.'
      },
      {
        id: 'pricing_model',
        label: 'Bạn tính phí như thế nào?',
        type: 'select',
        options: ['Trả theo tháng (cố định)', 'Trả theo dự án (1 lần)', 'Trả theo kết quả (thành công phí)', 'Chưa quyết định'],
        required: true
      },
      {
        id: 'tone',
        label: 'Giọng văn bạn muốn?',
        type: 'select',
        options: ['Chuyên nghiệp trang trọng (như luật sư)', 'Thân thiện cân bằng (như đồng nghiệp)', 'Táo bạo khác biệt (như chuyên gia có chính kiến)'],
        required: true
      }
    ],
    template: `Bạn là chuyên gia viết nội dung marketing cho các dịch vụ tư vấn/huấn luyện tại Việt Nam. Hãy viết trang web giới thiệu dịch vụ dựa trên thông tin sau.

═══════════════════════════════════════════
THÔNG TIN DỊCH VỤ
═══════════════════════════════════════════

Đối tượng khách hàng: {{niche}}
Người quyết định thuê: {{target_role}}

Khó khăn khách đang gặp:
{{pain_point}}

Kết quả cam kết mang lại:
{{outcome}}

Câu chuyện khách đã giúp (nếu có):
{{proof}}

Cách tính phí: {{pricing_model}}

═══════════════════════════════════════════
CẤU TRÚC TRANG WEB (800-1200 từ)
═══════════════════════════════════════════

1. TIÊU ĐỀ CHÍNH (100 từ)
   - Câu tiêu đề lớn: nói về khó khăn khách + kết quả nhận được
   - Câu phụ: nói rõ AI làm cho ai, bằng cách nào
   - Chữ trên nút bấm CTA

2. VẤN ĐỀ (150 từ)
   - 3 khó khăn cụ thể mà {{target_role}} đang gặp
   - Mô tả thực tế, không thổi phồng

3. GIẢI PHÁP (150 từ)
   - 3-4 điểm khác biệt của bạn
   - Kết nối với kết quả cam kết

