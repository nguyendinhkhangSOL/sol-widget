<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
:root{
  --primary:#1a6b4a;--pm:#2e8b63;--pl:#e8f5ee;
  --accent:#f59e0b;--al:#fef3c7;
  --text:#1a202c;--muted:#6b7280;--border:#e5e7eb;--bg:#f9fafb;--white:#fff;
  --shadow:0 2px 12px rgba(0,0,0,.08);--r:14px;
  --green:#10b981;--blue:#3b82f6;--red:#ef4444;--orange:#f97316;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text);font-size:15px;line-height:1.6}

/* HEADER */
.hdr{background:var(--white);border-bottom:1px solid var(--border);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.logo{font-weight:800;font-size:15px;color:var(--primary);text-decoration:none}
.logo em{color:var(--accent);font-style:normal}
.hdr-right{display:flex;gap:8px;align-items:center}
.btn-back{font-size:12px;color:var(--muted);background:transparent;border:1px solid var(--border);padding:5px 12px;border-radius:99px;cursor:pointer;text-decoration:none;white-space:nowrap}
.btn-back:hover{border-color:var(--primary);color:var(--primary)}

/* HERO */
.hero{background:linear-gradient(135deg,#92400e 0%,#b45309 40%,#d97706 100%);color:white;padding:36px 20px 40px;text-align:center}
.hero-icon{font-size:52px;margin-bottom:12px;display:block}
.hero h1{font-size:26px;font-weight:800;margin-bottom:8px;line-height:1.2}
.hero p{font-size:15px;opacity:.9;margin-bottom:18px;max-width:500px;margin-left:auto;margin-right:auto}
.hero-chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.hero-chip{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.35);border-radius:99px;padding:4px 14px;font-size:13px;font-weight:600;color:white}

/* MAIN */
.main{max-width:760px;margin:0 auto;padding:24px 14px 60px}

/* SECTION TITLE */
.sec-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:14px;margin-top:28px}

/* DIRECTION CARDS */
.dir-cards{display:flex;flex-direction:column;gap:12px}

.dir-card{background:var(--white);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden;border:2px solid transparent;transition:border-color .2s}
.dir-card:hover{border-color:var(--primary)}

.card-head{padding:18px 20px;cursor:pointer;display:flex;align-items:flex-start;gap:14px;user-select:none}
.card-head:active{background:#fafafa}
.card-emoji{font-size:26px;flex-shrink:0;width:42px;height:42px;display:flex;align-items:center;justify-content:center}
.card-info{flex:1;min-width:0}
.card-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px}
.card-title{font-size:16px;font-weight:800;color:var(--text);line-height:1.3}
.badge-new{background:#f97316;color:white;font-size:10px;font-weight:800;padding:2px 7px;border-radius:99px;letter-spacing:.3px}
.card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px}
.cmeta{font-size:11px;font-weight:600;padding:2px 8px;border-radius:99px}
.meta-income{background:#f0fdf4;color:#15803d;border:1px solid #86efac}
.meta-time{background:var(--bg);color:var(--muted);border:1px solid var(--border)}
.meta-risk-low{background:#f0fdf4;color:#15803d}
.meta-risk-mid{background:var(--al);color:#92400e}
.meta-risk-high{background:#fee2e2;color:#dc2626}
.card-desc{font-size:13px;color:var(--muted);line-height:1.5}
.card-chevron{color:var(--muted);font-size:18px;flex-shrink:0;margin-top:2px;transition:transform .25s}
.card-head.open .card-chevron{transform:rotate(180deg)}

/* SCORE CIRCLE */
.score-circle{flex-shrink:0;width:56px;height:56px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800}
.sc-gold{background:#fef9c3;border:3px solid #fbbf24;color:#713f12}
.sc-green{background:#dcfce7;border:3px solid #4ade80;color:#15803d}
.sc-blue{background:#dbeafe;border:3px solid #60a5fa;color:#1d4ed8}
.sc-yellow{background:var(--al);border:3px solid var(--accent);color:#92400e}
.sc-gray{background:#f3f4f6;border:3px solid #d1d5db;color:#6b7280}
.sc-num{font-size:17px;line-height:1}
.sc-pct{font-size:10px;line-height:1}

/* CARD BODY */
.card-body{display:none;border-top:1px solid var(--border);padding:18px 20px}
.card-body.open{display:block}

/* MATCH BARS */
.match-title{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px}
.mb-row{display:flex;align-items:center;gap:10px;margin-bottom:7px}
.mb-label{width:110px;font-size:13px;color:var(--muted);flex-shrink:0}
.mb-track{flex:1;height:6px;background:var(--bg);border-radius:99px;overflow:hidden}
.mb-fill{height:100%;border-radius:99px;transition:width 1s ease-out}
.fill-pm{background:var(--primary)}
.fill-rm{background:var(--blue)}
.mb-val{font-size:12px;font-weight:700;width:30px;text-align:right}

/* ROADMAP */
.roadmap-label{font-size:13px;font-weight:700;color:var(--primary);margin:16px 0 10px;display:flex;align-items:center;gap:6px}
.roadmap-steps{display:flex;flex-direction:column;gap:0}
.rm-step{display:flex;gap:12px;position:relative}
.rm-step:not(:last-child)::before{content:'';position:absolute;left:13px;top:28px;bottom:-4px;width:2px;background:var(--border)}
.rm-num{width:26px;height:26px;border-radius:50%;background:var(--primary);color:white;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;position:relative;z-index:1}
.rm-text{font-size:13px;line-height:1.5;color:var(--text);padding-bottom:14px}

/* REQUIREMENTS BOX */
.req-box{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:12px 14px;margin-top:12px;font-size:13px;color:#92400e;line-height:1.5}
.req-box strong{display:block;margin-bottom:4px;color:#78350f}

/* WARNING */
.warning-box{background:#fff7ed;border:2px solid #fed7aa;border-radius:var(--r);padding:18px 20px;margin-top:28px;display:flex;gap:12px;align-items:flex-start}
.warn-icon{font-size:22px;flex-shrink:0}
.warn-text strong{display:block;font-size:14px;font-weight:800;color:#c2410c;margin-bottom:4px}
.warn-text p{font-size:13px;color:#92400e;line-height:1.5}

/* COMPARISON TABLE */
.comp-section{margin-top:32px}
.comp-title{font-size:17px;font-weight:800;color:var(--text);margin-bottom:14px}
.comp-table{width:100%;border-collapse:collapse;font-size:13px}
.comp-table th{background:var(--primary);color:white;padding:10px 12px;text-align:left;font-size:12px;font-weight:700}
.comp-table th:first-child{border-radius:10px 0 0 0}
.comp-table th:last-child{border-radius:0 10px 0 0}
.comp-table td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:middle}
.comp-table tr:hover td{background:#f8fafc}
.ind-green{color:#15803d;font-weight:700}
.ind-yellow{color:#d97706;font-weight:700}
.ind-red{color:#dc2626;font-weight:700}

/* CTA */
.cta-box{background:linear-gradient(135deg,var(--pl),#dcfce7);border:2px solid #86efac;border-radius:var(--r);padding:24px;margin-top:28px;text-align:center}
.cta-box h3{font-size:17px;font-weight:800;color:var(--primary);margin-bottom:8px}
.cta-box p{font-size:14px;color:var(--muted);margin-bottom:16px}
.cta-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.btn-primary{padding:12px 24px;background:var(--primary);color:white;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}
.btn-primary:hover{background:var(--pm)}
.btn-secondary{padding:12px 20px;background:transparent;border:2px solid var(--primary);border-radius:12px;font-size:14px;font-weight:600;color:var(--primary);text-decoration:none;display:inline-block}

/* NO DATA NOTICE */
.nodata-notice{background:var(--al);border:1px solid #fcd34d;border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:13px;color:#92400e;display:flex;align-items:center;gap:8px}
.nodata-notice a{color:var(--primary);font-weight:700}

/* FOOTER */
.footer{background:var(--white);border-top:1px solid var(--border);padding:24px 20px;margin-top:40px}
.footer-links{max-width:760px;margin:0 auto;display:flex;flex-wrap:wrap;gap:16px;justify-content:center}
.footer-links a{font-size:13px;color:var(--muted);text-decoration:none}
.footer-links a:hover{color:var(--primary)}
.footer-copy{text-align:center;font-size:12px;color:var(--muted);margin-top:14px;max-width:760px;margin-left:auto;margin-right:auto}

@media(max-width:560px){
  .hero h1{font-size:22px}
  .card-head{gap:10px}
  .score-circle{width:48px;height:48px}.sc-num{font-size:15px}
  .comp-table{font-size:12px}
  .comp-table th,.comp-table td{padding:8px 8px}
  .hdr-right{gap:4px}
  .btn-back{font-size:11px;padding:4px 9px}
}
