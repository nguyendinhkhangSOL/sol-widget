function getP1(){try{const d=JSON.parse(localStorage.getItem('p1_result')||'null');if(!d||!d.scores)return null;const norm=d.scores_normalized||{};if(!norm.people)Object.entries(d.scores).forEach(([k,v])=>{norm[k]=Math.round(Math.max(0,Math.min(100,(v-20)/80*100)));});return{norm};}catch(e){return null;}}
function getP2(){try{const d=JSON.parse(localStorage.getItem('p2_result')||'null');if(!d||!d.scores)return null;return d.scores;}catch(e){return null;}}
function calcScore(dir){
  const p1=getP1(),p2=getP2();if(!p1||!p2)return null;
  const dims=['people','expert','builder','independent'];
  const tot=dims.reduce((s,d)=>s+dir.p[d],0)||1;
  let ws=0;dims.forEach(d=>{const u=p1.norm[d]||0,req=dir.p[d];ws+=(u>=req?100:Math.max(0,100-(req-u)*1.3))*(req/tot);});
  const pm=Math.min(100,Math.round(ws));
  const map=[['capScore','capital'],['timeScore','time'],['techScore','technology'],['netScore','network'],['riskScore','risk'],['energyScore','energy']];
  let rt=0,ex=0;map.forEach(([pk,dk])=>{const u=p2[pk]||0,req=dir.r[dk]||0;if(!req){rt+=100;return;}const s=u>=req?100:Math.max(0,(u/req)*100);rt+=s;if(u/req<0.45&&req>=40)ex+=12;});
  const eb=(((p2.expScore||50)-50)/50)*(dir.exp_lev/100)*18;
  const rm=Math.max(0,Math.min(100,Math.round(rt/map.length+eb-ex)));
  return Math.round(pm*0.5+rm*0.35+82*0.15);
}

