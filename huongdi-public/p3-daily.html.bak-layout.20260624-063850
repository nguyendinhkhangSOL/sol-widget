<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
:root{--g:#1a6b4a;--gm:#2e8b63;--gl:#e8f5ee;--a:#f59e0b;--al:#fef3c7;--tx:#1a202c;--mu:#6b7280;--bd:#e5e7eb;--bg:#f9fafb;--wh:#fff;--sh:0 2px 12px rgba(0,0,0,.08);--r:14px;--cat:#0f766e;--catl:#ccfbf1;--catd:#134e4a;}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--tx);font-size:15px;line-height:1.6}
a{text-decoration:none}
.hdr{background:var(--wh);border-bottom:1px solid var(--bd);padding:11px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200}
.logo{font-weight:800;font-size:15px;color:var(--g)}.logo em{color:var(--a);font-style:normal}
.btn-sm{font-size:12px;color:var(--mu);background:transparent;border:1px solid var(--bd);padding:5px 12px;border-radius:99px;cursor:pointer}
.btn-sm:hover{border-color:var(--g);color:var(--g)}
.hero{background:linear-gradient(135deg,var(--catd) 0%,var(--cat) 60%,#0891b2 100%);padding:32px 20px 28px;text-align:center;color:white}
.hero-icon{font-size:44px;margin-bottom:8px}
.hero h1{font-size:24px;font-weight:900;margin-bottom:6px}
.hero p{font-size:14px;opacity:.85;max-width:500px;margin:0 auto 14px}
.hero-meta{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.hm{font-size:12px;font-weight:600;padding:4px 12px;background:rgba(255,255,255,.15);border-radius:99px;border:1px solid rgba(255,255,255,.25)}
.score-bar{background:var(--wh);border-bottom:1px solid var(--bd);padding:12px 20px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center}
.sb-num{font-size:20px;font-weight:800;color:var(--cat)}.sb-lbl{font-size:11px;color:var(--mu)}
.wrap{max-width:760px;margin:0 auto;padding:18px 14px 60px}
.section-hdr{margin-bottom:14px}
.section-hdr h2{font-size:18px;font-weight:800;color:var(--g);margin-bottom:3px}
.section-hdr p{font-size:13px;color:var(--mu)}
.cards{display:flex;flex-direction:column;gap:10px}
.card{background:var(--wh);border-radius:var(--r);box-shadow:var(--sh);border:2px solid transparent;overflow:hidden;transition:border-color .18s}
.card:hover{border-color:#5eead4}.card.best{border-color:#2dd4bf}
.card-hd{padding:16px 18px;cursor:pointer;display:flex;align-items:flex-start;gap:12px}
.card-emoji{font-size:26px;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.card-meta{flex:1;min-width:0}
.card-title{font-size:15px;font-weight:800;margin-bottom:5px;line-height:1.3}
.badges{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:5px}
.b{font-size:11px;font-weight:600;padding:2px 8px;border-radius:99px}
.b-cat{background:var(--catl);color:var(--catd)}.b-income{background:#f0fdf4;color:#15803d;border:1px solid #86efac}
.b-time{background:var(--bg);color:var(--mu);border:1px solid var(--bd)}.b-risk-lo{background:#f0fdf4;color:#15803d}
.b-risk-md{background:var(--al);color:#92400e}.b-new{background:#fed7aa;color:#c2410c}
.card-desc{font-size:13px;color:var(--mu);line-height:1.5}
.sc{flex-shrink:0;width:58px;height:58px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;border:3px solid}
.sc-gold{background:#fef9c3;border-color:#fbbf24;color:#713f12}.sc-green{background:#dcfce7;border-color:#4ade80;color:#15803d}
.sc-blue{background:#dbeafe;border-color:#60a5fa;color:#1d4ed8}.sc-teal{background:var(--catl);border-color:#2dd4bf;color:var(--catd)}
.sc-gray{background:#f3f4f6;border-color:#d1d5db;color:#6b7280}
.sc-num{font-size:17px;line-height:1}.sc-pct{font-size:10px;line-height:1}.sc-na{font-size:11px;font-weight:600;color:var(--mu)}
.card-bd{display:none;border-top:1px solid var(--bd);padding:16px 18px}.card-bd.on{display:block}
.mb-row{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.mb-lbl{width:100px;font-size:12px;color:var(--mu);flex-shrink:0}
.mb-track{flex:1;height:5px;background:var(--bg);border-radius:99px;overflow:hidden}
.mb-fill{height:100%;border-radius:99px;transition:width .8s ease-out}
.mf-p{background:var(--cat)}.mf-r{background:#3b82f6}
.mb-val{font-size:11px;font-weight:700;width:28px;text-align:right}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}
.info-box{background:var(--catl);border-radius:10px;padding:10px 12px}
.info-box h4{font-size:11px;font-weight:700;color:var(--catd);text-transform:uppercase;letter-spacing:.3px;margin-bottom:5px}
.info-list li{font-size:12px;display:flex;gap:5px;margin-bottom:3px}
.info-box2{background:#f0fdf4;border-radius:10px;padding:10px 12px}
.info-box2 h4{font-size:11px;font-weight:700;color:#065f46;text-transform:uppercase;letter-spacing:.3px;margin-bottom:5px}
.tools-row{display:flex;flex-wrap:wrap;gap:5px;margin:10px 0}
.tool-chip{font-size:11px;font-weight:600;padding:3px 9px;border-radius:99px;background:var(--bg);border:1px solid var(--bd)}
.rm-toggle{display:flex;align-items:center;gap:6px;padding:9px 13px;background:var(--catl);border-radius:10px;cursor:pointer;border:none;width:100%;text-align:left;font-size:13px;font-weight:600;color:var(--catd);margin:10px 0 8px}
.rm-toggle svg{margin-left:auto;transition:transform .25s}.rm-toggle.on svg{transform:rotate(180deg)}
.rm-body{display:none;padding:12px;background:var(--bg);border-radius:10px;margin-bottom:10px}.rm-body.on{display:block}
.rm-step{display:flex;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--bd)}
.rm-step:last-child{margin:0;padding:0;border:none}
.rm-dot{width:26px;height:26px;border-radius:50%;background:var(--cat);color:white;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.rm-text{font-size:12px;line-height:1.5}.rm-text strong{display:block;font-weight:700;margin-bottom:2px}
.card-actions{display:flex;gap:8px;margin-top:10px}
.btn-save{flex:1;padding:10px;background:var(--cat);color:white;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer}
.btn-save.saved{background:#059669}
.btn-back{padding:10px 16px;background:transparent;border:2px solid var(--bd);border-radius:10px;font-size:13px;color:var(--mu);cursor:pointer}
.comp-table{margin-top:24px;background:var(--wh);border-radius:var(--r);padding:18px;box-shadow:var(--sh);overflow-x:auto}
.comp-table h3{font-size:16px;font-weight:800;color:var(--g);margin-bottom:12px}
table{width:100%;border-collapse:collapse;font-size:12px}
th{background:var(--catl);color:var(--catd);font-weight:700;padding:8px 10px;text-align:left;white-space:nowrap}
td{padding:8px 10px;border-bottom:1px solid var(--bd)}
tr:last-child td{border:none}tr:hover td{background:var(--bg)}
td:first-child{font-weight:700}
.cta-box{margin-top:16px;background:linear-gradient(135deg,var(--catl),#ccfbf1);border:2px solid #2dd4bf;border-radius:var(--r);padding:20px;text-align:center}
.cta-box h3{font-size:16px;font-weight:800;color:var(--catd);margin-bottom:6px}
.cta-box p{font-size:13px;color:var(--mu);margin-bottom:12px}
.btn-cta{display:inline-block;padding:12px 28px;background:var(--g);color:white;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none}
@media(max-width:560px){.info-grid{grid-template-columns:1fr}}
