 roadmap:[{w:'Tuần 1',t:'Chọn 2-3 sản phẩm tin tưởng thực sự',d:'Danh sách những thứ bạn đang dùng và thích: khóa học, phần mềm, sản phẩm sức khỏe, dịch vụ. Chỉ giới thiệu thứ mình dùng. Mất uy tín network = mất tất cả.'},
  {w:'Tuần 2',t:'Liên hệ chương trình affiliate/CTV',d:'Hầu hết brand có chương trình CTV. Đăng ký và nhận link tracking riêng. Hoa hồng 5-20% tùy sản phẩm. Hỏi thêm về điều kiện và cách tính.'},
  {w:'Tuần 3',t:'Chia sẻ trong context tự nhiên',d:'Review thật trên Facebook cá nhân về sản phẩm đã dùng. Chia sẻ khi ai đó hỏi — không phải chủ động chào hàng. Chân thật > kỹ thuật bán hàng.'},
  {w:'Tuần 4',t:'Track và mở rộng',d:'Theo dõi ai đăng ký qua link của bạn. Hỏi họ trải nghiệm. Người hài lòng = giới thiệu thêm người khác. Referral từ referral là nguồn tốt nhất.'}]
}
];

function getP1(){try{const d=JSON.parse(localStorage.getItem('p1_result')||'null');if(!d||!d.scores)return null;const norm=d.scores_normalized||{};if(!norm.people)Object.entries(d.scores).forEach(([k,v])=>{norm[k]=Math.round(Math.max(0,Math.min(100,(v-20)/80*100)));});return norm;}catch(e){return null;}}
function getP2(){try{const d=JSON.parse(localStorage.getItem('p2_result')||'null');if(!d||!d.scores)return null;const sc=d.scores;return{capital:sc.capScore||0,time:sc.timeScore||0,technology:sc.techScore||0,network:sc.netScore||0,risk:sc.riskScore||0,energy:sc.energyScore||0,experience:sc.expScore||0};}catch(e){return null;}}
function pMatch(norm,dp){const dims=['people','expert','builder','independent'];const tot=dims.reduce((s,d)=>s+dp[d],0)||1;let ws=0;dims.forEach(d=>{const u=norm[d]||0,req=dp[d];ws+=(u>=req?100:Math.max(0,100-(req-u)*1.3))*(req/tot);});return Math.min(100,Math.round(ws));}
function rMatch(p2,dr){const map=[['capital','capital'],['time','time'],['technology','technology'],['network','network'],['risk','risk'],['energy','energy']];let tot=0,ex=0;map.forEach(([pk,dk])=>{const u=p2[pk]||0,req=dr[pk]||0;if(!req){tot+=100;return;}const s=u>=req?100:Math.max(0,(u/req)*100);tot+=s;if(u/req<0.45&&req>=40)ex+=12;});const eb=((p2.experience-50)/50)*0.7*18;return Math.max(0,Math.min(100,Math.round(tot/map.length+eb-ex)));}
function scClass(s){return s>=90?'sc-gold':s>=80?'sc-green':s>=70?'sc-blue':s>=60?'sc-teal':'sc-gray';}

window.addEventListener('DOMContentLoaded',()=>{
  const p1=getP1(),p2=getP2();
  const saved=JSON.parse(localStorage.getItem('p3_saved')||'[]');
  let sorted=[...DIRS];
  if(p1&&p2){
    sorted=DIRS.map(d=>({...d,_pm:pMatch(p1,d.p),_rm:rMatch(p2,d.r)})).map(d=>({...d,_score:Math.round(d._pm*0.5+d._rm*0.35+82*0.15)})).sort((a,b)=>b._score-a._score);
    document.getElementById('scoreBar').style.display='flex';
    const avg=Math.round(sorted.reduce((s,d)=>s+d._score,0)/sorted.length);
    document.getElementById('avgScore').textContent=avg+'%';
    document.getElementById('topScore').textContent=sorted[0]._score+'%';
    document.getElementById('topName').textContent=sorted[0].title;
    document.getElementById('subHdr').textContent=`Điểm phù hợp nhóm này: TB ${avg}%. Hướng tốt nhất: ${sorted[0].title} (${sorted[0]._score}%).`;
  }
  const cards=document.getElementById('cards');
  sorted.forEach((dir,i)=>{
    const s=dir._score,pm=dir._pm||null,rm=dir._rm||null;
    const isBest=i===0&&p1&&p2;
    const el=document.createElement('div');
    el.className='card'+(isBest?' best':'');
    const scHtml=s?`<div class="sc ${scClass(s)}"><div class="sc-num">${s}</div><div class="sc-pct">%</div></div>`:'<div class="sc sc-gray"><span class="sc-na">—</span></div>';
    const mbHtml=pm!=null?`<div class="mb-row"><span class="mb-lbl">🧬 Tính cách</span><div class="mb-track"><div class="mb-fill mf-p" data-w="${pm}" style="width:0"></div></div><span class="mb-val">${pm}%</span></div><div class="mb-row"><span class="mb-lbl">⚙️ Nguồn lực</span><div class="mb-track"><div class="mb-fill mf-r" data-w="${rm}" style="width:0"></div></div><span class="mb-val">${rm}%</span></div>`:'<p style="font-size:12px;color:var(--mu);margin-bottom:10px">Hoàn thành P1+P2 để xem điểm phân tích chi tiết.</p>';
    el.innerHTML=`<div class="card-hd" onclick="toggleCard(this)">
      <div class="card-emoji">${dir.emoji}</div>
      <div class="card-meta">
        ${isBest?'<span class="b b-new">⭐ Phù hợp nhất nhóm này</span>':''}
        <div class="card-title">${dir.title}</div>
        <div class="badges"><span class="b b-cat">Đại Lý & Kết Nối</span><span class="b b-income">💰 ${dir.income.min}–${dir.income.max}tr</span><span class="b b-time">⏱ ${dir.timeline}</span><span class="b ${dir.riskCls}">🟢 ${dir.risk}</span></div>
        <div class="card-desc">${dir.desc}</div>
      </div>${scHtml}
    </div>
    <div class="card-bd" id="bd-${dir.id}">
      <div style="margin-bottom:12px">${mbHtml}</div>
      <div class="info-grid">
        <div class="info-box"><h4>✅ Điểm mạnh</h4><ul class="info-list">${dir.strengths.map(s=>`<li><span>•</span><span>${s}</span></li>`).join('')}</ul></div>
        <div class="info-box2"><h4>⚡ Rào cản</h4><ul class="info-list">${dir.barriers.map(b=>`<li><span>•</span><span>${b}</span></li>`).join('')}</ul></div>
      </div>
      <div style="background:var(--bg);border-radius:10px;padding:10px 12px;margin-bottom:10px;font-size:12px"><strong style="display:block;margin-bottom:4px;color:var(--catd)">📋 Yêu cầu:</strong>${dir.requirements}</div>
      <div><span style="font-size:12px;font-weight:700;color:var(--mu)">🛠 Công cụ:</span><div class="tools-row">${dir.tools.map(t=>`<span class="tool-chip">${t}</span>`).join('')}</div></div>
      <button class="rm-toggle" onclick="toggleRm(this,'rm-${dir.id}')">📅 Roadmap 30 ngày <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button>
      <div class="rm-body" id="rm-${dir.id}">${dir.roadmap.map((w,n)=>`<div class="rm-step"><div class="rm-dot">${n+1}</div><div class="rm-text"><strong>${w.w} — ${w.t}</strong>${w.d}</div></div>`).join('')}</div>
      <div class="card-actions">
        <button class="btn-save ${saved.includes(dir.id)?'saved':''}" id="sv-${dir.id}" onclick="saveDir(event,'${dir.id}')">${saved.includes(dir.id)?'✅ Đã lưu':'💾 Lưu hướng này'}</button>
        <button class="btn-back" onclick="location.href='/p3.html'">← Xem tất cả</button>
      </div>
    </div>`;
    cards.appendChild(el);
    setTimeout(()=>el.querySelectorAll('.mb-fill[data-w]').forEach(b=>b.style.width=b.dataset.w+'%'),200+i*80);
  });
});
function toggleCard(hd){const bd=hd.nextElementSibling;const open=bd.classList.toggle('on');if(open)setTimeout(()=>bd.querySelectorAll('.mb-fill[data-w]').forEach(b=>{b.style.width='0';setTimeout(()=>b.style.width=b.dataset.w+'%',30);}),10);}
function toggleRm(btn,id){document.getElementById(id).classList.toggle('on');btn.classList.toggle('on');}
function saveDir(e,id){e.stopPropagation();const saved=JSON.parse(localStorage.getItem('p3_saved')||'[]');if(!saved.includes(id)){saved.push(id);localStorage.setItem('p3_saved',JSON.stringify(saved));}const btn=document.getElementById('sv-'+id);btn.textContent='✅ Đã lưu';btn.classList.add('saved');}
</script>
<script src="/sol-flow.js"></script>
</body>
</html>
