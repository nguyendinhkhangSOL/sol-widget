<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
:root{
  --primary:#1a6b4a;--pm:#2e8b63;--pl:#e8f5ee;
  --accent:#f59e0b;--al:#fef3c7;
  --text:#1a202c;--muted:#6b7280;--border:#e5e7eb;--bg:#f9fafb;--white:#fff;
  --shadow:0 2px 12px rgba(0,0,0,.08);--r:14px;
  --green:#10b981;--blue:#3b82f6;--purple:#8b5cf6;--red:#ef4444;--orange:#f97316;
  --hero:#4338ca;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text);font-size:15px;line-height:1.6}

/* HEADER */
.hdr{background:var(--white);border-bottom:1px solid var(--border);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.logo{font-weight:800;font-size:15px;color:var(--primary);text-decoration:none}
.logo em{color:var(--accent);font-style:normal}
.hdr-right{display:flex;gap:10px;align-items:center}
.btn-nav{font-size:12px;color:var(--muted);background:transparent;border:1px solid var(--border);padding:5px 12px;border-radius:99px;cursor:pointer;text-decoration:none;white-space:nowrap}
.btn-nav:hover{border-color:var(--primary);color:var(--primary)}

/* HERO */
.hero{background:var(--hero);padding:40px 20px 36px;text-align:center;color:#fff}
.hero-icon{font-size:52px;margin-bottom:14px;display:block}
.hero h1{font-size:26px;font-weight:800;margin-bottom:10px;line-height:1.2}
.hero p{font-size:15px;opacity:.85;max-width:500px;margin:0 auto 18px}
.hero-chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.hero-chip{font-size:12px;font-weight:600;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);color:#fff;padding:4px 12px;border-radius:99px}

/* MAIN */
.main{max-width:780px;margin:0 auto;padding:28px 14px 60px}

/* SECTION TITLE */
.sec-title{font-size:19px;font-weight:800;color:var(--primary);margin-bottom:16px}
.sec-sub{font-size:14px;color:var(--muted);margin-top:4px;margin-bottom:20px}

/* DIRECTION CARDS */
.dir-cards{display:flex;flex-direction:column;gap:14px;margin-bottom:40px}

.dir-card{background:var(--white);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden;border:2px solid transparent;transition:border-color .2s}
.dir-card:hover{border-color:var(--primary)}

.card-head{padding:18px 20px;cursor:pointer;display:flex;align-items:flex-start;gap:14px;user-select:none}
.card-emoji{font-size:26px;flex-shrink:0;width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:var(--bg);border-radius:10px}
.card-info{flex:1;min-width:0}
.card-title-row{display:flex;align-items:center;gap:8px;margin-bottom:5px;flex-wrap:wrap}
.card-title{font-size:16px;font-weight:800;color:var(--text);line-height:1.3}
.badge-new{font-size:10px;font-weight:700;background:var(--orange);color:#fff;padding:2px 7px;border-radius:99px;letter-spacing:.3px}
.card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px}
.cmeta{font-size:11px;font-weight:600;padding:2px 8px;border-radius:99px}
.cmeta-income{background:#d1fae5;color:#065f46}
.cmeta-time{background:#dbeafe;color:#1e40af}
.cmeta-risk-low{background:#d1fae5;color:#065f46}
.cmeta-risk-mid{background:var(--al);color:#92400e}
.card-desc-short{font-size:13px;color:var(--muted);line-height:1.5}
.card-toggle{margin-left:auto;flex-shrink:0;color:var(--muted);font-size:18px;transition:transform .25s;margin-top:4px}
.card-head[aria-expanded="true"] .card-toggle{transform:rotate(180deg)}

/* SCORE CIRCLE */
.score-circle{flex-shrink:0;width:56px;height:56px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;border:3px solid #d1d5db;background:#f3f4f6;color:var(--muted)}
.sc-gold{background:#fef9c3;border-color:#fbbf24;color:#713f12}
.sc-green{background:#dcfce7;border-color:#4ade80;color:#15803d}
.sc-blue{background:#dbeafe;border-color:#60a5fa;color:#1d4ed8}
.sc-yellow{background:var(--al);border-color:var(--accent);color:#92400e}
.sc-num{font-size:17px;line-height:1}
.sc-pct{font-size:9px;line-height:1.2}

/* CARD BODY */
.card-body{display:none;border-top:1px solid var(--border)}
.card-body.open{display:block}
.card-body-inner{padding:18px 20px}

/* STRENGTHS / BARRIERS */
.sb-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.sb-box{background:var(--bg);border-radius:10px;padding:12px 14px}
.sb-box h4{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px}
.sb-green h4{color:#059669}
.sb-orange h4{color:#c2410c}
.sb-item{font-size:13px;display:flex;gap:6px;align-items:flex-start;margin-bottom:5px;line-height:1.4}
.sb-item:last-child{margin-bottom:0}
.si-icon{flex-shrink:0;font-size:13px;margin-top:1px}

/* REQUIREMENTS */
.req-box{background:var(--pl);border-radius:10px;padding:12px 14px;margin-bottom:14px;font-size:13px;color:var(--text)}
.req-box strong{display:block;font-size:12px;font-weight:700;color:var(--primary);margin-bottom:4px}

/* TOOLS */
.tools-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.tool-tag{font-size:12px;background:var(--bg);border:1px solid var(--border);color:var(--text);padding:3px 10px;border-radius:6px;font-weight:500}

/* MATCH BARS */
.match-bars{margin-bottom:16px}
.mb-row{display:flex;align-items:center;gap:10px;margin-bottom:7px}
.mb-label{width:130px;font-size:12px;color:var(--muted);flex-shrink:0}
.mb-track{flex:1;height:6px;background:var(--bg);border-radius:99px;overflow:hidden;border:1px solid var(--border)}
.mb-fill{height:100%;border-radius:99px;transition:width 1s ease-out}
.fill-pm{background:var(--primary)}
.fill-rm{background:var(--blue)}
.fill-gm{background:var(--accent)}
.mb-val{font-size:11px;font-weight:700;width:28px;text-align:right;color:var(--muted)}

/* ROADMAP */
.roadmap-section{margin-bottom:16px}
.roadmap-toggle{display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--pl);border-radius:10px;cursor:pointer;border:none;width:100%;text-align:left;font-size:14px;font-weight:600;color:var(--primary)}
.roadmap-toggle svg{transition:transform .25s;flex-shrink:0}
.roadmap-toggle.open svg{transform:rotate(180deg)}
.roadmap-content{display:none;padding:16px 0 4px}
.roadmap-content.open{display:block}
.timeline{position:relative;padding-left:36px}
.timeline::before{content:'';position:absolute;left:12px;top:4px;bottom:4px;width:2px;background:var(--border)}
.tl-item{position:relative;margin-bottom:18px}
.tl-item:last-child{margin-bottom:0}
.tl-dot{position:absolute;left:-36px;top:1px;width:24px;height:24px;border-radius:50%;background:var(--hero);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center}
.tl-content strong{display:block;font-size:13px;font-weight:700;color:var(--text);margin-bottom:2px}
.tl-content p{font-size:13px;color:var(--muted);line-height:1.5}

/* INCOME INFO */
.income-row{display:flex;align-items:center;gap:12px;background:var(--bg);border-radius:10px;padding:12px 14px;margin-bottom:14px;flex-wrap:wrap}
.income-item{text-align:center}
.income-item .val{font-size:18px;font-weight:800;color:var(--primary)}
.income-item .lbl{font-size:11px;color:var(--muted);margin-top:1px}
.income-sep{color:var(--border);font-size:20px}

/* ACTIONS */
.card-actions{display:flex;gap:10px;margin-top:6px}
.btn-detail{flex:1;padding:11px;background:var(--hero);color:white;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;text-align:center;text-decoration:none;display:block}
.btn-detail:hover{opacity:.9}

/* COMPARISON TABLE */
.cmp-section{margin-bottom:40px}
.cmp-title{font-size:17px;font-weight:800;color:var(--primary);margin-bottom:14px}
.cmp-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.cmp-table{width:100%;border-collapse:collapse;min-width:560px;font-size:13px}
.cmp-table th{background:var(--hero);color:#fff;padding:10px 12px;text-align:center;font-size:12px;font-weight:700}
.cmp-table th:first-child{text-align:left}
.cmp-table td{padding:10px 12px;border-bottom:1px solid var(--border);text-align:center;vertical-align:middle}
.cmp-table td:first-child{text-align:left;font-weight:600;color:var(--text)}
.cmp-table tr:hover td{background:var(--pl)}
.cmp-table tr:last-child td{border-bottom:none}
.cmp-val{font-size:12px;font-weight:600}
.cmp-high{color:#059669}
.cmp-mid{color:#d97706}
.cmp-low{color:var(--muted)}
.star{color:#fbbf24}

/* GUIDE SECTION */
.guide-section{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #86efac;border-radius:var(--r);padding:22px 24px;margin-bottom:32px}
.guide-section h3{font-size:17px;font-weight:800;color:var(--primary);margin-bottom:12px}
.guide-items{display:flex;flex-direction:column;gap:10px}
.guide-item{display:flex;gap:12px;align-items:flex-start}
.guide-icon{font-size:18px;flex-shrink:0;margin-top:2px}
.guide-text strong{display:block;font-size:14px;font-weight:700;margin-bottom:2px}
.guide-text p{font-size:13px;color:var(--muted);line-height:1.4}

/* CTA BOTTOM */
.cta-bottom{background:var(--white);border-radius:var(--r);box-shadow:var(--shadow);padding:24px;text-align:center;margin-bottom:32px}
.cta-bottom h3{font-size:18px;font-weight:800;color:var(--primary);margin-bottom:8px}
.cta-bottom p{font-size:14px;color:var(--muted);margin-bottom:18px}
.cta-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.btn-primary{padding:12px 26px;background:var(--primary);color:#fff;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}
.btn-primary:hover{background:var(--pm)}
.btn-outline{padding:12px 22px;background:transparent;border:2px solid var(--primary);border-radius:12px;font-size:14px;font-weight:600;color:var(--primary);text-decoration:none;display:inline-block}
.btn-outline:hover{background:var(--pl)}

/* FOOTER */
.footer{background:var(--white);border-top:1px solid var(--border);padding:24px 20px;text-align:center}
.footer-links{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:12px}
.footer-links a{font-size:13px;color:var(--muted);text-decoration:none}
.footer-links a:hover{color:var(--primary)}
.footer-copy{font-size:12px;color:var(--muted)}

/* NO SCORE PLACEHOLDER */
.score-placeholder{flex-shrink:0;width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#f3f4f6;border:3px dashed #d1d5db;font-size:18px;color:var(--muted)}

@media(max-width:580px){
  .hero h1{font-size:20px}
  .sb-grid{grid-template-columns:1fr}
  .card-head{gap:10px}
  .income-row{justify-content:center}
  .cta-btns{flex-direction:column;align-items:center}
}
