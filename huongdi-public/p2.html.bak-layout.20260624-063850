// ═══ SCORING ═══
function computeScores() {
  const capScore = Math.min(100, Math.round(
    (S.capNow/100*40) + (S.capMax/200*30) + (S.capLoss/5*30)
  ));
  const expScore = Math.min(100, Math.round(
    (S.expYears/10*40) + (S.expMkt/5*30) + (S.expConf/5*30)
  ));
  const timeScore = Math.min(100, Math.round(
    (S.timeNow/40*50) + (S.timeSust/5*30) + (S.timeMax/60*20)
  ));
  const energyScore = Math.min(100, Math.round(
    ((S.enPhys + S.enMind + S.enRes) / 15 * 100)
  ));
  const netScore = Math.min(100, Math.round(
    (S.netSize*0.6) + (S.netMaint/5*40)
  ));
  const techScore = Math.min(100, Math.round(
    (S.tools.length/9*50) + (S.techLevel/5*50)
  ));
  const riskScore = S.riskMonths;
  const incomeScore = Math.min(100, Math.round(S.incIdeal/100*100));

  return { capScore, expScore, timeScore, energyScore, netScore, techScore, riskScore, incomeScore };
}

function getDirectionFeasibility(sc) {
  // Use max (flexible) capital and time for "possible" calculation
  const capAvail = Math.max(S.capNow, S.capMax * 0.5);
  const timeAvail = Math.max(S.timeNow, S.timeMax);
  const capNow = S.capNow;
  const timeNow = S.timeNow;

  return DIRECTIONS.map(d => {
    // NOW feasibility (current resources only)
    const nowFit = [
      capNow >= d.req.cap ? 1 : capNow / d.req.cap,
      sc.expScore >= d.req.exp ? 1 : sc.expScore / d.req.exp,
      timeNow >= d.req.time ? 1 : timeNow / d.req.time,
      sc.netScore >= d.req.net ? 1 : sc.netScore / d.req.net,
      sc.techScore >= d.req.tech ? 1 : sc.techScore / d.req.tech,
      sc.energyScore >= d.req.energy ? 1 : sc.energyScore / d.req.energy,
      sc.riskScore >= d.req.risk ? 1 : sc.riskScore / d.req.risk,
    ];
    const nowScore = Math.round(nowFit.reduce((a,b)=>a+b,0)/nowFit.length*100);

    // POTENTIAL feasibility (with mobilizable resources)
    const potFit = [
      capAvail >= d.req.cap ? 1 : capAvail / d.req.cap,
      sc.expScore >= d.req.exp ? 1 : sc.expScore / d.req.exp,
      timeAvail >= d.req.time ? 1 : timeAvail / d.req.time,
      sc.netScore >= d.req.net ? 1 : sc.netScore / d.req.net,
      sc.techScore >= d.req.tech ? 1 : sc.techScore / d.req.tech,
      sc.energyScore >= d.req.energy ? 1 : sc.energyScore / d.req.energy,
      sc.riskScore >= d.req.risk ? 1 : sc.riskScore / d.req.risk,
    ];
    const potScore = Math.round(potFit.reduce((a,b)=>a+b,0)/potFit.length*100);

    // Income compatibility
    const incomeOk = d.maxInc >= S.incMin;

    // Status
    let status = 'later', badge = '❌', badgeCls = 'badge-later';
    if (nowScore >= 75 && incomeOk) { status='now'; badge='✅ Ngay bây giờ'; badgeCls='badge-now'; }
    else if (potScore >= 70 && incomeOk) { status='soon'; badge='⏳ Với tối đa'; badgeCls='badge-soon'; }

    // Why not
    let reason = '';
    if (status !== 'now') {
      const gaps = [];
      if (capNow < d.req.cap) gaps.push(`vốn cần ${d.req.cap}M`);
      if (sc.expScore < d.req.exp) gaps.push('cần kinh nghiệm hơn');
      if (timeNow < d.req.time) gaps.push(`cần ${d.req.time}h/tuần`);
      if (sc.netScore < d.req.net) gaps.push('cần mạng lưới hơn');
      reason = gaps.slice(0,2).join(', ');
    }

    return { ...d, nowScore, potScore, status, badge, badgeCls, reason, incomeOk };
  }).sort((a,b) => b.nowScore - a.nowScore);
}

