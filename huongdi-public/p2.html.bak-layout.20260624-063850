<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
:root {
  --primary:#1a6b4a;--primary-light:#e8f5ee;--primary-mid:#2e8b63;
  --accent:#f59e0b;--accent-light:#fef3c7;
  --text:#1a202c;--muted:#6b7280;--border:#e5e7eb;--bg:#f9fafb;--white:#fff;
  --shadow:0 2px 12px rgba(0,0,0,.08);--radius:14px;
  --green:#10b981;--yellow:#f59e0b;--red:#ef4444;--blue:#3b82f6;--purple:#8b5cf6;--cyan:#06b6d4;--orange:#f97316;--teal:#14b8a6;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text);font-size:16px;line-height:1.6}

/* HEADER */
.hdr{background:var(--white);border-bottom:1px solid var(--border);padding:13px 20px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:200}
.logo{font-weight:800;font-size:15px;color:var(--primary);text-decoration:none;flex-shrink:0}
.logo span{color:var(--accent)}
.prog-wrap{flex:1;max-width:240px}
.prog-lbl{font-size:11px;color:var(--muted);text-align:right;margin-bottom:3px}
.prog-track{height:5px;background:var(--border);border-radius:99px;overflow:hidden}
.prog-fill{height:100%;background:var(--accent);border-radius:99px;transition:width .4s}

/* SCREENS */
.screen{display:none}.screen.active{display:block}

/* WELCOME */
.welcome{max-width:620px;margin:0 auto;padding:36px 20px}
.p1-badge{background:var(--primary-light);border:1px solid #86efac;border-radius:var(--radius);padding:14px 18px;margin-bottom:22px;display:flex;align-items:center;gap:12px}
.p1-badge .ico{font-size:22px}
.p1-badge strong{display:block;font-size:15px;color:var(--primary)}
.p1-badge p{font-size:13px;color:var(--muted)}
.welcome h1{font-size:26px;font-weight:800;color:var(--primary);margin-bottom:8px}
.welcome h1 em{color:var(--accent);font-style:normal}
.welcome .sub{font-size:15px;color:var(--muted);margin-bottom:24px}
.why-box{background:var(--white);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);margin-bottom:22px}
.why-box h3{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:12px}
.why-item{display:flex;gap:10px;margin-bottom:8px;font-size:14px;align-items:flex-start}
.why-item:last-child{margin-bottom:0}
.why-item .ck{color:var(--green);font-size:16px;flex-shrink:0;margin-top:1px}
.sci-note{background:var(--accent-light);border-left:3px solid var(--accent);border-radius:0 var(--radius) var(--radius) 0;padding:13px 16px;font-size:13px;color:#92400e;margin-bottom:24px}
.btn-start{width:100%;padding:17px;background:var(--accent);color:var(--white);border:none;border-radius:var(--radius);font-size:17px;font-weight:700;cursor:pointer}
.btn-start:hover{background:#d97706}

/* ═══ CANVAS LAYOUT ═══ */
.canvas-wrap{display:grid;grid-template-columns:1fr 340px;gap:20px;max-width:1060px;margin:0 auto;padding:20px 16px 60px;align-items:start}
@media(max-width:800px){.canvas-wrap{grid-template-columns:1fr}}

/* LEFT: CONTROLS */
.controls{}
.section-card{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:16px;overflow:hidden}
.sec-header{display:flex;align-items:center;gap:10px;padding:16px 20px;cursor:pointer;user-select:none;border-bottom:1px solid transparent;transition:border-color .2s}
.sec-header.open{border-bottom-color:var(--border)}
.sec-icon{font-size:22px;width:32px;flex-shrink:0}
.sec-title{flex:1}
.sec-title h3{font-size:16px;font-weight:700;color:var(--text)}
.sec-title p{font-size:12px;color:var(--muted)}
.sec-status{font-size:12px;font-weight:600;padding:3px 10px;border-radius:99px}
.status-done{background:#dcfce7;color:#166534}
.status-todo{background:var(--border);color:var(--muted)}
.sec-chevron{font-size:18px;color:var(--muted);transition:transform .25s}
.sec-header.open .sec-chevron{transform:rotate(180deg)}
.sec-body{display:none;padding:20px}
.sec-body.open{display:block}

/* RESOURCE ROW */
.res-row{margin-bottom:20px}
.res-row:last-child{margin-bottom:0}
.res-label{font-size:14px;font-weight:600;color:var(--text);margin-bottom:6px;display:flex;justify-content:space-between;align-items:center}
.res-label span{font-size:13px;font-weight:400;color:var(--muted)}

/* SLIDERS */
.slider-wrap{position:relative;margin-bottom:6px}
input[type=range]{width:100%;-webkit-appearance:none;height:6px;border-radius:99px;background:var(--border);outline:none;cursor:pointer}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:var(--primary);border:3px solid white;box-shadow:0 1px 4px rgba(0,0,0,.2);cursor:pointer}
input[type=range].accent-slider::-webkit-slider-thumb{background:var(--accent)}
.range-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:3px}
.dual-range{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.dual-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
.now-lbl{color:var(--primary)}
.max-lbl{color:var(--accent)}
.val-display{font-size:18px;font-weight:800;color:var(--primary);margin-bottom:2px}
.val-display.accent{color:var(--accent)}

/* STAR RATING */
.star-row{display:flex;gap:6px;margin-top:6px}
.star{font-size:24px;cursor:pointer;color:#d1d5db;transition:color .15s;line-height:1}
.star.on{color:var(--accent)}
.star-hint{font-size:12px;color:var(--muted);margin-top:4px;min-height:16px}

/* TOOL CHECKBOXES */
.tool-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.tool-chip{padding:6px 14px;border:2px solid var(--border);border-radius:99px;font-size:13px;cursor:pointer;color:var(--muted);transition:all .15s;user-select:none}
.tool-chip.on{border-color:var(--primary);background:var(--primary-light);color:var(--primary);font-weight:600}

/* MONTH PILLS */
.month-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.mpill{padding:8px 16px;border:2px solid var(--border);border-radius:99px;font-size:14px;cursor:pointer;color:var(--muted);transition:all .15s}
.mpill.on{border-color:var(--primary);background:var(--primary);color:white;font-weight:700}

/* INCOME SLIDERS */
.income-dual{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:6px}

/* ENERGY TRIO */
.energy-trio{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.e-item p{font-size:13px;color:var(--muted);margin-bottom:4px}

/* ═══ RIGHT: LIVE BỨC TRANH ═══ */
.picture-panel{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);position:sticky;top:73px}
.picture-hdr{background:linear-gradient(135deg,var(--primary),var(--primary-mid));border-radius:var(--radius) var(--radius) 0 0;padding:16px 20px;color:white}
.picture-hdr h3{font-size:15px;font-weight:800;margin-bottom:2px}
.picture-hdr p{font-size:12px;opacity:.8}
.picture-body{padding:16px 18px}

/* Resource mini bars */
.mini-bars{margin-bottom:18px}
.mini-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.mini-icon{font-size:14px;width:20px;flex-shrink:0}
.mini-label{font-size:12px;width:90px;flex-shrink:0;color:var(--muted)}
.mini-bar-wrap{flex:1;height:7px;background:var(--border);border-radius:99px;overflow:hidden}
.mini-fill{height:100%;border-radius:99px;transition:width .5s ease-out}
.mini-val{font-size:12px;font-weight:700;width:28px;text-align:right}

/* Assets & Constraints */
.ac-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.ac-box{border-radius:10px;padding:12px}
.ac-box.asset{background:#f0fdf4}
.ac-box.constraint{background:#fff1f2}
.ac-box h4{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
.ac-box.asset h4{color:#166534}
.ac-box.constraint h4{color:#be123c}
.ac-tag{font-size:13px;font-weight:600;display:block;margin-bottom:3px}
.ac-tag:last-child{margin-bottom:0}
.ac-box.asset .ac-tag{color:#15803d}
.ac-box.constraint .ac-tag{color:#dc2626}

/* Directions */
.dir-section h4{font-size:13px;font-weight:700;color:var(--text);margin-bottom:10px}
.dir-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;margin-bottom:6px;background:var(--bg)}
.dir-icon{font-size:16px;flex-shrink:0}
.dir-info{flex:1;min-width:0}
.dir-name{font-size:13px;font-weight:600;color:var(--text)}
.dir-reason{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dir-badge{font-size:12px;font-weight:700;padding:3px 8px;border-radius:6px;flex-shrink:0}
.badge-now{background:#dcfce7;color:#166534}
.badge-soon{background:#fef3c7;color:#92400e}
.badge-later{background:#fee2e2;color:#991b1b}

/* Income target display */
.income-display{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-radius:10px;padding:12px;margin-bottom:14px;display:flex;gap:16px}
.income-box{flex:1;text-align:center}
.income-box .lbl{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
.income-box .val{font-size:16px;font-weight:800;color:var(--primary)}

/* Save button */
.btn-save{width:100%;padding:14px;background:var(--primary);color:var(--white);border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;margin-top:16px}
.btn-save:hover{background:var(--primary-mid)}

/* RESULTS */
.results{max-width:700px;margin:0 auto;padding:32px 16px 60px}
.res-h1{font-size:24px;font-weight:800;color:var(--primary);margin-bottom:6px}
.res-sub{font-size:15px;color:var(--muted);margin-bottom:24px}
.dna-card{background:var(--white);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow);margin-bottom:18px}
.dna-card h3{font-size:16px;font-weight:700;color:var(--primary);margin-bottom:18px}
.dna-row{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.dna-row:last-child{margin-bottom:0}
.dna-icon{font-size:18px;width:26px;flex-shrink:0}
.dna-lbl{width:130px;font-size:14px;font-weight:600;flex-shrink:0}
.dna-bar-wrap{flex:1;height:10px;background:var(--border);border-radius:99px;overflow:hidden}
.dna-fill{height:100%;border-radius:99px;transition:width 1.2s ease-out}
.dna-val{width:32px;text-align:right;font-size:13px;font-weight:700}
.dna-tag{font-size:11px;padding:2px 8px;border-radius:99px;font-weight:600;margin-left:4px;flex-shrink:0}
.t-asset{background:#dcfce7;color:#166534}
.t-mid{background:#fef3c7;color:#92400e}
.t-constraint{background:#fee2e2;color:#991b1b}

.primary-card{background:linear-gradient(135deg,var(--primary),var(--primary-mid));color:white;border-radius:var(--radius);padding:22px;margin-bottom:18px}
.primary-card .role{font-size:12px;font-weight:600;opacity:.75;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.primary-card h2{font-size:22px;font-weight:800;margin-bottom:8px}
.primary-card p{font-size:14px;opacity:.9;line-height:1.7}

.insight-card{background:var(--white);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
.insight-card h3{font-size:16px;font-weight:700;color:var(--primary);margin-bottom:14px}
.insight-row{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
.insight-row:last-child{border-bottom:none;padding-bottom:0}
.insight-ico{font-size:22px;flex-shrink:0}
.insight-row h4{font-size:15px;font-weight:700;margin-bottom:3px}
.insight-row p{font-size:14px;color:var(--muted);line-height:1.6}

.direction-result-card{background:var(--white);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
.direction-result-card h3{font-size:16px;font-weight:700;color:var(--primary);margin-bottom:14px}
.dr-item{border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px;display:flex;gap:12px;align-items:flex-start}
.dr-item:last-child{margin-bottom:0}
.dr-left{flex:1}
.dr-name{font-size:16px;font-weight:700;margin-bottom:3px}
.dr-meta{font-size:13px;color:var(--muted)}
.dr-right{text-align:right;flex-shrink:0}
.dr-score{font-size:22px;font-weight:800;color:var(--primary)}
.dr-badge{font-size:11px;font-weight:600;padding:3px 8px;border-radius:6px}

.bridge-card{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #86efac;border-radius:var(--radius);padding:24px;margin-bottom:18px;text-align:center}
.bridge-card h3{font-size:20px;font-weight:800;color:var(--primary);margin-bottom:8px}
.bridge-card p{font-size:15px;color:var(--muted);margin-bottom:18px}
.btn-p3{display:inline-block;padding:15px 36px;background:var(--primary);color:white;border:none;border-radius:var(--radius);font-size:16px;font-weight:700;cursor:pointer;text-decoration:none}

.sci-footer{background:var(--white);border-radius:var(--radius);padding:18px;font-size:12px;color:var(--muted);line-height:1.8;margin-top:18px}
.sci-footer strong{color:var(--primary)}
