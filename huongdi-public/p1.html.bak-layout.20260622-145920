// ═══════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════
let cur = 0;
const ANS = {}; // { qIndex: value }  value: 1-5 for Likert, 0-3 for support
const TOTAL = QS.length;

// ═══════════════════════════════════════════════════
// SCORING
// ═══════════════════════════════════════════════════
function score() {
  // Core: Q0-15 (Likert 1-5)
  // Formula from spec: Score = sum(q1..q4) / 20 * 100
  const groups = {people:[0,1,2,3], expert:[4,5,6,7], builder:[8,9,10,11], independent:[12,13,14,15]};
  const sc = {};
  Object.entries(groups).forEach(([dim, idxs]) => {
    const vals = idxs.map(i => ANS[i] || 3); // default 3 if unanswered
    const sum = vals.reduce((a,b)=>a+b,0);
    sc[dim] = Math.round(sum / 20 * 100);
  });
  return sc;
}

function rankScores(sc) {
  return Object.entries(sc).sort((a,b)=>b[1]-a[1]).map(e=>e[0]);
}

function confidence(sc) {
  const vals = Object.values(sc).sort((a,b)=>b-a);
  const spread = vals[0] - vals[vals.length-1];
  if (spread >= 35) return {level:'High', label:'Cao', cls:'conf-high'};
  if (spread >= 20) return {level:'Medium', label:'Trung bình', cls:'conf-mid'};
  return {level:'Low', label:'Cân bằng', cls:'conf-low'};
}

// ═══════════════════════════════════════════════════
// RENDER QUESTION
// ═══════════════════════════════════════════════════
const LIKERT_LABELS = ['Rất không giống','Không giống','Trung lập','Giống tôi','Rất giống tôi'];
const LIKERT_EMOJI = ['😕','🤔','😐','🙂','😊'];

function showQ(idx) {
  cur = idx;
  const q = QS[idx];
  document.getElementById('qDimTag').textContent = q.dimLabel;
  document.getElementById('qNum').textContent = 'Câu ' + (idx+1) + ' / ' + TOTAL;
  document.getElementById('qStmt').textContent = q.stmt;
  document.getElementById('qHint').textContent = q.hint || '';

  const body = document.getElementById('qBody');

  if (!q.type) {
    // Likert
    const curVal = ANS[idx];
    body.innerHTML = `<div class="likert" id="likertRow"></div>`;
    const row = document.getElementById('likertRow');
    for (let v=1; v<=5; v++) {
      const btn = document.createElement('div');
      btn.className = 'lk-btn' + (curVal===v?' sel':'');
      btn.innerHTML = `<span class="lk-emoji">${LIKERT_EMOJI[v-1]}</span><span class="lk-num">${v}</span><span class="lk-lbl">${LIKERT_LABELS[v-1]}</span>`;
      btn.onclick = () => pickLikert(v);
      row.appendChild(btn);
    }
  } else {
    // Support choice
    const curVal = ANS[idx];
    body.innerHTML = `<div class="supp-opts" id="suppOpts"></div>`;
    const wrap = document.getElementById('suppOpts');
    q.opts.forEach((opt, i) => {
      const div = document.createElement('div');
      div.className = 'supp-opt' + (curVal===i?' sel':'');
      div.innerHTML = `<span class="ol">${['A','B','C','D'][i]}</span><span>${opt}</span>`;
      div.onclick = () => pickSupp(i);
      wrap.appendChild(div);
    });
  }

  document.getElementById('btnNext').disabled = ANS[idx] === undefined;
  document.getElementById('btnBack').style.display = idx === 0 ? 'none' : '';
  show('s-q');
  updateProg();
}

function pickLikert(v) {
  ANS[cur] = v;
  document.querySelectorAll('.lk-btn').forEach((b,i) => b.classList.toggle('sel', i===v-1));
  document.getElementById('btnNext').disabled = false;
  updateProg();
}

function pickSupp(i) {
  ANS[cur] = i;
  document.querySelectorAll('.supp-opt').forEach((b,j) => b.classList.toggle('sel', j===i));
  document.getElementById('btnNext').disabled = false;
  updateProg();
}

function goNext() {
  const next = cur + 1;
  // Block summaries after each group
  if (cur === 3) { showBlockSum(1); return; }
  if (cur === 7) { showBlockSum(2); return; }
  if (cur === 11) { showBlockSum(3); return; }
  if (cur === 15) { show('s-supp-intro'); return; }
  if (next >= TOTAL) { computeAndRender(); return; }
  showQ(next);
}

function goBack() {
  if (cur === 0) return;
  showQ(cur - 1);
}

// Block summaries
const SUM_INSIGHTS = {
  1: (sc) => {
    const v = sc.people;
    if (v >= 70) return `Điểm Kết Nối của bạn <strong>cao (${v}/100)</strong> — bạn tự nhiên tạo ra năng lượng qua con người. Đây là tài sản đặc biệt có thể chuyển hóa thành giá trị kinh doanh thực sự.`;
    if (v >= 45) return `Điểm Kết Nối của bạn <strong>trung bình (${v}/100)</strong> — bạn thoải mái với con người nhưng đây không phải nguồn năng lượng chính của bạn.`;
    return `Điểm Kết Nối của bạn <strong>thấp hơn (${v}/100)</strong> — bạn không cần con người liên tục để có năng lượng. Đây không phải điểm yếu — nhiều hướng đi thành công nhất không đòi hỏi nhiều tương tác xã hội.`;
  },
  2: (sc) => {
    const v = sc.expert;
    if (v >= 70) return `Điểm Chuyên Môn của bạn <strong>cao (${v}/100)</strong> — 20+ năm kinh nghiệm đang là tài sản thực sự. Người khác sẵn sàng trả tiền để tiếp cận kiến thức này nếu bạn biết cách đóng gói.`;
    if (v >= 45) return `Điểm Chuyên Môn của bạn <strong>trung bình (${v}/100)</strong> — bạn có kiến thức thực tế nhưng chưa thấy mình là "chuyên gia" theo nghĩa truyền thống. Điều thú vị: thị trường thường đánh giá kinh nghiệm thực chiến cao hơn bằng cấp.`;
    return `Điểm Chuyên Môn của bạn <strong>thấp hơn (${v}/100)</strong> — bạn không cảm thấy "mạnh" ở chiều sâu kiến thức. Không sao — nhiều hướng đi phù hợp hơn với điểm mạnh khác của bạn.`;
  },
  3: (sc) => {
    const v = sc.builder;
    if (v >= 70) return `Điểm Xây Dựng của bạn <strong>cao (${v}/100)</strong> — bạn có tư duy của người tạo ra tài sản dài hạn. Đây là điều hiếm và quý giá trong bối cảnh mọi người muốn kết quả ngay lập tức.`;
    if (v >= 45) return `Điểm Xây Dựng của bạn <strong>trung bình (${v}/100)</strong> — bạn có thể build nếu cần nhưng đây không phải động lực tự nhiên nhất của bạn.`;
    return `Điểm Xây Dựng của bạn <strong>thấp hơn (${v}/100)</strong> — bạn không tự nhiên nghĩ đến việc xây dựng hệ thống hay tài sản dài hạn. Bạn thích kết quả có thể thấy nhanh hơn.`;
  },
};

function showBlockSum(blk) {
  const sc = score();
  const id = 's-sum' + blk;
  const boxId = 'sum' + blk + 'box';
  const insight = SUM_INSIGHTS[blk] ? SUM_INSIGHTS[blk](sc) : '';
  const box = document.getElementById(boxId);
  if (box) box.innerHTML = `<p>${insight}</p>`;
  show(id);
  updateProg();
}

// ═══════════════════════════════════════════════════
// COMPUTE & RENDER RESULTS
// ═══════════════════════════════════════════════════
const DIM_META = {
  people:      {icon:'🤝', label:'Kết Nối',   color:'#3b82f6'},
  expert:      {icon:'🧠', label:'Chuyên Môn', color:'#10b981'},
  builder:     {icon:'🏗️', label:'Xây Dựng',  color:'#f59e0b'},
  independent: {icon:'🦅', label:'Tự Chủ',    color:'#8b5cf6'},
};
const POS_NAMES = ['Primary DNA','Secondary DNA','Supporting DNA','Weak DNA'];
const POS_CLS = ['pos-1','pos-2','pos-3','pos-4'];

function computeAndRender() {
  const sc = score();
  const rank = rankScores(sc);
  const conf = confidence(sc);
  const p = rank[0], s = rank[1];
  const key = p + '_' + s;
  const matrix = DNA_MATRIX[key] || DNA_MATRIX['expert_independent'];

  // Support answer context
  const suppCtx = {};
  [{idx:16,key:'praise'},{idx:17,key:'approach'},{idx:18,key:'drain'},{idx:19,key:'ideal'}].forEach(q=>{
    suppCtx[q.key] = ANS[q.idx];
  });

  // DNA card
  document.getElementById('dnaTitle').textContent = matrix.title;
  const dnaRow = document.getElementById('dnaRow');
  dnaRow.innerHTML = '';
  rank.forEach((dim,i) => {
    const tag = document.createElement('span');
    tag.className = 'dna-tag' + (i===0?' primary':'');
    tag.textContent = DIM_META[dim].label + ' (' + sc[dim] + ')';
    dnaRow.appendChild(tag);
  });
  const confEl = document.getElementById('confBadge');
  confEl.innerHTML = `<span class="conf-badge ${conf.cls}">Độ tin cậy: ${conf.label}</span>`;

  document.getElementById('resSub').textContent =
    'DNA chính: ' + DIM_META[p].label + ' → ' + DIM_META[s].label +
    ' → ' + DIM_META[rank[2]].label + ' → ' + DIM_META[rank[3]].label;

  // Score rows
  const scoreEl = document.getElementById('scoreRows');
  scoreEl.innerHTML = '';
  rank.forEach((dim,i) => {
    const m = DIM_META[dim];
    const row = document.createElement('div');
    row.className = 'sc-row';
    row.innerHTML = `
      <span class="sc-icon">${m.icon}</span>
      <span class="sc-lbl">${m.label}</span>
      <div class="sc-track"><div class="sc-fill" style="width:0%;background:${m.color}" data-val="${sc[dim]}"></div></div>
      <span class="sc-val" style="color:${m.color}">${sc[dim]}</span>
      <span class="dna-pos ${POS_CLS[i]}">${POS_NAMES[i]}</span>`;
    scoreEl.appendChild(row);
  });

  // Narrative
  const narEl = document.getElementById('narrativeText');
  narEl.innerHTML = `<p>${matrix.desc}</p><p>${matrix.desc2}</p>`;

  // Strengths
  const strEl = document.getElementById('strengthList');
  strEl.innerHTML = matrix.strengths.map(s => `<div class="sd-item">✅ ${s}</div>`).join('');

  // Drains (combine matrix + support Q18)
  const drainEl = document.getElementById('drainList');
  let drains = [...matrix.drains];
  drainEl.innerHTML = drains.map(d => `<div class="sd-item">⚡ ${d}</div>`).join('');

  // Income models
  const modelEl = document.getElementById('modelList');
  modelEl.innerHTML = matrix.models.map(m => `
    <div class="model-row">
      <span class="model-fit ${m.fit==='high'?'fit-high':'fit-mid'}">${m.fit==='high'?'✅ Rất phù hợp':'⚡ Có thể phù hợp'}</span>
      <div><div class="model-name">${m.name}</div><div class="model-why">${m.why}</div></div>
    </div>`).join('');

  // API output to localStorage
  try {
    // Normalize P1 scores 20-100 → 0-100 for P3 Matching Engine
    const scNorm = {};
    Object.entries(sc).forEach(([k,v]) => {
      scNorm[k] = Math.round(Math.max(0, Math.min(100, (v - 20) / 80 * 100)));
    });
    const output = {
      scores: sc,
      scores_normalized: scNorm,
      ranking: rank,
      dna: {primary: p, secondary: s, supporting: rank[2], weak: rank[3]},
      title: matrix.title,
      strengths: matrix.strengths,
      drains: matrix.drains,
      income_models: matrix.models.map(m=>m.name),
      confidence: conf.level,
      support: suppCtx,
      date: new Date().toISOString(),
      p1Rank: rank, p1: sc,
    };
    localStorage.setItem('p1_result', JSON.stringify(output));
  } catch(e){}

  show('s-results');
  updateProg(true);

  setTimeout(() => {
    document.querySelectorAll('.sc-fill').forEach(el => {
      el.style.width = el.dataset.val + '%';
    });
  }, 350);
}

// ═══════════════════════════════════════════════════
// UTILS
// ═══════════════════════════════════════════════════
function show(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}

function updateProg(done) {
  const filled = Object.keys(ANS).filter(k => k < 20).length;
  const pct = done ? 100 : Math.round(filled / TOTAL * 100);
  document.getElementById('progFill').style.width = pct + '%';
  document.getElementById('progLbl').textContent = done ? 'Hoàn thành!' : `Câu ${filled} / ${TOTAL}`;
}

function retake() {
  Object.keys(ANS).forEach(k => delete ANS[k]);
  cur = 0;
  updateProg();
  show('s-welcome');
}

function copyResult() {
  try {
    const r = JSON.parse(localStorage.getItem('p1_result') || '{}');
    if (!r.scores) { alert('Chưa có kết quả.'); return; }
    const dim = {people:'Kết Nối',expert:'Chuyên Môn',builder:'Xây Dựng',independent:'Tự Chủ'};
    const lines = r.ranking.map((k,i) => ['Primary','Secondary','Supporting','Weak'][i]+': '+dim[k]+' ('+r.scores[k]+')').join('\n');
    const text = `DNA Hướng Đi — Huongdi.sol.vn\n\n${r.title}\n\n${lines}\n\nĐộ tin cậy: ${r.confidence}\nMô hình phù hợp: ${(r.income_models||[]).join(', ')}\n\nTìm hướng đi phù hợp: https://huongdi.sol.vn`;
    navigator.clipboard.writeText(text).then(()=>alert('Đã sao chép!'));
  } catch(e){ alert('Không thể sao chép. Vui lòng chụp màn hình.'); }
}
