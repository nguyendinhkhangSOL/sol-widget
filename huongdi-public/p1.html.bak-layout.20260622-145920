<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Khám Phá Bản Thân — Huongdi.sol.vn</title>
<style>
:root{
  --primary:#1a6b4a;--pm:#2e8b63;--pl:#e8f5ee;
  --accent:#f59e0b;--al:#fef3c7;
  --text:#1a202c;--muted:#6b7280;--border:#e5e7eb;--bg:#f9fafb;--white:#fff;
  --shadow:0 2px 12px rgba(0,0,0,.08);--r:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text);font-size:16px;line-height:1.6;min-height:100vh}

/* HEADER */
.hdr{background:var(--white);border-bottom:1px solid var(--border);padding:13px 20px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:100}
.logo{font-weight:800;font-size:15px;color:var(--primary);text-decoration:none;flex-shrink:0}
.logo em{color:var(--accent);font-style:normal}
.prog-wrap{flex:1;max-width:240px}
.prog-lbl{font-size:11px;color:var(--muted);text-align:right;margin-bottom:3px}
.prog-bar{height:5px;background:var(--border);border-radius:99px;overflow:hidden}
.prog-fill{height:100%;background:var(--primary);border-radius:99px;transition:width .4s}

/* SCREENS */
.screen{display:none}.screen.active{display:block}

/* WELCOME */
.welcome{max-width:600px;margin:0 auto;padding:40px 20px}
.welcome h1{font-size:26px;font-weight:800;color:var(--primary);margin-bottom:8px}
.welcome h1 em{color:var(--accent);font-style:normal}
.welcome .sub{font-size:15px;color:var(--muted);margin-bottom:24px}
.badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}
.badge{background:var(--pl);color:var(--primary);font-size:13px;font-weight:600;padding:5px 14px;border-radius:99px}
.info-card{background:var(--white);border-radius:var(--r);padding:20px;box-shadow:var(--shadow);margin-bottom:20px}
.info-card h3{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:12px}
.block-row{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.block-row:last-child{margin-bottom:0}
.bnum{width:34px;height:34px;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex-shrink:0}
.block-row .txt strong{display:block;font-size:15px}
.block-row .txt span{font-size:13px;color:var(--muted)}
.sci-note{background:var(--al);border-left:3px solid var(--accent);border-radius:0 var(--r) var(--r) 0;padding:13px 16px;font-size:13px;color:#92400e;margin-bottom:24px}
.btn-start{width:100%;padding:17px;background:var(--primary);color:white;border:none;border-radius:var(--r);font-size:17px;font-weight:700;cursor:pointer;transition:background .2s}
.btn-start:hover{background:var(--pm)}

/* BLOCK INTRO */
.block-intro{max-width:600px;margin:0 auto;padding:40px 20px;text-align:center}
.bi-icon{width:72px;height:72px;background:var(--pl);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 18px}
.block-intro h2{font-size:22px;font-weight:800;color:var(--primary);margin-bottom:8px}
.block-intro p{font-size:15px;color:var(--muted);margin-bottom:6px}
.block-intro .sci{font-size:13px;color:var(--muted);font-style:italic;margin-bottom:28px}
.btn-go{padding:15px 40px;background:var(--primary);color:white;border:none;border-radius:var(--r);font-size:16px;font-weight:700;cursor:pointer}
.btn-go:hover{background:var(--pm)}

/* QUESTION */
.q-wrap{max-width:600px;margin:0 auto;padding:24px 16px}
.q-dim-tag{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--primary);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.q-dim-tag .dot{width:8px;height:8px;border-radius:50%;background:var(--primary);display:inline-block}
.q-card{background:var(--white);border-radius:var(--r);padding:24px;box-shadow:var(--shadow);margin-bottom:14px}
.q-num{font-size:12px;color:var(--muted);margin-bottom:8px}
.q-stmt{font-size:19px;font-weight:700;line-height:1.4;color:var(--text);margin-bottom:8px}
.q-hint{font-size:14px;color:var(--muted);line-height:1.5}
/* Likert */
.likert{display:flex;gap:8px;margin-top:4px}
.lk-btn{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;
  padding:12px 4px;border:2px solid var(--border);border-radius:12px;
  cursor:pointer;transition:all .18s;background:var(--white);
}
.lk-btn:hover{border-color:var(--primary);background:var(--pl)}
.lk-btn.sel{border-color:var(--primary);background:var(--pl)}
.lk-num{font-size:18px;font-weight:800;color:var(--muted);transition:color .18s}
.lk-btn.sel .lk-num{color:var(--primary)}
.lk-lbl{font-size:10px;color:var(--muted);text-align:center;line-height:1.2}
.lk-emoji{font-size:18px}
/* Support Q options */
.supp-opts{display:flex;flex-direction:column;gap:10px}
.supp-opt{
  background:var(--white);border:2px solid var(--border);border-radius:12px;
  padding:14px 16px;cursor:pointer;display:flex;align-items:center;gap:12px;
  font-size:15px;transition:all .18s;
}
.supp-opt:hover{border-color:var(--primary);background:var(--pl)}
.supp-opt.sel{border-color:var(--primary);background:var(--pl)}
.supp-opt .ol{min-width:26px;height:26px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--muted);transition:all .18s}
.supp-opt.sel .ol{background:var(--primary);border-color:var(--primary);color:white}
/* nav */
.q-nav{display:flex;gap:10px;margin-top:10px}
.btn-back{padding:13px 22px;background:transparent;border:2px solid var(--border);border-radius:12px;font-size:15px;color:var(--muted);cursor:pointer}
.btn-next{flex:1;padding:13px;background:var(--primary);color:white;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;transition:background .2s}
.btn-next:disabled{background:#9ca3af;cursor:not-allowed}
.btn-next:not(:disabled):hover{background:var(--pm)}

/* BLOCK SUMMARY */
.blk-sum{max-width:600px;margin:0 auto;padding:40px 20px;text-align:center}
.blk-sum .icon{font-size:48px;margin-bottom:14px}
.blk-sum h2{font-size:22px;font-weight:800;color:var(--primary);margin-bottom:12px}
.blk-sum .insight-box{background:var(--white);border-radius:var(--r);padding:20px;box-shadow:var(--shadow);margin-bottom:24px;text-align:left}
.blk-sum .insight-box p{font-size:15px;line-height:1.8;color:var(--text)}
.mini-bars-wrap{margin-bottom:20px}
.mb-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.mb-lbl{width:110px;font-size:13px;font-weight:600;color:var(--text);flex-shrink:0}
.mb-track{flex:1;height:7px;background:var(--border);border-radius:99px;overflow:hidden}
.mb-fill{height:100%;border-radius:99px;transition:width .8s ease-out}
.mb-val{font-size:13px;font-weight:700;width:28px;text-align:right}

/* RESULTS */
.results{max-width:680px;margin:0 auto;padding:32px 16px 60px}
.res-h1{font-size:26px;font-weight:800;color:var(--primary);margin-bottom:6px}
.res-sub{font-size:15px;color:var(--muted);margin-bottom:24px}

.dna-card{background:linear-gradient(135deg,var(--primary),var(--pm));color:white;border-radius:var(--r);padding:24px;margin-bottom:20px}
.dna-card .role{font-size:12px;font-weight:600;opacity:.75;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.dna-card h2{font-size:24px;font-weight:800;margin-bottom:10px}
.dna-card .dna-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.dna-tag{background:rgba(255,255,255,.2);padding:4px 12px;border-radius:99px;font-size:13px;font-weight:600}
.dna-tag.primary{background:rgba(255,255,255,.4)}
.conf-badge{display:inline-block;padding:4px 12px;border-radius:99px;font-size:12px;font-weight:700}
.conf-high{background:#dcfce7;color:#166534}
.conf-mid{background:var(--al);color:#92400e}
.conf-low{background:#f3f4f6;color:#6b7280}

.score-card{background:var(--white);border-radius:var(--r);padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
.score-card h3{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:16px}
.sc-row{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.sc-row:last-child{margin-bottom:0}
.sc-icon{font-size:18px;width:26px;flex-shrink:0}
.sc-lbl{width:120px;font-size:14px;font-weight:600;flex-shrink:0}
.sc-track{flex:1;height:10px;background:var(--border);border-radius:99px;overflow:hidden}
.sc-fill{height:100%;border-radius:99px;transition:width 1.2s ease-out}
.sc-val{width:32px;text-align:right;font-size:13px;font-weight:800}
.dna-pos{font-size:11px;padding:2px 8px;border-radius:99px;font-weight:700;margin-left:4px;flex-shrink:0}
.pos-1{background:#fef08a;color:#713f12}
.pos-2{background:#e0f2fe;color:#075985}
.pos-3{background:#f3f4f6;color:#374151}
.pos-4{background:#fce7f3;color:#9d174d}

.narrative-card{background:var(--white);border-radius:var(--r);padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
.narrative-card h3{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:14px}
.narrative-card p{font-size:15px;line-height:1.8;color:var(--text);margin-bottom:12px}
.narrative-card p:last-child{margin-bottom:0}

.sd-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px}
.sd-box{background:var(--white);border-radius:var(--r);padding:18px;box-shadow:var(--shadow)}
.sd-box h4{font-size:13px;font-weight:700;margin-bottom:10px}
.sd-box.str h4{color:#166534}
.sd-box.drn h4{color:#be123c}
.sd-item{font-size:14px;padding:5px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px}
.sd-item:last-child{border-bottom:none;padding-bottom:0}

.model-card{background:var(--white);border-radius:var(--r);padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
.model-card h3{font-size:15px;font-weight:700;color:var(--primary);margin-bottom:14px}
.model-row{display:flex;gap:10px;margin-bottom:10px;align-items:flex-start}
.model-row:last-child{margin-bottom:0}
.model-fit{font-size:12px;font-weight:700;padding:3px 10px;border-radius:99px;flex-shrink:0;margin-top:2px}
.fit-high{background:#dcfce7;color:#166534}
.fit-mid{background:var(--al);color:#92400e}
.model-name{font-size:15px;font-weight:700}
.model-why{font-size:13px;color:var(--muted)}

.bridge{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #86efac;border-radius:var(--r);padding:22px;margin-bottom:18px;text-align:center}
.bridge h3{font-size:20px;font-weight:800;color:var(--primary);margin-bottom:8px}
.bridge p{font-size:15px;color:var(--muted);margin-bottom:18px}
.btn-p2{display:inline-block;padding:15px 36px;background:var(--primary);color:white;border:none;border-radius:var(--r);font-size:16px;font-weight:700;cursor:pointer;text-decoration:none}
.btn-p2:hover{background:var(--pm)}

.share-row{display:flex;gap:10px;margin-bottom:18px}
.btn-share{flex:1;padding:12px;border:2px solid var(--primary);border-radius:12px;font-size:14px;font-weight:600;color:var(--primary);background:transparent;cursor:pointer}
.btn-retake{padding:12px 20px;border:2px solid var(--border);border-radius:12px;font-size:14px;color:var(--muted);background:transparent;cursor:pointer}

.sci-footer{background:var(--white);border-radius:var(--r);padding:18px;font-size:12px;color:var(--muted);line-height:1.8}
.sci-footer strong{color:var(--primary)}

@media(max-width:480px){
  .likert{gap:5px}.lk-btn{padding:10px 2px}.sd-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="hdr">
  <a href="/" class="logo">huongdi<em>.sol.vn</em></a>
  <div class="prog-wrap">
    <div class="prog-lbl" id="progLbl">Câu 0 / 20</div>
    <div class="prog-bar"><div class="prog-fill" id="progFill" style="width:0%"></div></div>
  </div>
</div>

<!-- ════ WELCOME ════ -->
<div class="screen active" id="s-welcome">
<div class="welcome">
  <h1>Bạn tạo ra giá trị <em>theo cách nào?</em></h1>
  <p class="sub">20 câu hỏi · 5–7 phút · Không phân loại tính cách — chỉ xếp hạng các năng lực tạo giá trị của bạn.</p>

  <div class="badges">
    <span class="badge">📚 Có cơ sở khoa học</span>
    <span class="badge">⏱ 5–7 phút</span>
    <span class="badge">🔒 Riêng tư</span>
  </div>

  <div class="info-card">
    <h3>Bài trắc nghiệm gồm 4 nhóm câu hỏi:</h3>
    <div class="block-row"><div class="bnum">1</div><div class="txt"><strong>Kết Nối — People</strong><span>Tạo giá trị qua con người, quan hệ, ảnh hưởng</span></div></div>
    <div class="block-row"><div class="bnum">2</div><div class="txt"><strong>Chuyên Môn — Expert</strong><span>Tạo giá trị qua kiến thức, kinh nghiệm, giải quyết vấn đề</span></div></div>
    <div class="block-row"><div class="bnum">3</div><div class="txt"><strong>Xây Dựng — Builder</strong><span>Tạo giá trị qua hệ thống, sản phẩm, tài sản dài hạn</span></div></div>
    <div class="block-row"><div class="bnum">4</div><div class="txt"><strong>Tự Chủ — Independent</strong><span>Nhu cầu tự quyết, tự chịu trách nhiệm, tự quản lý</span></div></div>
  </div>

  <div class="sci-note">📖 Căn cứ khoa học: <strong>Big Five Personality Model</strong> · <strong>Self-Determination Theory</strong> (Deci & Ryan) · <strong>Person-Environment Fit Theory</strong> — được chuyển hóa thành 4 trục phù hợp với bài toán tạo thu nhập và tái khởi nghiệp tuổi trung niên.</div>

  <button class="btn-start" onclick="show('s-block1-intro')">Bắt đầu khám phá →</button>
</div>
</div>

<!-- ════ BLOCK INTROS ════ -->
<div class="screen" id="s-block1-intro">
<div class="block-intro">
  <div class="bi-icon">🤝</div>
  <h2>Nhóm 1: Kết Nối — People</h2>
  <p>Bạn tạo ra giá trị như thế nào khi làm việc với người khác?</p>
  <p class="sci">Căn cứ: Big Five (Extraversion · Agreeableness) · SDT — Relatedness</p>
  <p style="font-size:14px;color:#6b7280;margin-bottom:28px">Đánh giá mức độ <em>giống bạn</em> từ 1 (rất không giống) đến 5 (rất giống). Không có câu trả lời đúng hay sai.</p>
  <button class="btn-go" onclick="showQ(0)">Bắt đầu nhóm 1 →</button>
</div>
</div>

<div class="screen" id="s-block2-intro">
<div class="block-intro">
  <div class="bi-icon">🧠</div>
  <h2>Nhóm 2: Chuyên Môn — Expert</h2>
  <p>Bạn tạo ra giá trị như thế nào qua kiến thức và kinh nghiệm?</p>
  <p class="sci">Căn cứ: Big Five (Openness · Conscientiousness) · Human Capital Theory</p>
  <p style="font-size:14px;color:#6b7280;margin-bottom:28px">Tiếp tục đánh giá từ 1 đến 5. Nhớ rằng không có trục nào "tốt hơn" trục nào — mỗi người có DNA riêng.</p>
  <button class="btn-go" onclick="showQ(4)">Tiếp tục →</button>
</div>
</div>

<div class="screen" id="s-block3-intro">
<div class="block-intro">
  <div class="bi-icon">🏗️</div>
  <h2>Nhóm 3: Xây Dựng — Builder</h2>
  <p>Bạn tạo ra giá trị như thế nào qua việc xây dựng và tổ chức?</p>
  <p class="sci">Căn cứ: Big Five (Conscientiousness) · Effectuation Theory (Sarasvathy)</p>
  <p style="font-size:14px;color:#6b7280;margin-bottom:28px">Gần xong rồi — còn 8 câu nữa sau nhóm này.</p>
  <button class="btn-go" onclick="showQ(8)">Tiếp tục →</button>
</div>
</div>

<div class="screen" id="s-block4-intro">
<div class="block-intro">
  <div class="bi-icon">🦅</div>
  <h2>Nhóm 4: Tự Chủ — Independent</h2>
  <p>Bạn làm việc hiệu quả nhất trong điều kiện như thế nào?</p>
  <p class="sci">Căn cứ: Career Anchors (Schein, 1990) · SDT — Autonomy (Deci & Ryan)</p>
  <p style="font-size:14px;color:#6b7280;margin-bottom:28px">4 câu cuối trong nhóm đánh giá chính. Sau đó là 4 câu hỗ trợ ngắn.</p>
  <button class="btn-go" onclick="showQ(12)">Câu cuối →</button>
</div>
</div>

<div class="screen" id="s-supp-intro">
<div class="block-intro">
  <div class="bi-icon">💡</div>
  <h2>4 Câu Hỗ Trợ</h2>
  <p>Không tính điểm — giúp hệ thống hiểu bạn sâu hơn để tạo kết quả chính xác hơn.</p>
  <p class="sci">Dùng để tinh chỉnh diễn giải DNA và gợi ý mô hình thu nhập phù hợp</p>
  <p style="font-size:14px;color:#6b7280;margin-bottom:28px">Chọn câu đúng nhất — không cần suy nghĩ quá lâu.</p>
  <button class="btn-go" onclick="showQ(16)">Tiếp tục →</button>
</div>
</div>

<!-- ════ QUESTION ════ -->
<div class="screen" id="s-q">
<div class="q-wrap">
  <div class="q-dim-tag"><span class="dot"></span><span id="qDimTag">People</span></div>
  <div class="q-card">
    <div class="q-num" id="qNum">Câu 1 / 20</div>
    <div class="q-stmt" id="qStmt"></div>
    <div class="q-hint" id="qHint"></div>
  </div>
  <div id="qBody"></div>
  <div class="q-nav">
    <button class="btn-back" id="btnBack" onclick="goBack()" style="display:none">← Quay lại</button>
    <button class="btn-next" id="btnNext" onclick="goNext()" disabled>Tiếp →</button>
  </div>
</div>
</div>

<!-- BLOCK SUMMARY SCREENS -->
<div class="screen" id="s-sum1">
<div class="blk-sum">
  <div class="icon">🤝</div>
  <h2>Hoàn thành Nhóm 1: Kết Nối</h2>
  <div class="insight-box" id="sum1box"></div>
  <button class="btn-go" onclick="show('s-block2-intro')">Tiếp tục →</button>
</div>
</div>
<div class="screen" id="s-sum2">
<div class="blk-sum">
  <div class="icon">🧠</div>
  <h2>Hoàn thành Nhóm 2: Chuyên Môn</h2>
  <div class="insight-box" id="sum2box"></div>
  <button class="btn-go" onclick="show('s-block3-intro')">Tiếp tục →</button>
</div>
</div>
<div class="screen" id="s-sum3">
<div class="blk-sum">
  <div class="icon">🏗️</div>
  <h2>Hoàn thành Nhóm 3: Xây Dựng</h2>
  <div class="insight-box" id="sum3box"></div>
  <button class="btn-go" onclick="show('s-block4-intro')">Tiếp tục →</button>
</div>
</div>

<!-- ════ RESULTS ════ -->
<div class="screen" id="s-results">
<div class="results">
  <div class="res-h1">DNA Hướng Đi của bạn</div>
  <div class="res-sub" id="resSub"></div>

  <!-- DNA Card -->
  <div class="dna-card">
    <div class="role">ĐỊNH DANH NĂNG LỰC</div>
    <h2 id="dnaTitle">—</h2>
    <div class="dna-row" id="dnaRow"></div>
    <div id="confBadge"></div>
  </div>

  <!-- Scores -->
  <div class="score-card">
    <h3>📊 Điểm 4 trục (0–100)</h3>
    <div id="scoreRows"></div>
  </div>

  <!-- Narrative -->
  <div class="narrative-card">
    <h3>🪞 Đây là bạn</h3>
    <div id="narrativeText"></div>
  </div>

  <!-- Strengths & Drains -->
  <div class="sd-grid">
