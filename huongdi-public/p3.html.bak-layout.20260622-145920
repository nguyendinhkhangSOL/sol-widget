function getP2(){try{const d=JSON.parse(localStorage.getItem('p2_result')||'null');if(!d||!d.scores)return null;const sc=d.scores;return{capital:sc.capScore||0,time:sc.timeScore||0,technology:sc.techScore||0,network:sc.netScore||0,risk:sc.riskScore||0,energy:sc.energyScore||0,experience:sc.expScore||0,incomeGoal:(d.S&&d.S.incIdeal)?d.S.incIdeal:10};}catch(e){return null;}}
function pMatch(norm,dp){const dims=['people','expert','builder','independent'];const tot=dims.reduce((s,d)=>s+dp[d],0)||1;let ws=0;dims.forEach(d=>{const u=norm[d]||0,req=dp[d];ws+=(u>=req?100:Math.max(0,100-(req-u)*1.3))*(req/tot);});return Math.min(100,Math.round(ws));}
function rMatch(p2,dr){const map=[['capital','capital'],['time','time'],['technology','technology'],['network','network'],['risk','risk'],['energy','energy']];let tot=0,ex=0;map.forEach(([pk,dk])=>{const u=p2[pk]||0,req=dr[pk]||0;if(!req){tot+=100;return;}const s=u>=req?100:Math.max(0,(u/req)*100);tot+=s;if(u/req<0.45&&req>=40)ex+=12;});const eb=((p2.experience-50)/50)*0.7*18;return Math.max(0,Math.min(100,Math.round(tot/map.length+eb-ex)));}
function gMatch(goal,dir){const g=goal||10,mn=dir.income.min,mx=dir.income.max;if(g>=mn&&g<=mx)return 95;if(g<mn)return 82;if(g<=mx*1.5)return 62;return 38;}
function scClass(s){return s>=90?'sc-gold':s>=80?'sc-green':s>=70?'sc-blue':s>=60?'sc-amber':'sc-gray';}
function riskLbl(r){return r<=20?'🟢 Rủi ro thấp':r<=50?'🟡 Rủi ro TB':'🔴 Rủi ro cao';}
function riskCls(r){return r<=20?'cb-risk-lo':r<=50?'cb-risk-md':'cb-risk-hi';}
const DIM={people:'Kết Nối',expert:'Chuyên Môn',builder:'Xây Dựng',independent:'Tự Chủ'};
const CAT_URL={chuyenmon:'/p3-chuyenmon.html',daotao:'/p3-daotao.html',noidungso:'/p3-noidungso.html',kinhdoanh:'/p3-kinhdoanh.html',daily:'/p3-daily.html',dichvu:'/p3-dichvu.html',dauthu:'/p3-dauthu.html'};
let ALL=[],curCat='all',curSort='score',showN=6;

function scr(id){document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));document.getElementById(id).classList.add('on');}
function renderProfile(p1,p2){
  const rank=p1.meta.ranking||Object.keys(p1.raw).sort((a,b)=>p1.raw[b]-p1.raw[a]);
  document.getElementById('dnaBars').innerHTML=rank.map(d=>`<div class="dna-row"><span class="dna-name">${DIM[d]||d}</span><div class="dna-track"><div class="dna-fill" style="width:${p1.norm[d]||0}%"></div></div><span class="dna-val">${p1.norm[d]||0}</span></div>`).join('');
  const res=[['Kinh nghiệm',p2.experience],['Vốn',p2.capital],['Mạng lưới',p2.network],['Thời gian',p2.time]];
  document.getElementById('resChips').innerHTML=res.map(([l,v])=>`<span class="res-chip">${l}: ${v}</span>`).join('');
  const dna=p1.meta.dna||{};
  document.getElementById('pcTitle').textContent=`🎯 ${p1.meta.title||'Kết quả hướng đi'}`;
  document.getElementById('pcSub').textContent=`DNA chính: ${DIM[dna.primary]||''} · ${DIM[dna.secondary]||''}`;
}
function buildCard(r,rank){
  const {dir,score,pm,rm,gm}=r;
  const rl=rank===0?'rb1':rank===1?'rb2':rank===2?'rb3':'';
  const rlbl=rank===0?'🥇 Phù hợp nhất':rank===1?'🥈 Rất phù hợp':rank===2?'🥉 Phù hợp cao':'';
  const rm_html=dir.roadmap.map((w,i)=>`<div class="rm-step"><div class="rm-dot">${i+1}</div><div class="rm-text"><strong>${w.w} — ${w.t}</strong>${w.d}</div></div>`).join('');
  const reasons_html=(dir.reasons||[]).map(s=>`<div class="ri"><span class="ic">✅</span><span>${s}</span></div>`).join('');
  return `<div class="card-hd" onclick="toggleCard(this)">
    <div class="card-emoji">${dir.emoji}</div>
    <div class="card-meta">
      ${rlbl?`<span class="rank-badge ${rl}">${rlbl}</span>`:''}
      <div class="card-title">${dir.title}${dir.isNew?' <span class="cbadge cb-new">MỚI</span>':''}</div>
      <div class="card-badges"><span class="cbadge cb-${dir.cat}">${dir.catLbl}</span><span class="cbadge cb-income">💰 ${dir.income.min}–${dir.income.max}tr</span><span class="cbadge cb-time">⏱ ${dir.timeline}</span><span class="cbadge ${riskCls(dir.r.risk)}">${riskLbl(dir.r.risk)}</span></div>
      <div class="card-desc">${dir.desc}</div>
    </div>
    <div class="sc ${scClass(score)}"><div class="sc-num">${score}</div><div class="sc-pct">%</div></div>
  </div>
  <div class="card-bd" id="bd-${dir.id}">
    <div class="match-bars">
      <div class="mb-row"><span class="mb-lbl">🧬 Tính cách</span><div class="mb-track"><div class="mb-fill mf-p" data-w="${pm}" style="width:0"></div></div><span class="mb-val">${pm}%</span></div>
      <div class="mb-row"><span class="mb-lbl">⚙️ Nguồn lực</span><div class="mb-track"><div class="mb-fill mf-r" data-w="${rm}" style="width:0"></div></div><span class="mb-val">${rm}%</span></div>
      <div class="mb-row"><span class="mb-lbl">💰 Thu nhập</span><div class="mb-track"><div class="mb-fill mf-g" data-w="${gm}" style="width:0"></div></div><span class="mb-val">${gm}%</span></div>
    </div>
    <div class="rg">${reasons_html}</div>
    <button class="rm-toggle" onclick="toggleRm(this,'rm-${dir.id}')">📅 Roadmap 30 ngày <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button>
    <div class="rm-body" id="rm-${dir.id}">${rm_html}</div>
    <div class="card-actions">
      <a class="btn-cat" href="${CAT_URL[dir.cat]||'#'}">Xem thêm nhóm ${dir.catLbl} →</a>
      <button class="btn-save" id="sv-${dir.id}" onclick="saveDir(event,'${dir.id}')">💾 Lưu</button>
    </div>
  </div>`;
}
function renderCards(list,from,to){
  const wrap=document.getElementById('cards');
  if(from===0)wrap.innerHTML='';
  list.slice(from,to).forEach((r,i)=>{
    const el=document.createElement('div');
    el.className='card'+(from+i<3?' top3':'');
    el.innerHTML=buildCard(r,from+i);
    wrap.appendChild(el);
    setTimeout(()=>el.querySelectorAll('.mb-fill[data-w]').forEach(b=>b.style.width=b.dataset.w+'%'),200+(from+i)*60);
  });
  document.getElementById('showMoreWrap').style.display=to<list.length?'block':'none';
}
function getFiltered(){
  let list=[...ALL];
  if(curCat!=='all')list=list.filter(r=>r.dir.cat===curCat);
  if(curSort==='income')list.sort((a,b)=>b.dir.income.max-a.dir.income.max);
  else if(curSort==='risk')list.sort((a,b)=>a.dir.r.risk-b.dir.r.risk);
  else if(curSort==='speed')list.sort((a,b)=>b.dir.b.income_speed-a.dir.b.income_speed);
  else list.sort((a,b)=>b.score-a.score);
  return list;
}
function filterCat(btn,cat){document.querySelectorAll('.cat-tab').forEach(b=>b.classList.remove('on'));btn.classList.add('on');curCat=cat;showN=6;renderCards(getFiltered(),0,showN);}
function setSort(btn,sort){document.querySelectorAll('.sort-btn').forEach(b=>b.classList.remove('on'));btn.classList.add('on');curSort=sort;showN=6;renderCards(getFiltered(),0,showN);}
function showAll(){const list=getFiltered();renderCards(list,0,list.length);}
function toggleCard(hd){const bd=hd.nextElementSibling;const open=bd.classList.toggle('on');if(open)setTimeout(()=>bd.querySelectorAll('.mb-fill[data-w]').forEach(b=>{b.style.width='0';setTimeout(()=>b.style.width=b.dataset.w+'%',30);}),10);}
function toggleRm(btn,id){document.getElementById(id).classList.toggle('on');btn.classList.toggle('on');}
function saveDir(e,id){e.stopPropagation();const saved=JSON.parse(localStorage.getItem('p3_saved')||'[]');if(!saved.includes(id)){saved.push(id);localStorage.setItem('p3_saved',JSON.stringify(saved));}const btn=document.getElementById('sv-'+id);btn.textContent='✅ Đã lưu';btn.classList.add('saved');}

window.addEventListener('DOMContentLoaded',()=>{
  const p1=getP1(),p2=getP2();
  if(!p1||!p2){
    const steps=document.getElementById('nd-steps');
    const st=[{done:!!p1,lbl:'P1 — Khám phá bản thân',sub:'20 câu hỏi về cách bạn tạo giá trị',href:'/p1.html'},{done:!!p2,lbl:'P2 — Khai báo nguồn lực',sub:'Vốn, thời gian, kinh nghiệm, mạng lưới',href:'/p2.html'}];
    steps.innerHTML=st.map(s=>`<div class="nd-step${s.done?' done':''}"><span class="nd-step-ico">${s.done?'✅':'⭕'}</span><div class="nd-step-info"><strong>${s.lbl}</strong><span>${s.sub}</span></div><span class="nd-badge ${s.done?'ndb-done':'ndb-todo'}">${s.done?'Hoàn thành':'Chưa làm'}</span></div>`).join('');
    const cta=document.getElementById('nd-cta');
    if(p1&&!p2){cta.href='/p2.html';cta.textContent='Tiếp tục P2: Khai báo nguồn lực →';}
    scr('s-nodata');return;
  }
  scr('s-loading');
  setTimeout(()=>{
    renderProfile(p1,p2);
    ALL=DB.map(dir=>{
      const pm=pMatch(p1.norm,dir.p);
      const rm=rMatch(p2,dir.r);
      const gm=gMatch(p2.incomeGoal,dir);
      const score=Math.round(pm*0.50+rm*0.35+gm*0.15);
      return{dir,score,pm,rm,gm};
    }).sort((a,b)=>b.score-a.score);
    const top=ALL[0];
    document.getElementById('resSubtitle').textContent=`Tìm thấy ${ALL.length} hướng đi. Phù hợp nhất: "${top.dir.title}" với ${top.score}%.`;
    const saved=JSON.parse(localStorage.getItem('p3_saved')||'[]');
    renderCards(getFiltered(),0,showN);
    setTimeout(()=>saved.forEach(id=>{const btn=document.getElementById('sv-'+id);if(btn){btn.textContent='✅ Đã lưu';btn.classList.add('saved');}}),300);
    scr('s-results');
  },900);
});
</script>
<script src="/sol-flow.js"></script>
</body>
</html>
