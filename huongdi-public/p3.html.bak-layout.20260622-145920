<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kết Quả Hướng Đi — Huongdi.sol.vn</title>
<style>
:root{
  --g:#1a6b4a;--gm:#2e8b63;--gl:#e8f5ee;--gd:#134e3a;
  --a:#f59e0b;--al:#fef3c7;
  --tx:#1a202c;--mu:#6b7280;--bd:#e5e7eb;--bg:#f9fafb;--wh:#fff;
  --sh:0 2px 12px rgba(0,0,0,.08);--r:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--tx);font-size:15px;line-height:1.6}
a{text-decoration:none}

/* HEADER */
.hdr{background:var(--wh);border-bottom:1px solid var(--bd);padding:11px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200}
.logo{font-weight:800;font-size:15px;color:var(--g)}
.logo em{color:var(--a);font-style:normal}
.hdr-r{display:flex;gap:8px}
.btn-sm{font-size:12px;color:var(--mu);background:transparent;border:1px solid var(--bd);padding:5px 12px;border-radius:99px;cursor:pointer;white-space:nowrap}
.btn-sm:hover{border-color:var(--g);color:var(--g)}

/* SCREENS */
.scr{display:none}.scr.on{display:block}

/* NO-DATA */
.nodata{max-width:480px;margin:60px auto;padding:24px;text-align:center}
.nodata .ico{font-size:52px;margin-bottom:14px}
.nodata h2{font-size:22px;font-weight:800;color:var(--g);margin-bottom:8px}
.nodata p{color:var(--mu);margin-bottom:22px}
.nd-steps{display:flex;flex-direction:column;gap:10px;margin-bottom:24px;text-align:left}
.nd-step{background:var(--wh);border-radius:12px;padding:14px 16px;display:flex;align-items:center;gap:12px;border:2px solid var(--bd)}
.nd-step.done{border-color:#86efac;background:#f0fdf4}
.nd-step-ico{font-size:20px}
.nd-step-info strong{display:block;font-size:14px;font-weight:700}
.nd-step-info span{font-size:13px;color:var(--mu)}
.nd-badge{margin-left:auto;font-size:11px;font-weight:700;padding:3px 10px;border-radius:99px}
.ndb-done{background:#d1fae5;color:#059669}
.ndb-todo{background:var(--bd);color:var(--mu)}
.btn-go{display:block;padding:15px;background:var(--g);color:white;border:none;border-radius:var(--r);font-size:16px;font-weight:700;cursor:pointer;text-align:center}
.btn-go:hover{background:var(--gm)}

/* LOADING */
.loading{max-width:420px;margin:80px auto;text-align:center;padding:20px}
.spin{width:48px;height:48px;border:4px solid var(--bd);border-top-color:var(--g);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 18px}
@keyframes spin{to{transform:rotate(360deg)}}
.loading h2{font-size:18px;font-weight:700;color:var(--g);margin-bottom:6px}
.loading p{color:var(--mu);font-size:14px}

/* RESULTS LAYOUT */
.res{max-width:780px;margin:0 auto;padding:18px 14px 60px}

/* PROFILE CARD */
.profile-card{background:linear-gradient(135deg,var(--gd) 0%,#1a6b4a 100%);border-radius:var(--r);padding:20px 22px;margin-bottom:16px;color:white}
.pc-top{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:14px}
.pc-block{flex:1;min-width:160px}
.pc-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;opacity:.7;margin-bottom:8px}
.dna-bars{display:flex;flex-direction:column;gap:5px}
.dna-row{display:flex;align-items:center;gap:8px}
.dna-name{font-size:12px;font-weight:600;width:80px;opacity:.9}
.dna-track{flex:1;height:5px;background:rgba(255,255,255,.2);border-radius:99px;overflow:hidden}
.dna-fill{height:100%;border-radius:99px;background:rgba(255,255,255,.8)}
.dna-val{font-size:11px;font-weight:700;width:28px;text-align:right;opacity:.85}
.res-chips{display:flex;flex-wrap:wrap;gap:6px}
.res-chip{font-size:12px;font-weight:600;padding:4px 10px;border-radius:99px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);color:white}
.pc-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.pc-title{font-size:15px;font-weight:700}
.pc-sub{font-size:13px;opacity:.75;margin-top:2px}
.pc-edit{font-size:12px;padding:5px 14px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:99px;color:white;cursor:pointer}
.pc-edit:hover{background:rgba(255,255,255,.25)}

/* FILTER ROW */
.filter-section{background:var(--wh);border-radius:var(--r);padding:12px 16px;margin-bottom:14px;box-shadow:var(--sh)}
.cat-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.cat-tab{font-size:12px;font-weight:600;padding:5px 12px;border-radius:99px;border:1.5px solid var(--bd);background:transparent;cursor:pointer;color:var(--tx);white-space:nowrap}
.cat-tab.on{border-color:var(--g);background:var(--g);color:white}
.cat-tab:hover:not(.on){border-color:var(--g);color:var(--g)}
.sort-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.sort-label{font-size:11px;color:var(--mu);font-weight:600}
.sort-btn{font-size:12px;font-weight:500;padding:4px 10px;border-radius:99px;border:1px solid var(--bd);background:transparent;cursor:pointer;color:var(--mu)}
.sort-btn.on{background:var(--al);border-color:var(--a);color:#92400e;font-weight:700}

/* RESULTS HEADER */
.res-hdr{margin-bottom:14px}
.res-hdr h1{font-size:20px;font-weight:800;color:var(--g);margin-bottom:3px}
.res-hdr p{color:var(--mu);font-size:13px}

/* CARDS */
.cards{display:flex;flex-direction:column;gap:10px}
.card{background:var(--wh);border-radius:var(--r);box-shadow:var(--sh);border:2px solid transparent;transition:border-color .18s;overflow:hidden}
.card.top3{border-color:#86efac}
.card:hover{border-color:var(--gm)}
.card-hd{padding:16px 18px;cursor:pointer;display:flex;align-items:flex-start;gap:12px}
.card-emoji{font-size:24px;width:40px;height:40px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.card-meta{flex:1;min-width:0}
.rank-badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;margin-bottom:4px}
.rb1{background:#fef08a;color:#713f12}
.rb2{background:#dbeafe;color:#1e3a8a}
.rb3{background:#f3f4f6;color:#374151}
.card-title{font-size:15px;font-weight:800;margin-bottom:5px;line-height:1.3}
.card-badges{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:5px}
.cbadge{font-size:11px;font-weight:600;padding:2px 8px;border-radius:99px}
.cb-chuyenmon{background:#dbeafe;color:#1e40af}
.cb-daotao{background:#ede9fe;color:#5b21b6}
.cb-noidungso{background:#fce7f3;color:#9d174d}
.cb-kinhdoanh{background:#ffedd5;color:#c2410c}
.cb-daily{background:#ccfbf1;color:#0f766e}
.cb-dichvu{background:#d1fae5;color:#065f46}
.cb-dauthu{background:#fef9c3;color:#713f12}
.cb-income{background:#f0fdf4;color:#15803d;border:1px solid #86efac}
.cb-time{background:var(--bg);color:var(--mu);border:1px solid var(--bd)}
.cb-risk-lo{background:#f0fdf4;color:#15803d}
.cb-risk-md{background:var(--al);color:#92400e}
.cb-risk-hi{background:#fee2e2;color:#dc2626}
.cb-new{background:#fed7aa;color:#c2410c}
.card-desc{font-size:13px;color:var(--mu);line-height:1.5}
.sc{flex-shrink:0;width:58px;height:58px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;border:3px solid}
.sc-gold{background:#fef9c3;border-color:#fbbf24;color:#713f12}
.sc-green{background:#dcfce7;border-color:#4ade80;color:#15803d}
.sc-blue{background:#dbeafe;border-color:#60a5fa;color:#1d4ed8}
.sc-amber{background:var(--al);border-color:var(--a);color:#92400e}
.sc-gray{background:#f3f4f6;border-color:#d1d5db;color:#6b7280}
.sc-num{font-size:17px;line-height:1}
.sc-pct{font-size:10px;line-height:1}
.card-bd{display:none;border-top:1px solid var(--bd);padding:16px 18px}
.card-bd.on{display:block}
.match-bars{margin-bottom:14px}
.mb-row{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.mb-lbl{width:100px;font-size:12px;color:var(--mu);flex-shrink:0}
.mb-track{flex:1;height:5px;background:var(--bg);border-radius:99px;overflow:hidden}
.mb-fill{height:100%;border-radius:99px;transition:width .8s ease-out}
.mf-p{background:var(--g)}
.mf-r{background:#3b82f6}
.mf-g{background:var(--a)}
.mb-val{font-size:11px;font-weight:700;width:28px;text-align:right}
.rg{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:14px}
.ri{font-size:12px;display:flex;gap:5px;align-items:flex-start;line-height:1.4}
.ri .ic{flex-shrink:0;margin-top:1px}
.rm-toggle{display:flex;align-items:center;gap:6px;padding:9px 13px;background:var(--gl);border-radius:10px;cursor:pointer;border:none;width:100%;text-align:left;font-size:13px;font-weight:600;color:var(--g);margin-bottom:8px}
.rm-toggle svg{margin-left:auto;transition:transform .25s}
.rm-toggle.on svg{transform:rotate(180deg)}
.rm-body{display:none;padding:12px;background:var(--bg);border-radius:10px;margin-bottom:10px}
.rm-body.on{display:block}
.rm-step{display:flex;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--bd)}
.rm-step:last-child{margin-bottom:0;padding-bottom:0;border:none}
.rm-dot{width:24px;height:24px;border-radius:50%;background:var(--g);color:white;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.rm-text{font-size:12px;line-height:1.5}
.rm-text strong{display:block;font-weight:700;margin-bottom:2px}
.card-actions{display:flex;gap:8px;margin-top:10px}
.btn-cat{flex:1;padding:10px;background:var(--g);color:white;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;text-align:center}
.btn-cat:hover{background:var(--gm)}
.btn-save{padding:10px 14px;background:transparent;border:2px solid var(--bd);border-radius:10px;font-size:13px;color:var(--mu);cursor:pointer}
.btn-save:hover{border-color:var(--g);color:var(--g)}
.btn-save.saved{border-color:#86efac;color:#059669}
.show-more{text-align:center;margin-top:14px}
.btn-more{padding:12px 32px;background:var(--wh);border:2px solid var(--bd);border-radius:var(--r);font-size:14px;font-weight:600;color:var(--mu);cursor:pointer}
.btn-more:hover{border-color:var(--g);color:var(--g)}

/* CATEGORY EXPLORE */
.cat-explore{margin-top:24px;background:var(--wh);border-radius:var(--r);padding:20px;box-shadow:var(--sh)}
.cat-explore h3{font-size:16px;font-weight:800;color:var(--g);margin-bottom:4px}
.cat-explore p{font-size:13px;color:var(--mu);margin-bottom:14px}
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:8px}
.cat-card{display:flex;flex-direction:column;align-items:center;padding:14px 10px;background:var(--bg);border-radius:12px;border:2px solid var(--bd);cursor:pointer;transition:all .18s;text-decoration:none}
.cat-card:hover{border-color:var(--g);background:var(--gl)}
.cat-card .icon{font-size:24px;margin-bottom:6px}
.cat-card .name{font-size:12px;font-weight:700;color:var(--tx);text-align:center;margin-bottom:2px}
.cat-card .cnt{font-size:11px;color:var(--mu)}

/* NEXT STEPS */
.next{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #86efac;border-radius:var(--r);padding:20px 22px;margin-top:18px;text-align:center}
.next h3{font-size:17px;font-weight:800;color:var(--g);margin-bottom:6px}
.next p{font-size:13px;color:var(--mu);margin-bottom:14px}
.next-btns{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.btn-sol{padding:11px 22px;background:var(--g);color:white;border:none;border-radius:12px;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none}
.btn-redo{padding:11px 18px;background:transparent;border:2px solid var(--g);border-radius:12px;font-size:13px;font-weight:600;color:var(--g);cursor:pointer}

@media(max-width:560px){
  .rg{grid-template-columns:1fr}
  .pc-top{flex-direction:column;gap:10px}
  .cat-grid{grid-template-columns:repeat(3,1fr)}
}
</style>
</head>
