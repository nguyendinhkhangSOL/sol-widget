</div>
</div>

<!-- RESULTS -->
<div class="scr" id="s-results">
<div class="res">

  <div class="profile-card">
    <div class="pc-top">
      <div class="pc-block">
        <div class="pc-label">🧬 DNA của bạn</div>
        <div class="dna-bars" id="dnaBars"></div>
