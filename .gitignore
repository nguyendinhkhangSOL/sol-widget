node_modules/
dist/
build/
.env
.env.local
*.log
.DS_Store
coverage/
.vscode/
.idea/
frontend/public/sol-widget.js

# Backup output (chứa secrets, KHÔNG push lên git)
backups/
sol_backup_*.zip
restore_temp/

# DB backup SQL files — chứa data user thật, KHÔNG push
*.sql

# Whitelist toàn bộ SQL trong backend/prisma/ (migrations + manual + fix + seed)
# Lưu ý: do `*.sql` ở trên block hết, phải re-allow folder trước rồi mới list pattern
!backend/prisma/
!backend/prisma/**/*.sql
!backend/prisma/**/migration_lock.toml

# Block lại backup riêng (file lớn, có data user)
backup_pre_*.sql
backups/*.sql

# Env files cho mọi service (tránh leak ZALO_APP_SECRET, JWT_SECRET, SMTP_PASSWORD)
backend/.env
backend/.env.local
backend/.env.*.local
dashboard/.env
admin/.env
frontend/.env

# Cowork mode outputs (local-only)
outputs/
*.tmp

# Editor backup files
*.bak
*~

# Office lock files (khi anh mở Word/Excel)
.~lock.*#
~$*.docx
~$*.xlsx
# Credentials — KHÔNG BAO GIỜ push (bị commit nhầm 23/5/2026 do quên gitignore)
docs/01-CREDENTIALS.md
