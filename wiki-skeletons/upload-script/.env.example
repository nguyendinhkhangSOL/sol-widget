# Copy file này thành .env và điền credentials thật.
# .env KHÔNG được commit vào git (xem .gitignore).

# URL của WordPress site, không có / cuối
WP_URL=https://sol.vn

# Username admin của bạn
WP_USER=khang

# Application Password — tạo ở Users → Profile → Application Passwords
# Có khoảng trắng giữa các nhóm 4 ký tự — copy nguyên xi
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Slug của category đích (đã tạo trên WordPress)
# URL: https://sol.vn/category/wiki-bo-thuoc-la/trieu-chung-khi-cai-thuoc/
WP_CATEGORY_SLUG=trieu-chung-khi-cai-thuoc

# Status mặc định khi tạo post: draft (review trước) hoặc publish (live ngay)
WP_DEFAULT_STATUS=draft

# (Tuỳ chọn) Author ID — bỏ trống dùng user đăng nhập
# WP_AUTHOR_ID=1
