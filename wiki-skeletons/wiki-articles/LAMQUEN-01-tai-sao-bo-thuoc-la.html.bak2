  "mainEntity": [
    {
      "@type": "Question",
      "name": "Tại sao nên bỏ thuốc lá?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "5 lý do khoa học: sống thêm trung bình 10 năm (Doll 2004 BMJ), tiết kiệm 100-300 triệu/đời, phổi hồi phục 30% trong 9 tháng, tim giảm 50% nguy cơ nhồi máu sau 1 năm, con bớt 50% nguy cơ bệnh hô hấp."
      }
    },
    {
      "@type": "Question",
      "name": "Bỏ thuốc có quá muộn nếu đã hút 30 năm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Không. Doll 2004 (50-Year British Doctors Study): bỏ trước 40 lấy lại gần hết 10 năm sống, bỏ trước 50 lấy lại 6 năm, bỏ trước 60 vẫn còn 3 năm. Bỏ ở bất kỳ tuổi nào cũng tốt hơn không bỏ."
      }
    },
    {
      "@type": "Question",
      "name": "Phổi hồi phục bao lâu sau khi bỏ thuốc?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Theo US Surgeon General 2014: 20 phút huyết áp về bình thường, 12 giờ CO máu giảm, 2-3 tuần FEV1 tăng, 1-9 tháng cilia phổi hồi 50-70% (ho giảm, đờm giảm rõ), 1 năm tim giảm 50% nguy cơ. Phổi không trở về 100% nhưng cải thiện đáng kể."
      }
    },
    {
      "@type": "Question",
      "name": "Bỏ thuốc tiết kiệm bao nhiêu tiền?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "1 bao Vinataba 30k/ngày × 365 = 11 triệu/năm tiền thuốc thuần. Cộng chi phí ẩn (răng, bảo hiểm, khám hô hấp): ~4tr/năm. Cộng chi phí bệnh tật expected: ~80tr. 30 năm hút = 500-700 triệu (WHO ước tính)."
      }
    },
    {
      "@type": "Question",
      "name": "Sol có giúp con tôi không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Có. Khói thuốc thụ động tăng nguy cơ viêm phế quản 1.5-2x, hen suyễn 1.3-1.8x, SIDS 2x ở trẻ sơ sinh (Öberg 2011 Lancet). Khi anh bỏ thuốc, môi trường nhà sạch khói → con bớt 50% nguy cơ bệnh hô hấp."
      }
    }
  ]
}
